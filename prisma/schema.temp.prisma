generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AssignedRecruiters {
  A String
  B String

  @@unique([A, B], map: "_AssignedRecruiters_AB_unique")
  @@index([B], map: "_AssignedRecruiters_B_index")
  @@map("_AssignedRecruiters")
}

model RequisitionRecruiters {
  A String
  B String

  @@unique([A, B], map: "_RequisitionRecruiters_AB_unique")
  @@index([B], map: "_RequisitionRecruiters_B_index")
  @@map("_RequisitionRecruiters")
}

model attachments {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reimbursement_item_id String   @db.Uuid
  file_name             String   @db.VarChar(255)
  file_url              String
  file_size             Int
  file_type             String   @db.VarChar(100)
  uploaded_by           String   @db.Uuid
  uploaded_at           DateTime @default(now()) @db.Timestamp(6)
}

model attendance {
  id                                    String              @id
  tenant_id                             String
  user_id                               String
  date                                  DateTime
  clock_in                              DateTime?
  clock_out                             DateTime?
  status                                String              @default("present")
  shift_id                              String?
  total_work_minutes                    Int                 @default(0)
  total_break_minutes                   Int                 @default(0)
  effective_work_minutes                Int                 @default(0)
  overtime_minutes                      Int                 @default(0)
  late_minutes                          Int                 @default(0)
  is_manual_entry                       Boolean             @default(false)
  entered_by_id                         String?
  notes                                 String?
  created_at                            DateTime            @default(now())
  updated_at                            DateTime
  users_attendance_entered_by_idTousers users?              @relation("attendance_entered_by_idTousers", fields: [entered_by_id], references: [id])
  shifts                                shifts?             @relation(fields: [shift_id], references: [id])
  tenants                               tenants             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users_attendance_user_idTousers       users               @relation("attendance_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)
  attendance_breaks                     attendance_breaks[]

  @@unique([tenant_id, user_id, date], map: "attendance_unique_user_date")
}

model attendance_breaks {
  id               String     @id
  tenant_id        String
  attendance_id    String
  break_type       String
  start_time       DateTime
  end_time         DateTime?
  duration_minutes Int        @default(0)
  created_at       DateTime   @default(now())
  updated_at       DateTime
  attendance       attendance @relation(fields: [attendance_id], references: [id], onDelete: Cascade)
  tenants          tenants    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model attendance_sessions {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  attendance_id String
  clock_in      DateTime  @db.Timestamp(6)
  clock_out     DateTime? @db.Timestamp(6)
  work_minutes  Int       @default(0)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)

  @@index([attendance_id], map: "idx_attendance_sessions_attendance_id")
}

model authorization_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String
  user_id     String?
  permission  String
  resource    String
  resource_id String?
  result      String
  reason      String?
  ip_address  String?
  user_agent  String?
  endpoint    String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "auth_logs_created_at_idx")
  @@index([tenant_id, user_id], map: "auth_logs_tenant_user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bucket_members {
  id        String   @id
  bucket_id String
  user_id   String
  role      String   @default("member")
  added_at  DateTime @default(now())

  @@unique([bucket_id, user_id], map: "unique_bucket_member")
  @@index([bucket_id], map: "idx_bucket_members_bucket_id")
  @@index([user_id], map: "idx_bucket_members_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model buckets {
  id            String   @id
  tenant_id     String
  project_id    String?
  name          String
  description   String?
  color         String?  @default("#6366f1")
  is_shared     Boolean  @default(false)
  created_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime

  @@unique([tenant_id, project_id, name], map: "unique_bucket_per_project")
  @@index([created_by_id], map: "idx_buckets_created_by_id")
  @@index([project_id], map: "idx_buckets_project_id")
  @@index([tenant_id], map: "idx_buckets_tenant_id")
}

model calendar_event_exceptions {
  id                    String    @id
  event_id              String
  tenant_id             String
  user_id               String
  created_by            String
  updated_by            String?
  original_date         DateTime  @db.Timestamptz(6)
  new_start_time        DateTime? @db.Timestamptz(6)
  new_end_time          DateTime? @db.Timestamptz(6)
  is_cancelled          Boolean   @default(false)
  external_instance_id  String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)
  override_title        String?
  override_description  String?
  override_location     String?
  override_meeting_link String?
  override_attendees    Json?

  @@unique([event_id, original_date], map: "unique_event_occurrence")
  @@index([event_id], map: "idx_exception_event_id")
  @@index([tenant_id], map: "idx_exception_tenant_id")
  @@index([user_id], map: "idx_exception_user_id")
}

model calendar_events {
  id              String    @id
  provider        String
  external_id     String
  tenant_id       String
  user_id         String
  calendar_id     String?
  title           String
  description     String?
  location        String?
  start_time      DateTime  @db.Timestamptz(6)
  end_time        DateTime  @db.Timestamptz(6)
  is_all_day      Boolean?  @default(false)
  is_recurring    Boolean?  @default(false)
  rrule           String?
  exdate          Json?
  calendar_name   String?   @db.VarChar(255)
  source_type     String?   @db.VarChar(100)
  attendees       Json?
  meeting_link    String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  created_by_id   String?
  updated_by_id   String?
  organizer_email String?
  is_deleted      Boolean   @default(false)

  @@unique([provider, external_id, tenant_id], map: "calendar_events_unique_provider_external_tenant")
  @@index([start_time], map: "idx_calendar_events_start_time")
  @@index([tenant_id], map: "idx_calendar_events_tenant")
  @@index([user_id], map: "idx_calendar_events_user")
}

model calendar_integrations {
  id                            String    @id
  user_id                       String
  tenant_id                     String
  provider                      String
  access_token                  String?
  refresh_token                 String?
  token_expiry                  DateTime? @db.Timestamptz(6)
  calendar_id                   String?
  google_sync_token             String?
  google_channel_id             String?
  google_resource_id            String?
  google_channel_expiry         DateTime? @db.Timestamptz(6)
  microsoft_delta_link          String?
  microsoft_subscription_id     String?
  microsoft_subscription_expiry DateTime? @db.Timestamptz(6)
  microsoft_client_state        String?
  zoho_last_sync                DateTime? @db.Timestamptz(6)
  created_at                    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime? @default(now()) @db.Timestamptz(6)
  created_by                    String?
  updated_by                    String?
  created_by_id                 String?
  updated_by_id                 String?
  is_syncing                    Boolean   @default(false)
  last_sync_status              String?
  last_sync_at                  DateTime? @db.Timestamptz(6)
  next_sync_due_at              DateTime  @default(now()) @db.Timestamptz(6)
  sync_error_count              Int       @default(0)

  @@unique([user_id, provider], map: "calendar_integrations_unique_user_provider")
  @@index([provider], map: "idx_calendar_integrations_provider")
  @@index([tenant_id], map: "idx_calendar_integrations_tenant")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model candidate_availability {
  id                String?   @default(dbgenerated("gen_random_uuid()"))
  candidate_id      String?
  available_to_join Boolean?
  joining_date      DateTime? @db.Timestamp(6)
  notice_period     Int?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)

  @@ignore
}

model candidate_details {
  id                       String               @id @default(dbgenerated("gen_random_uuid()"))
  tenant_id                String
  full_name                String               @db.VarChar(255)
  email                    String               @unique @db.VarChar(255)
  contact_no               String               @db.VarChar(20)
  address_line1            String
  address_line2            String?
  city                     String               @db.VarChar(100)
  state                    String               @db.VarChar(100)
  zip_code                 String               @db.VarChar(20)
  country                  String               @db.VarChar(100)
  linkedin_url             String?
  github_url               String?
  portfolio_url            String?
  created_at               DateTime?            @default(now()) @db.Timestamp(6)
  updated_at               DateTime?            @default(now()) @db.Timestamp(6)
  internal_recruiter_notes String?              @db.VarChar(1000)
  work_authorization       work_authorization[]
}

model candidate_documents {
  id            String    @id
  candidate_id  String
  document_type String
  document_url  String
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model candidate_educations {
  id             String    @id
  candidate_id   String
  degree_name    String
  specialization String?
  university     String
  location       String?
  start_date     DateTime  @db.Date
  end_date       DateTime? @db.Date
  created_by_id  String
  updated_by_id  String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())

  @@index([candidate_id])
}

model candidate_interview_availability {
  id             String    @id
  candidate_id   String
  interview_date DateTime? @db.Timestamp(6)
  start_time     DateTime? @db.Timestamp(6)
  end_time       DateTime? @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
}

model candidate_interview_slots {
  id             String   @id
  candidate_id   String
  interview_date DateTime @db.Date
  start_time     String
  end_time       String
  created_by_id  String
  updated_by_id  String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())
  timezone       String?

  @@index([candidate_id])
}

model candidate_skill_matrices {
  id                  String   @id
  candidate_id        String
  skill_name          String[] @default([])
  years_of_experience Decimal  @db.Decimal(5, 2)
  last_used_year      DateTime @db.Date
  created_by_id       String
  updated_by_id       String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())

  @@index([candidate_id])
}

model candidate_work_experiences {
  id               String    @id
  candidate_id     String
  company_name     String
  company_website  String?
  job_title        String
  start_date       DateTime  @db.Date
  end_date         DateTime? @db.Date
  location         String?
  employment_type  String?
  work_mode        String?
  skills_used      String[]  @default([])
  responsibilities String?
  created_by_id    String
  updated_by_id    String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now())

  @@index([candidate_id])
}

model candidates {
  id                        String    @id
  tenant_id                 String
  full_name                 String
  email                     String
  phone_number              String
  country                   String?
  state                     String?
  city                      String?
  timezone                  String?
  linkedin_url              String?
  github_url                String?
  portfolio_url             String?
  preferred_contact_method  String?
  current_role              String?
  years_of_experience       Decimal?  @db.Decimal(5, 2)
  primary_skills            String[]  @default([])
  secondary_skills          String[]  @default([])
  professional_summary      String?
  work_authorization_type   String?
  visa_validity_date        DateTime? @db.Date
  willing_to_transfer_visa  Boolean   @default(false)
  preferred_employment_type String?
  expected_rate             Decimal?  @db.Decimal(15, 2)
  rate_unit                 String?
  willing_to_relocate       String?
  preferred_work_mode       String?
  earliest_available        String?
  joining_date              DateTime? @db.Date
  notice_period             Int?
  resume_url                String?
  passport_url              String?
  driving_license_url       String?
  visa_document_url         String?
  identity_proof_url        String?
  certifications_urls       Json?     @default("[]")
  internal_notes            String?
  candidate_tags            String[]  @default([])
  created_by_id             String
  updated_by_id             String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @default(now())
  is_active                 Boolean   @default(true)
  status_config             String    @default("New")
  action_config             String    @default("New")
  skill_rate                String    @default("New")

  @@index([email])
  @@index([tenant_id])
}

model channel_members {
  id           String    @id
  channel_id   String
  user_id      String
  role         String    @default("member")
  joined_at    DateTime  @default(now())
  last_read_at DateTime?
  channels     channels  @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([channel_id, user_id])
}

model channel_messages {
  id          String   @id
  channel_id  String
  user_id     String
  content     String
  type        String   @default("text")
  attachments Json     @default("[]")
  is_edited   Boolean  @default(false)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime
  channels    channels @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([channel_id, created_at])
}

model channels {
  id               String             @id
  tenant_id        String
  name             String?
  description      String?
  type             String             @default("CHANNEL")
  is_archived      Boolean            @default(false)
  last_message_at  DateTime?
  created_by_id    String
  created_at       DateTime           @default(now())
  updated_at       DateTime
  channel_members  channel_members[]
  channel_messages channel_messages[]
  users            users              @relation(fields: [created_by_id], references: [id])
  tenants          tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  meetings         meetings[]
}

model client_contacts_v2 {
  id                           String   @id
  tenant_id                    String
  client_id                    String
  first_name                   String
  last_name                    String
  display_name                 String?
  designation                  String?
  department                   String?
  contact_type                 String?
  is_primary                   Boolean  @default(false)
  official_email               String
  secondary_email              String?
  mobile_number                String?
  alternate_phone              String?
  office_landline              String?
  extension_number             String?
  preferred_communication_mode String?
  status                       String   @default("Active")
  created_at                   DateTime @default(now())
  updated_at                   DateTime
}

model client_documents_v2 {
  id             String   @id
  tenant_id      String
  client_id      String
  category       String
  document_type  String
  file_name      String
  file_url       String
  version        Int      @default(1)
  tags           String[] @default([])
  uploaded_by_id String
  created_at     DateTime @default(now())
  updated_at     DateTime
}

model client_projects {
  id           String     @id
  tenant_id    String
  client_id    String
  project_id   String
  created_at   DateTime   @default(now())
  updated_at   DateTime
  billing_type String?
  budget       Decimal?   @db.Decimal(15, 2)
  budget_type  String?    @db.VarChar(50)
  clients_v2   clients_v2 @relation(fields: [client_id], references: [id], onDelete: Cascade)
  projects     projects   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tenants      tenants    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([client_id, project_id])
}

model clients {
  id             String   @id
  tenant_id      String
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  contact_person String?
  is_active      Boolean  @default(true)
  notes          String?
  created_by_id  String
  created_at     DateTime @default(now())
  updated_at     DateTime
  users          users    @relation(fields: [created_by_id], references: [id])
  tenants        tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
}

model clients_v2 {
  id                        String            @id
  tenant_id                 String
  client_code               String            @unique
  company_name              String
  legal_name                String?
  client_type               String
  parent_id                 String?
  company_size              String?
  industry                  String?
  contract_value            Decimal?          @db.Decimal(15, 2)
  year_of_incorporation     String?
  duration                  String?
  gst_vat_tax_id            String?
  registration_number       String?
  country                   String?
  website                   String?
  default_currency          String?           @default("USD")
  billing_address           String?
  risk_level                String?
  status                    String            @default("Prospect")
  pan                       String?
  vat_number                String?
  duns_number               String?
  msme_registration         String?
  payment_terms             String?
  credit_limit              Decimal?          @db.Decimal(15, 2)
  billing_contact_email     String?
  accounts_payable_name     String?
  tds_applicable            Boolean           @default(false)
  reverse_charge_applicable Boolean           @default(false)
  account_manager_id        String?           @db.Uuid
  sales_owner_id            String?           @db.Uuid
  delivery_owner_id         String?           @db.Uuid
  client_segment            String?
  contract_start_date       DateTime?
  contract_end_date         DateTime?
  renewal_type              String?
  sla_level                 String?
  bank_name                 String?
  bank_account_number       String?
  ifsc_swift                String?
  currency_of_payment       String?
  preferred_payment_mode    String?
  is_active                 Boolean           @default(true)
  created_by_id             String
  created_at                DateTime          @default(now())
  updated_at                DateTime
  client_projects           client_projects[]

  @@unique([tenant_id, client_code])
}

model companies {
  id            Int      @id @default(autoincrement())
  tenant_id     String
  name          String
  email         String?
  phone         String?
  plot_no       String?
  floor_no      String?
  building_name String?
  street        String?
  area          String?
  city          String?
  pincode       String?
  country       String?
  cin           String?
  gst           String?
  is_active     Boolean  @default(false)
  logo          String?
  created_at    DateTime @default(now())
  updated_at    DateTime
  created_by_id String?
  updated_by_id String?

  @@unique([tenant_id, name], map: "uq_companies_tenant_name")
}

model company_government_holidays {
  id                                                     String        @id
  tenant_id                                              String
  holiday_name                                           String
  country                                                String
  from_date                                              DateTime
  to_date                                                DateTime
  base_leave                                             Int
  extra_leave                                            Int
  total_leave                                            Int
  type                                                   String
  is_floater                                             Boolean       @default(false)
  rule                                                   String?
  status                                                 HolidayStatus @default(ACTIVE)
  created_by_id                                          String
  updated_by_id                                          String?
  created_at                                             DateTime      @default(now())
  updated_at                                             DateTime
  users_company_government_holidays_created_by_idTousers users         @relation("company_government_holidays_created_by_idTousers", fields: [created_by_id], references: [id])
  tenants                                                tenants       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users_company_government_holidays_updated_by_idTousers users?        @relation("company_government_holidays_updated_by_idTousers", fields: [updated_by_id], references: [id])

  @@index([created_by_id])
  @@index([tenant_id, from_date])
  @@index([tenant_id])
}

model current_employer_contact {
  id                               String    @id
  candidate_id                     String
  reporting_manager_name           String?
  reporting_manager_email          String?
  reporting_manager_phone          String?
  current_employer_companyname     String?
  current_employer_company_website String?
  created_at                       DateTime? @default(now()) @db.Timestamp(6)
  updated_at                       DateTime? @default(now()) @db.Timestamp(6)
}

model customers {
  id           String   @id
  tenant_id    String
  company_name String
  email        String?  @unique
  phone        String?
  address      String?
  city         String?
  country      String?
  tax_id       String?
  created_at   DateTime @default(now())
  updated_at   DateTime
  created_by   String
  updated_by   String?
  gstin        String?  @db.VarChar(30)
  pan          String?  @db.VarChar(30)
  tenants      tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model deductions {
  id                Int           @id @default(autoincrement())
  name              String
  type              DeductionType
  value             Float
  salaryStructureId Int
}

model departments {
  id                                     String            @id
  tenant_id                              String
  code                                   String
  name                                   String
  employment_type                        String?
  description                            String?
  head_id                                String?
  is_active                              Boolean           @default(true)
  created_by_id                          String
  updated_by_id                          String?
  created_at                             DateTime          @default(now())
  updated_at                             DateTime
  users_departments_created_by_idTousers users             @relation("departments_created_by_idTousers", fields: [created_by_id], references: [id])
  users_departments_head_idTousers       users?            @relation("departments_head_idTousers", fields: [head_id], references: [id])
  tenants                                tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users_departments_updated_by_idTousers users?            @relation("departments_updated_by_idTousers", fields: [updated_by_id], references: [id])
  positions                              positions[]
  sub_departments                        sub_departments[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, name])
}

model document_history {
  id          String   @id
  documentId  String
  tenantId    String
  content     Json
  createdById String
  createdAt   DateTime @default(now())

  @@index([createdById], map: "document_history_createdbyid_idx")
  @@index([documentId], map: "document_history_documentid_idx")
}

model document_hub {
  id          String   @id
  tenantId    String
  name        String
  projectId   String?
  ticketId    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([createdById], map: "idx_documenthub_created_by_id")
  @@index([projectId], map: "idx_documenthub_project_id")
  @@index([tenantId], map: "idx_documenthub_tenant_id")
  @@index([ticketId], map: "idx_documenthub_ticket_id")
}

model documents {
  id            String   @id
  documentHubId String
  title         String
  content       Json
