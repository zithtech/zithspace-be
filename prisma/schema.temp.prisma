model vendor_basic_information {
  id                                                  String                     @id
  tenant_id                                           String
  company_name                                        String?
  industry                                            String?
  website                                             String?
  company_email                                       String?
  company_phone                                       String?
  status                                              Boolean?                   @default(true)
  street                                              String?
  city                                                String?
  state                                               String?
  country                                             String?
  zip_code                                            String?
  notes                                               String?
  created_by_id                                       String?
  updated_by_id                                       String?
  created_at                                          DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                                          DateTime?                  @default(now()) @db.Timestamp(6)
  users_vendor_basic_information_created_by_idTousers users?                     @relation("vendor_basic_information_created_by_idTousers", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "fk_vendor_created_by")
  tenants                                             tenants                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor_tenant")
  users_vendor_basic_information_updated_by_idTousers users?                     @relation("vendor_basic_information_updated_by_idTousers", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "fk_vendor_updated_by")
  vendor_business_detailes                            vendor_business_detailes[]
  vendor_contact_person                               vendor_contact_person[]
  vendor_document                                     vendor_document[]
  vendor_relations                                    vendor_relations[]

  @@map("vendor-basic-information")
}

model vendor_business_detailes {
  id                       String                   @id
  vendor_id                String
  registration_number      String?
  tax_id                   String?
  business_type            String?
  year_establiliesh        Int?
  total_employees          Int?
  created_at               DateTime?                @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                @default(now()) @db.Timestamp(6)
  vendor_basic_information vendor_basic_information @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor_business")
}

model vendor_contact_person {
  id                       String                   @id
  vendor_id                String
  person_name              String
  designation              String?
  email                    String?
  phone                    String?
  linkedin_url             String?
  created_at               DateTime?                @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                @default(now()) @db.Timestamp(6)
  vendor_basic_information vendor_basic_information @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor_contact")
}

model vendor_document {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()"))
  vendor_id                String
  document_type            String?
  document_url             String?
  created_at               DateTime?                @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                @default(now()) @db.Timestamp(6)
  vendor_basic_information vendor_basic_information @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor")
}

model vendor_relations {
  id                        String                   @id
  vendor_id                 String
  linked_vendor             String?
  linked_client             String?
  supports_visa_sponsorship Boolean
  visa_types_supported      String?
  created_at                DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                @default(now()) @db.Timestamp(6)
  vendor_basic_information  vendor_basic_information @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor_relations_vendor")
}

model work_authorization {
  id                      String            @id
  candidate_id            String
  work_authorization_type String?
  visa_validation_type    String?
  willing_transfer_visa   Boolean?          @default(false)
  ssn_number              String?
  passport_number         String?
  created_at              DateTime?         @default(now()) @db.Timestamp(6)
  updated_at              DateTime?         @default(now()) @db.Timestamp(6)
  candidate_details       candidate_details @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_work_auth")
}

model work_entries {
  id               String         @id
  status_update_id String
  project_id       String
  ticket_id        String?
  start_time       DateTime
  end_time         DateTime
  hours_worked     Decimal        @db.Decimal(5, 2)
  work_summary     String
  status           String
  blockers         String?
  notes            String?
  created_at       DateTime       @default(now())
  updated_at       DateTime
  projects         projects       @relation(fields: [project_id], references: [id])
  status_updates   status_updates @relation(fields: [status_update_id], references: [id], onDelete: Cascade)
  tickets          tickets?       @relation(fields: [ticket_id], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model zithspace_admin_users {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  role          String?   @default("ADMIN") @db.VarChar(50)
  is_verified   Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([email], map: "idx_users_email")
}

model zoho_events {
  id                                  String    @id
  event_id                            String
  calendar_id                         String
  title                               String
  description                         String?
  start_time                          DateTime  @db.Timestamptz(6)
  end_time                            DateTime  @db.Timestamptz(6)
  location                            String?
  user_id                             String
  updated_by                          String?
  created_at                          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime? @default(now()) @db.Timestamptz(6)
  attendees                           Json?
  calendar_name                       String?   @db.VarChar(255)
  exdate                              Json?
  is_all_day                          Boolean   @default(false)
  is_recurring                        Boolean   @default(false)
  meeting_link                        String?   @db.VarChar(255)
  rrule                               String?
  source_type                         String?   @db.VarChar(100)
  tenant_id                           String
  users_zoho_events_updated_byTousers users?    @relation("zoho_events_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_zoho_events_updated_by")
  users_zoho_events_user_idTousers    users     @relation("zoho_events_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_zoho_events_user")

  @@unique([event_id, user_id], map: "zoho_events_event_user_unique")
  @@index([calendar_id], map: "idx_zoho_events_calendar_id")
  @@index([start_time], map: "idx_zoho_events_start_time")
  @@index([user_id], map: "idx_zoho_events_user_id")
}

