model Invoice {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  invoiceNumber    String @unique @map("invoice_number")
  customerId       String @map("customer_id")
  customerSnapshot Json?  @map("customer_snapshot")
  projectId String? @map("project_id")
  templateId String? @map("template_id")
  metadata Json? @db.JsonB
  invoiceDate   DateTime      @map("invoice_date")
  dueDate       DateTime      @map("due_date")
  invoiceType   InvoiceType   @default(STANDARD) @map("invoice_type")
  status        InvoiceStatus @default(DRAFT)
  description   String?       @db.Text // Add this line
  deletedAt     DateTime?     @map("deleted_at")
  deletedBy     String?       @map("deleted_by")
  deletedByUser User?         @relation("InvoiceDeletedBy", fields: [deletedBy], references: [id])

  currency           String
  recurringFrequency RecurringFrequency? @map("recurring_frequency")

  taxInclusive     Boolean   @default(false) @map("tax_inclusive")
  discountTotal Decimal @default(0) @map("discount_total")
  subtotal         Decimal   @db.Decimal(15, 2)
  taxTotal         Decimal   @map("tax_total") @db.Decimal(15, 2)
  grandTotal            Decimal  @map("grand_total") @db.Decimal(15, 2)
  paidAmount       Decimal   @default(0) @map("paid_amount")
  balanceDue       Decimal   @map("balance_due") @db.Decimal(15, 2)
  firstPaymentDate DateTime? @map("first_payment_date")
  lastPaymentDate  DateTime? @map("last_payment_date")
  fullyPaidDate    DateTime? @map("fully_paid_date")

  notes String? @db.Text
  terms String? @db.Text

  sentAt      DateTime? @map("sent_at")
  paidAt      DateTime? @map("paid_at")
  cancelledAt DateTime? @map("cancelled_at")

  pdfUrl   String?          @map("pdf_url") @db.Text
  payments InvoicePayment[]
  attachments InvoiceAttachment[]
  activityLogs InvoiceActivityLog[]

  // Audit fields
  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer         @relation(fields: [customerId], references: [id])
  settingsProfileId String?          @map("settings_profile_id")
  settingsProfile   SettingsProfile? @relation(fields: [settingsProfileId], references: [id])
  lineItems InvoiceLineItem[]
  taxes     InvoiceTax[]

  // User audit relations
  createdByUser User  @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("InvoiceUpdatedBy", fields: [updatedBy], references: [id])
  template InvoiceTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId, invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([firstPaymentDate])
  @@index([lastPaymentDate])
  @@index([deletedAt])
  @@map("invoices")
}

