model invoice_activity_logs {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoice_id   String
  action       String    @db.VarChar(100)
  performed_by String
  metadata     Json?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([invoice_id], map: "idx_invoice_activity_logs_invoice_id")
}

model invoice_attachments {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoice_id  String
  file_name   String
  file_url    String
  uploaded_by String
  uploaded_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([invoice_id], map: "idx_invoice_attachments_invoice_id")
}

model InvoiceItem {
  id           String    @id @default(uuid()) @map("invoice_items_pkey")
  tenantId     String    @map("tenant_id")
  invoiceId    String    @map("invoice_id")
  item         String    @map("item_name")
  description  String?
  qty          Decimal   @default(1) @map("quantity") @db.Decimal(12, 2)
  price        Decimal   @default(0) @map("rate") @db.Decimal(12, 2)
  tax          Decimal   @default(0) @map("tax_rate") @db.Decimal(6, 2)
  createdBy    String    @map("created_by")
  updatedBy    String?   @map("updated_by")
  deletedBy    String?   @map("deleted_by")
  createdByUser User      @relation("InvoiceItemCreator", fields: [createdBy], references: [id])
  updatedByUser User?     @relation("InvoiceItemUpdater", fields: [updatedBy], references: [id])
  deletedByUser User?     @relation("InvoiceItemDeleter", fields: [deletedBy], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)
  row_number   Int?
  projectId    String?   @map("project_id")
  hours        Decimal?  @db.Decimal(12, 2)
  subtotal     Decimal?  @db.Decimal(14, 2)
  tax_amount   Decimal?  @db.Decimal(14, 2)
  total        Decimal?  @db.Decimal(14, 2)
  extra_fields Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_invoice_items_invoice_id")
  @@index([tenantId], map: "idx_invoice_items_tenant_id")
  @@index([invoiceId], map: "idx_invoice_line_items_invoice_id")
  @@index([invoiceId, row_number], map: "idx_invoice_line_items_invoice_row")
  @@index([tenantId], map: "idx_invoice_line_items_tenant_id")
  @@map("invoice_line_items")
}

model invoice_taxes {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenant_id  String
  invoice_id String
  tax_name   String    @db.VarChar(100)
  tax_rate   Decimal   @db.Decimal(6, 2)
  tax_amount Decimal   @db.Decimal(14, 2)
  deleted_at DateTime? @db.Timestamp(6)
  deleted_by String?
  created_by String
  updated_by String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([invoice_id], map: "idx_invoice_taxes_invoice_id")
  @@index([tenant_id], map: "idx_invoice_taxes_tenant_id")
}

model invoice_template_fields {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id String    @db.Uuid
  field_key   String    @db.VarChar(100)
  field_label String    @db.VarChar(200)
  field_type  String    @db.VarChar(50)
  field_order Int
  is_required Boolean?  @default(false)
  is_system   Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
