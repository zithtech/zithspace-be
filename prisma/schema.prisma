model invoices {
  id                               String               @id
  tenant_id                        String
  invoice_number                   String               @unique
  customer_id                      String
  customer_snapshot                Json?
  invoice_date                     DateTime             @db.Timestamp(6)
  due_date                         DateTime             @db.Timestamp(6)
  invoice_type                     invoice_type         @default(STANDARD)
  status                           invoice_status       @default(DRAFT)
  currency                         String
  recurring_frequency              recurring_frequency?
  tax_inclusive                    Boolean              @default(false)
  discount                         Decimal              @default(0) @db.Decimal(15, 2)
  subtotal                         Decimal              @db.Decimal(15, 2)
  tax_total                        Decimal              @db.Decimal(15, 2)
  total                            Decimal              @db.Decimal(15, 2)
  paid                             Decimal              @default(0) @db.Decimal(15, 2)
  balance_due                      Decimal              @db.Decimal(15, 2)
  notes                            String?
  terms                            String?
  created_by                       String
  updated_by                       String?
  created_at                       DateTime             @default(now()) @db.Timestamp(6)
  updated_at                       DateTime             @default(now()) @db.Timestamp(6)
  settings_profile_id              String?
  sent_at                          DateTime?            @db.Timestamp(6)
  paid_at                          DateTime?            @db.Timestamp(6)
  cancelled_at                     DateTime?            @db.Timestamp(6)
  invoice_items                    invoice_items[]
  users_invoices_created_byTousers User                 @relation("invoices_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_created_by")
  customers                        customers            @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_customer")
  settings_profiles                settings_profiles?   @relation(fields: [settings_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_settings_profile")
  tenants                          Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_tenant")
  users_invoices_updated_byTousers User?                @relation("invoices_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_updated_by")

  @@index([customer_id], map: "idx_invoices_customer_id")
  @@index([status], map: "idx_invoices_status")
  @@index([tenant_id], map: "idx_invoices_tenant_id")
}

model meeting_participants {
