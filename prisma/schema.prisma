  googleChannelExpiry DateTime? @map("google_channel_expiry") @db.Timestamptz(6)

  // MICROSOFT
  microsoftDeltaLink          String?   @map("microsoft_delta_link")
  microsoftSubscriptionId     String?   @map("microsoft_subscription_id")
  microsoftSubscriptionExpiry DateTime? @map("microsoft_subscription_expiry") @db.Timestamptz(6)
  microsoftClientState        String?   @map("microsoft_client_state")

  // ZOHO
  zohoLastSync DateTime? @map("zoho_last_sync") @db.Timestamptz(6)

  // SYNC STATE
  isSyncing      Boolean   @default(false) @map("is_syncing")
  lastSyncStatus String?   @map("last_sync_status") // 'SUCCESS', 'FAILED', 'NEEDS_REAUTH'
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz(6)
  nextSyncDueAt  DateTime? @default(now()) @map("next_sync_due_at") @db.Timestamptz(6)
  syncErrorCount Int       @default(0) @map("sync_error_count")

  createdById String? @map("created_by_id")
  updatedById String? @map("updated_by_id")

  // Audit
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy User?    @relation("CreatedByUser", fields: [createdById], references: [id])
  updatedBy User?    @relation("UpdatedByUser", fields: [updatedById], references: [id])

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([tenantId])
  @@map("calendar_integrations")
