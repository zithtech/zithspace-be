model SprintCompletionLog {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  sprintPlanId    String   @map("sprint_plan_id")
  projectId       String   @map("project_id")
  ticketId        String   @map("ticket_id")
  action          String // moved_to_sprint, moved_to_bucket, moved_to_backlog, moved_to_trash
  destinationId   String?  @map("destination_id") // Sprint ID, Bucket ID, or null for backlog/trash
  destinationType String?  @map("destination_type") // sprint, bucket, backlog, trash
  performedById   String   @map("performed_by_id")
  performedAt     DateTime @default(now()) @map("performed_at")
  metadata        Json?    @default("{}") // Additional context (previous state, notes, etc.)

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprintPlan  ReleasePlan @relation(fields: [sprintPlanId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  performedBy User        @relation(fields: [performedById], references: [id])

  @@index([sprintPlanId])
  @@index([projectId])
  @@index([ticketId])
  @@index([tenantId])
  @@index([performedAt])
  @@map("sprint_completion_logs")
}

enum Currency {
  USD
  INR
  EUR
  GBP
  AUD
  CAD
  SGD
}

enum DateFormat {
  DD_MM_YYYY
  MM_DD_YYYY
  YYYY_MM_DD
}

model GeneralSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  companyName  String     @map("company_name")
  address      Json
  primaryColor String     @map("primary_color")
  currency     Currency
  dateFormat   DateFormat @map("date_format")
  companyLogo  String?    @map("company_logo")
  signature    String?

  // Audit
  createdBy String  @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdByUser User  @relation("GeneralSettingCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("GeneralSettingUpdatedBy", fields: [updatedBy], references: [id])

  profiles SettingsProfile[]

  @@index([tenantId])
  @@map("general_settings")
}

model InvoiceSetting {
