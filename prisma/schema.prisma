  @@index([parentId])
  @@index([projectId, releasePlanId])
  @@index([projectId, sprintPlanId])
  @@index([projectId, demoPlanId])
  @@index([bucketId], map: "idx_tickets_bucket_id")
  @@index([isDeleted, deletedAt], map: "idx_tickets_is_deleted_deleted_at")
