generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                          String                        @id @default(uuid())
  name                        String
  subdomain                   String                        @unique
  planType                    String                        @default("basic") @map("plan_type")
  maxUsers                    Int                           @default(10) @map("max_users")
  isActive                    Boolean                       @default(true) @map("is_active")
  settings                    Json?                         @default("{}")
  createdAt                   DateTime                      @default(now()) @map("created_at")
  updatedAt                   DateTime                      @updatedAt @map("updated_at")
  attendance                  Attendance[]
  attendanceBreaks            AttendanceBreak[]
  buckets                     Bucket[]
  channels                    channels[]
  clients                     Client[]
  company_government_holidays company_government_holidays[]
  customers                   customers[]
  document_history            document_history[]
  document_hub                document_hub[]
  documents                   documents[]
  documenttree                documenttree[]
  dropdownOptions             DropdownOption[]
  employeeFields              EmployeeField[]
  payslipFields PayslipField[]
  salaryStructures SalaryStructure[]
  payslips Payslip[]  
  fixedHolidays               FixedHoliday[]
  general_settings            general_settings[]
  invoice_items               invoice_items[]
  invoice_settings            invoice_settings[]
  invoices                    invoices[]
  leaves                      Leave[]
  meetings                    meetings[]
  payment_settings            payment_settings[]
  projects                    Project[]
  releasePlans                ReleasePlan[]
  salaryComponents            SalaryComponent[]
  settings_profiles           settings_profiles[]
  shifts                      Shift[]
  sprintCompletionLogs        SprintCompletionLog[]
  statusUpdates               StatusUpdate[]
  ticketActivityLog           TicketActivityLog[]
  ticketAttachments           TicketAttachment[]
  ticketComments              TicketComment[]
  ticketRelatedLinks          TicketRelatedLink[]
  ticketWorkflowSteps         TicketWorkflowStep[]
  tickets                     Ticket[]
  transactions                Transaction[]
  users                       User[]

  @@map("tenants")
}

model User {
  id                                                                           String                        @id @default(uuid())
  tenantId                                                                     String                        @map("tenant_id")
  name                                                                         String
  workEmail                                                                    String                        @map("work_email")
  personalEmail                                                                String                        @map("personal_email")
  phone                                                                        String
  passwordHash                                                                 String                        @map("password_hash")
  role                                                                         String                        @default("user")
  position                                                                     String
  reportsToId                                                                  String?                       @map("reports_to_id")
  dateOfBirth                                                                  DateTime?                     @map("date_of_birth")
  workDays                                                                     Int[]                         @default([1, 2, 3, 4, 5]) @map("work_days")
  assignedShiftId                                                              String?                       @map("assigned_shift_id")
  shiftAssignedById                                                            String?                       @map("shift_assigned_by_id")
  shiftAssignedDate                                                            DateTime?                     @map("shift_assigned_date")
  isActive                                                                     Boolean                       @default(true) @map("is_active")
  lastLoginAt                                                                  DateTime?                     @map("last_login_at")
  createdAt                                                                    DateTime                      @default(now()) @map("created_at")
  updatedAt                                                                    DateTime                      @updatedAt @map("updated_at")
  addresses_addresses_created_by_idTousers                                     addresses[]                   @relation("addresses_created_by_idTousers")
  addresses_addresses_updated_by_idTousers                                     addresses[]                   @relation("addresses_updated_by_idTousers")
  enteredAttendance                                                            Attendance[]                  @relation("AttendanceEnteredBy")
  attendance                                                                   Attendance[]
  bucketMemberships                                                            BucketMember[]
  createdBuckets                                                               Bucket[]                      @relation("BucketCreator")
  channel_members                                                              channel_members[]
  channel_messages                                                             channel_messages[]
  channels                                                                     channels[]
  createdClients                                                               Client[]                      @relation("ClientCreator")
  createdCompanies                                                             Company[]                     @relation("CompanyCreator")
  updatedCompanies                                                             Company[]                     @relation("CompanyUpdater")
  company_government_holidays_company_government_holidays_created_by_idTousers company_government_holidays[] @relation("company_government_holidays_created_by_idTousers")
  company_government_holidays_company_government_holidays_updated_by_idTousers company_government_holidays[] @relation("company_government_holidays_updated_by_idTousers")
  document_history                                                             document_history[]
  document_hub                                                                 document_hub[]
  documenttree                                                                 documenttree[]
  createdEmployeeFields                                                        EmployeeField[]               @relation("EmployeeFieldCreator")
  updatedEmployeeFields                                                        EmployeeField[]               @relation("EmployeeFieldUpdater")
  createdFixedHolidays                                                         FixedHoliday[]                @relation("FixedHolidayCreator")
  updatedFixedHolidays                                                         FixedHoliday[]                @relation("FixedHolidayUpdater")
  general_settings_general_settings_created_byTousers                          general_settings[]            @relation("general_settings_created_byTousers")
  general_settings_general_settings_updated_byTousers                          general_settings[]            @relation("general_settings_updated_byTousers")
  invoice_items_invoice_items_created_byTousers                                invoice_items[]               @relation("invoice_items_created_byTousers")
  invoice_items_invoice_items_updated_byTousers                                invoice_items[]               @relation("invoice_items_updated_byTousers")
  invoice_settings_invoice_settings_created_byTousers                          invoice_settings[]            @relation("invoice_settings_created_byTousers")
  invoice_settings_invoice_settings_updated_byTousers                          invoice_settings[]            @relation("invoice_settings_updated_byTousers")
  invoices_invoices_created_byTousers                                          invoices[]                    @relation("invoices_created_byTousers")
  invoices_invoices_updated_byTousers                                          invoices[]                    @relation("invoices_updated_byTousers")
  approvedLeaves                                                               Leave[]                       @relation("LeaveApprover")
  leaves                                                                       Leave[]                       @relation("UserLeaves")
  meeting_participants                                                         meeting_participants[]
  meetings                                                                     meetings[]
  payment_settings_payment_settings_created_byTousers                          payment_settings[]            @relation("payment_settings_created_byTousers")
  payment_settings_payment_settings_updated_byTousers                          payment_settings[]            @relation("payment_settings_updated_byTousers")
  projectMemberships                                                           ProjectMember[]
  createdProjects                                                              Project[]                     @relation("ProjectCreator")
  managedProjects                                                              Project[]                     @relation("ProjectManager")
  refreshTokens                                                                RefreshToken[]
  createdReleasePlans                                                          ReleasePlan[]                 @relation("ReleasePlanCreator")
  createdSalaryComponents                                                      SalaryComponent[]             @relation("SalaryComponentCreator")
  updatedSalaryComponents                                                      SalaryComponent[]             @relation("SalaryComponentUpdater")
  settings_profiles_settings_profiles_created_byTousers                        settings_profiles[]           @relation("settings_profiles_created_byTousers")
  settings_profiles_settings_profiles_updated_byTousers                        settings_profiles[]           @relation("settings_profiles_updated_byTousers")
  sprintCompletionLogs                                                         SprintCompletionLog[]
  statusUpdates                                                                StatusUpdate[]                @relation("UserStatusUpdates")
  performedActivityLog                                                         TicketActivityLog[]
  ticketAttachments                                                            TicketAttachment[]
  ticketComments                                                               TicketComment[]
  addedRelatedLinks                                                            TicketRelatedLink[]
   payslipsCreated  Payslip[] @relation("UserPayslips")

  deletedTickets                                                               Ticket[]                      @relation("TicketDeletedBy")
  archivedTickets                                                              Ticket[]                      @relation("TicketArchivedBy")
  assignedTickets                                                              Ticket[]                      @relation("TicketAssignee")
  createdTickets                                                               Ticket[]                      @relation("TicketCreator")
  reportToTickets                                                              Ticket[]                      @relation("TicketReportTo")
  timesheet_rows_timesheet_rows_created_by_idTousers                           timesheet_rows[]              @relation("timesheet_rows_created_by_idTousers")
  timesheet_rows_timesheet_rows_updated_by_idTousers                           timesheet_rows[]              @relation("timesheet_rows_updated_by_idTousers")
  timesheets_timesheets_approved_by_idTousers                                  timesheets[]                  @relation("timesheets_approved_by_idTousers")
  timesheets_timesheets_created_by_idTousers                                   timesheets[]                  @relation("timesheets_created_by_idTousers")
  timesheets_timesheets_updated_by_idTousers                                   timesheets[]                  @relation("timesheets_updated_by_idTousers")
  timesheets_timesheets_user_idTousers                                         timesheets[]                  @relation("timesheets_user_idTousers")
 createdPayslipFields PayslipField[] @relation("PayslipFieldCreator")
  updatedPayslipFields PayslipField[] @relation("PayslipFieldUpdater")
  createdSalaryStructures SalaryStructure[] @relation("SalaryStructureCreator")
  updatedSalaryStructures SalaryStructure[] @relation("SalaryStructureUpdater")
  transactions                                                                 Transaction[]
  assignedShift                                                                Shift?                        @relation("UserShift", fields: [assignedShiftId], references: [id])
  reportsTo                                                                    User?                         @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates                                                                 User[]                        @relation("UserHierarchy")
  shiftAssignedBy                                                              User?                         @relation("ShiftAssigner", fields: [shiftAssignedById], references: [id])
  assignedShifts                                                               User[]                        @relation("ShiftAssigner")
  tenant                                                                       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workEmail])
  @@unique([tenantId, personalEmail])
  @@unique([tenantId, phone])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  name                 String
  code                 String?               @unique
  description          String
  status               String                @default("active")
  startDate            DateTime              @map("start_date")
  endDate              DateTime?             @map("end_date")
  projectManagerId     String                @map("project_manager_id")
  repositories         Json?                 @default("[]")
  workflowTemplate     String[]              @map("workflow_template")
  defaultPriority      String                @default("medium") @map("default_priority")
  totalTickets         Int                   @default(0) @map("total_tickets")
  completedTickets     Int                   @default(0) @map("completed_tickets")
  inProgressTickets    Int                   @default(0) @map("in_progress_tickets")
  createdById          String                @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  buckets              Bucket[]
  document_hub         document_hub[]
  members              ProjectMember[]
  createdBy            User                  @relation("ProjectCreator", fields: [createdById], references: [id])
  projectManager       User                  @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasePlans         ReleasePlan[]
  sprintCompletionLogs SprintCompletionLog[]
  tickets              Ticket[]
  workEntries          WorkEntry[]

  @@unique([tenantId, code])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Ticket {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  projectId           String               @map("project_id")
  releasePlanId       String?              @map("release_plan_id")
  title               String
  description         String?
  ticketNumber        String               @map("ticket_number")
  status              String               @default("not_started")
  priority            String               @default("Medium (P2)")
  type                String               @default("Task")
  platform            String               @default("Development")
  stack               String?
  taskLevel           String               @default("Medium") @map("task_level")
  storyPoint          Int                  @default(1) @map("story_point")
  estimateHours       Decimal              @default(0) @map("estimate_hours") @db.Decimal(5, 2)
  assigneeId          String?              @map("assignee_id")
  reportToId          String?              @map("report_to_id")
  createdById         String               @map("created_by_id")
  parentTickets       String[]             @default([]) @map("parent_tickets")
  parentTicketNotes   String?              @map("parent_ticket_notes")
  currentWorkflowStep String               @default("Scope Document") @map("current_workflow_step")
  startDate           DateTime?            @map("start_date")
  endDate             DateTime?            @map("end_date")
  dueDate             DateTime?            @map("due_date")
  completedAt         DateTime?            @map("completed_at")
  tags                String[]             @default([])
  metadata            Json?                @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  epicId              String?              @map("epic_id")
  parentId            String?              @map("parent_id")
  rank                String?
  demoPlanId          String?              @map("demo_plan_id")
  sprintPlanId        String?              @map("sprint_plan_id")
  isArchived          Boolean              @default(false) @map("is_archived")
  archivedAt          DateTime?            @map("archived_at")
  archivedById        String?              @map("archived_by_id") @db.VarChar(255)
  bucketId            String?              @map("bucket_id") @db.VarChar(255)
  isDeleted           Boolean?             @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamp(6)
  deletedById         String?              @map("deleted_by_id") @db.VarChar(255)
  document_hub        document_hub[]
  activityLog         TicketActivityLog[]
  attachments         TicketAttachment[]
  comments            TicketComment[]
  relatedLinks        TicketRelatedLink[]
  workflowSteps       TicketWorkflowStep[]
  bucket              Bucket?              @relation(fields: [bucketId], references: [id], onUpdate: NoAction, map: "fk_tickets_bucket")
  deletedBy           User?                @relation("TicketDeletedBy", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tickets_deleted_by")
  archivedBy          User?                @relation("TicketArchivedBy", fields: [archivedById], references: [id])
  assignee            User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy           User                 @relation("TicketCreator", fields: [createdById], references: [id])
  demoPlan            ReleasePlan?         @relation("TicketDemoPlan", fields: [demoPlanId], references: [id])
  epic                Ticket?              @relation("EpicStories", fields: [epicId], references: [id])
  stories             Ticket[]             @relation("EpicStories")
  parent              Ticket?              @relation("ParentSubTasks", fields: [parentId], references: [id])
  subTasks            Ticket[]             @relation("ParentSubTasks")
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasePlan         ReleasePlan?         @relation("TicketReleasePlan", fields: [releasePlanId], references: [id])
  reportTo            User?                @relation("TicketReportTo", fields: [reportToId], references: [id])
  sprintPlan          ReleasePlan?         @relation("TicketSprintPlan", fields: [sprintPlanId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workEntries         WorkEntry[]

  @@unique([tenantId, ticketNumber])
  @@index([epicId])
  @@index([parentId])
  @@index([projectId, releasePlanId])
  @@index([projectId, sprintPlanId])
  @@index([projectId, demoPlanId])
  @@index([isArchived], map: "idx_tickets_archived")
  @@index([bucketId], map: "idx_tickets_bucket_id")
  @@index([isDeleted, deletedAt], map: "idx_tickets_is_deleted_deleted_at")
  @@index([projectId, isArchived], map: "idx_tickets_project_archived")
  @@index([projectId, isDeleted], map: "idx_tickets_project_is_deleted")
  @@index([status, isArchived], map: "idx_tickets_status_archived")
  @@index([tenantId, isArchived], map: "idx_tickets_tenant_archived")
  @@index([tenantId, isDeleted], map: "idx_tickets_tenant_is_deleted")
  @@map("tickets")
}

model TicketWorkflowStep {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  ticketId         String    @map("ticket_id")
  stepName         String    @map("step_name")
  status           String    @default("not_started")
  assignedTo       String[]  @default([]) @map("assigned_to")
  approvers        String[]  @default([]) @map("approvers")
  approvalStatus   Json      @default("[]") @map("approval_status")
  documents        Json      @default("[]")
  notes            String?
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  completedAt      DateTime? @map("completed_at")
  scheduledMeeting Json?     @map("scheduled_meeting")
  branchName       String?   @map("branch_name")
  testResults      Json      @default("[]") @map("test_results")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_workflow_steps")
}

model TicketComment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  userId      String   @map("user_id")
  comment     String
  attachments Json     @default("[]")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

model TicketRelatedLink {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  linkType    String   @map("link_type")
  title       String
  description String
  url         String
  addedById   String   @map("added_by_id")
  addedAt     DateTime @default(now()) @map("added_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  addedBy     User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_related_links")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  ticketId     String   @map("ticket_id")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type")
  fileUrl      String   @map("file_url")
  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tenantId, ticketId])
  @@index([tenantId, ticketId], map: "idx_attachment_tenant_ticket")
  @@index([ticketId], map: "idx_attachment_ticket")
  @@map("ticket_attachments")
}

model TicketActivityLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  ticketId      String   @map("ticket_id")
  action        String
  performedById String   @map("performed_by_id")
  timestamp     DateTime @default(now())
  details       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  performedBy   User     @relation(fields: [performedById], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_activity_log")
}

model Client {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  contactPerson String?  @map("contact_person")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     User     @relation("ClientCreator", fields: [createdById], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("clients")
}

model ReleasePlan {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  projectId            String                @map("project_id")
  version              String
  description          String?
  status               String                @default("planned")
  releaseDate          DateTime?             @map("release_date")
  createdById          String                @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  type                 String                @default("release_plan")
  goal                 String?
  startedAt            DateTime?             @map("started_at")
  completedAt          DateTime?             @map("completed_at")
  committedPoints      Int                   @default(0) @map("committed_points")
  completedPoints      Int                   @default(0) @map("completed_points")
  endDate              DateTime?             @map("end_date")
  startDate            DateTime?             @map("start_date")
  createdBy            User                  @relation("ReleasePlanCreator", fields: [createdById], references: [id])
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprintCompletionLogs SprintCompletionLog[]
  demoTickets          Ticket[]              @relation("TicketDemoPlan")
  tickets              Ticket[]              @relation("TicketReleasePlan")
  sprintTickets        Ticket[]              @relation("TicketSprintPlan")

  @@unique([tenantId, projectId, version])
  @@index([projectId, type, status])
  @@map("release_plans")
}

model Shift {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  name              String
  startTime         String       @map("start_time")
  endTime           String       @map("end_time")
  workingMinutes    Int          @default(480) @map("working_minutes")
  graceMinutes      Int          @default(15) @map("grace_minutes")
  overtimeThreshold Int          @default(60) @map("overtime_threshold")
  breakMinutes      Int          @default(60) @map("break_minutes")
  description       String?
  color             String       @default("#007bff")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  attendance        Attendance[]
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]       @relation("UserShift")

  @@unique([tenantId, name])
  @@map("shifts")
}

model Attendance {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  userId               String            @map("user_id")
  date                 DateTime
  clockIn              DateTime?         @map("clock_in")
  clockOut             DateTime?         @map("clock_out")
  status               String            @default("present")
  shiftId              String?           @map("shift_id")
  totalWorkMinutes     Int               @default(0) @map("total_work_minutes")
  totalBreakMinutes    Int               @default(0) @map("total_break_minutes")
  effectiveWorkMinutes Int               @default(0) @map("effective_work_minutes")
  overtimeMinutes      Int               @default(0) @map("overtime_minutes")
  lateMinutes          Int               @default(0) @map("late_minutes")
  isManualEntry        Boolean           @default(false) @map("is_manual_entry")
  enteredById          String?           @map("entered_by_id")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  enteredBy            User?             @relation("AttendanceEnteredBy", fields: [enteredById], references: [id])
  shift                Shift?            @relation(fields: [shiftId], references: [id])
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks               AttendanceBreak[]

  @@map("attendance")
}

model AttendanceBreak {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  attendanceId    String     @map("attendance_id")
  breakType       String     @map("break_type")
  startTime       DateTime   @map("start_time")
  endTime         DateTime?  @map("end_time")
  durationMinutes Int        @default(0) @map("duration_minutes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendance_breaks")
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  description String
  category    String?
  date        DateTime
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model DropdownOption {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  category  String
  value     String
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category, value])
  @@map("dropdown_options")
}

model StatusUpdate {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  tenantId         String      @map("tenant_id")
  date             DateTime    @db.Date
  projectUpdates   Json        @default("[]") @map("project_updates")
  mood             String?
  totalHoursWorked Decimal?    @map("total_hours_worked") @db.Decimal(5, 2)
  generalNotes     String?     @map("general_notes")
  submittedAt      DateTime    @default(now()) @map("submitted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  is_missed        Boolean     @default(false)
  missed_updateAt  DateTime?
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User        @relation("UserStatusUpdates", fields: [userId], references: [id], onDelete: Cascade)
  workEntries      WorkEntry[]

  @@index([tenantId, date])
  @@index([userId, date])
  @@map("status_updates")
}

model WorkEntry {
  id             String       @id @default(uuid())
  statusUpdateId String       @map("status_update_id")
  projectId      String       @map("project_id")
  ticketId       String?      @map("ticket_id")
  startTime      DateTime     @map("start_time")
  endTime        DateTime     @map("end_time")
  hoursWorked    Decimal      @map("hours_worked") @db.Decimal(5, 2)
  workSummary    String       @map("work_summary")
  status         String
  blockers       String?
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  project        Project      @relation(fields: [projectId], references: [id])
  statusUpdate   StatusUpdate @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id])

  @@map("work_entries")
}

model Leave {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  type            String
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  duration        Decimal   @db.Decimal(5, 2)
  durationType    String    @map("duration_type")
  reason          String
  status          String    @default("pending")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  attachments     Json      @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  approvedBy      User?     @relation("LeaveApprover", fields: [approvedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model FixedHoliday {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  holidayName String
  country     String
  state       String[]
  fromDate    DateTime @map("from_date")
  toDate      DateTime @map("to_date")
  type        String
  rule        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdBy   User?    @relation("FixedHolidayCreator", fields: [createdById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("FixedHolidayUpdater", fields: [updatedById], references: [id])

  @@map("fixed_holidays")
}

model Bucket {
  id          String         @id @default(uuid()) @db.VarChar(255)
  tenantId    String         @map("tenant_id") @db.VarChar(255)
  projectId   String?        @map("project_id") @db.VarChar(255)
  name        String         @db.VarChar(255)
  description String?
  color       String?        @default("#6366f1") @db.VarChar(50)
  isShared    Boolean?       @default(false) @map("is_shared")
  createdById String         @map("created_by_id") @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  members     BucketMember[]
  createdBy   User           @relation("BucketCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_buckets_creator")
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_buckets_project")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_buckets_tenant")
  tickets     Ticket[]

  @@unique([tenantId, projectId, name], map: "unique_bucket_per_project")
  @@index([createdById], map: "idx_buckets_created_by_id")
  @@index([projectId], map: "idx_buckets_project_id")
  @@index([tenantId], map: "idx_buckets_tenant_id")
  @@map("buckets")
}

model BucketMember {
  id       String   @id @default(uuid()) @db.VarChar(255)
  bucketId String   @map("bucket_id") @db.VarChar(255)
  userId   String   @map("user_id") @db.VarChar(255)
  role     String?  @default("member") @db.VarChar(50)
  addedAt  DateTime @default(now()) @map("added_at") @db.Timestamp(6)
  bucket   Bucket   @relation(fields: [bucketId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bucket_members_bucket")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bucket_members_user")

  @@unique([bucketId, userId], map: "unique_bucket_member")
  @@index([bucketId], map: "idx_bucket_members_bucket_id")
  @@index([userId], map: "idx_bucket_members_user_id")
  @@map("bucket_members")
}

model SprintCompletionLog {
  id              String      @id @default(uuid()) @db.VarChar(255)
  tenantId        String      @map("tenant_id") @db.VarChar(255)
  sprintPlanId    String      @map("sprint_plan_id") @db.VarChar(255)
  projectId       String      @map("project_id") @db.VarChar(255)
  ticketId        String      @map("ticket_id") @db.VarChar(255)
  action          String      @db.VarChar(100)
  destinationId   String?     @map("destination_id") @db.VarChar(255)
  destinationType String?     @map("destination_type") @db.VarChar(50)
  performedById   String      @map("performed_by_id") @db.VarChar(255)
  performedAt     DateTime    @default(now()) @map("performed_at") @db.Timestamp(6)
  metadata        Json?       @default("{}")
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sprint_completion_logs_project")
  sprintPlan      ReleasePlan @relation(fields: [sprintPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sprint_completion_logs_sprint")
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sprint_completion_logs_tenant")
  performedBy     User        @relation(fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sprint_completion_logs_user")

  @@index([action, performedAt(sort: Desc)], map: "idx_sprint_completion_logs_action")
  @@index([performedAt], map: "idx_sprint_completion_logs_performed_at")
  @@index([projectId], map: "idx_sprint_completion_logs_project_id")
  @@index([sprintPlanId], map: "idx_sprint_completion_logs_sprint_plan_id")
  @@index([tenantId, sprintPlanId, performedAt(sort: Desc)], map: "idx_sprint_completion_logs_tenant_date")
  @@index([tenantId], map: "idx_sprint_completion_logs_tenant_id")
  @@index([ticketId], map: "idx_sprint_completion_logs_ticket_id")
  @@map("sprint_completion_logs")
}

model SalaryComponent {
  key           Int           @id @default(autoincrement())
  tenantId      String        @map("tenant_id") @db.VarChar(255)
  componentName String        @map("component_name") @db.VarChar(100)
  componentCode String        @map("component_code") @db.VarChar(50)
  type          ComponentType @default(Earning)
  status        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  createdById   String?       @map("created_by_id") @db.VarChar(255)
  updatedById   String?       @map("updated_by_id") @db.VarChar(255)
  createdBy     User?         @relation("SalaryComponentCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_salary_component_created_by")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_salary_component_tenant")
  updatedBy     User?         @relation("SalaryComponentUpdater", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_salary_component_updated_by")

  @@unique([tenantId, componentCode], map: "uq_salary_component_tenant_code")
  @@map("salary_components")
}

model Company {
  id             Int             @id @default(autoincrement())
  tenantId       String          @map("tenant_id")
  name           String
  email          String?
  phone          String?
  plotNo         String?         @map("plot_no")
  floorNo        String?         @map("floor_no")
  buildingName   String?         @map("building_name")
  street         String?
  area           String?
  city           String?
  pincode        String?
  country        String?
  cin            String?
  gst            String?
  isActive       Boolean         @default(false) @map("is_active")
  logo           String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  createdById    String?         @map("created_by_id")
  updatedById    String?         @map("updated_by_id")
  createdBy      User?           @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_created_by")
  updatedBy      User?           @relation("CompanyUpdater", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_updated_by")
  employeeFields EmployeeField[]

  @@unique([tenantId, name], map: "uq_companies_tenant_name")
  @@map("companies")
}

model EmployeeField {
  id          Int      @id @default(autoincrement())
  tenantId    String   @map("tenant_id")
  companyId   Int      @map("company_id")
  systemKey   String   @map("system_key")
  displayName String   @map("display_name")
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee_field_company")
  createdBy   User?    @relation("EmployeeFieldCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_field_created_by")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee_field_tenant")
  updatedBy   User?    @relation("EmployeeFieldUpdater", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_field_updated_by")

  @@unique([tenantId, companyId, systemKey], map: "uq_employee_field_tenant_company_system_key")
  @@map("employee_field_configs")
}

model addresses {
  id                                   String            @id
  employee_id                          String
  address_type                         address_type_enum
  door_no                              String?           @db.VarChar(50)
  area                                 String?           @db.VarChar(150)
  city                                 String?           @db.VarChar(100)
  state                                String?           @db.VarChar(100)
  pincode                              String?           @db.VarChar(10)
  country                              String?           @db.VarChar(100)
  created_by_id                        String
  updated_by_id                        String?
  created_at                           DateTime?         @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?         @default(now()) @db.Timestamp(6)
  users_addresses_created_by_idTousers User              @relation("addresses_created_by_idTousers", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_address_created_by")
  employees                            employees         @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_address_employee")
  users_addresses_updated_by_idTousers User?             @relation("addresses_updated_by_idTousers", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_address_updated_by")
}

model channel_members {
  id           String    @id
  channel_id   String
  user_id      String
  role         String    @default("member")
  joined_at    DateTime  @default(now())
  last_read_at DateTime?
  channels     channels  @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([channel_id, user_id])
}

model channel_messages {
  id          String   @id
  channel_id  String
  user_id     String
  content     String
  type        String   @default("text")
  attachments Json     @default("[]")
  is_edited   Boolean  @default(false)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime
  channels    channels @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  users       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([channel_id, created_at])
}

model channels {
  id               String             @id
  tenant_id        String
  name             String?
  description      String?
  type             String             @default("CHANNEL")
  is_archived      Boolean            @default(false)
  last_message_at  DateTime?
  created_by_id    String
  created_at       DateTime           @default(now())
  updated_at       DateTime
  channel_members  channel_members[]
  channel_messages channel_messages[]
  users            User               @relation(fields: [created_by_id], references: [id])
  tenants          Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  meetings         meetings[]
}

model company_government_holidays {
  id                                                     String        @id
  tenant_id                                              String
  holiday_name                                           String
  country                                                String
  from_date                                              DateTime
  to_date                                                DateTime
  base_leave                                             Int
  extra_leave                                            Int
  total_leave                                            Int
  type                                                   String
  is_floater                                             Boolean       @default(false)
  rule                                                   String?
  status                                                 HolidayStatus @default(ACTIVE)
  created_by_id                                          String
  updated_by_id                                          String?
  created_at                                             DateTime      @default(now())
  updated_at                                             DateTime
  users_company_government_holidays_created_by_idTousers User          @relation("company_government_holidays_created_by_idTousers", fields: [created_by_id], references: [id])
  tenants                                                Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users_company_government_holidays_updated_by_idTousers User?         @relation("company_government_holidays_updated_by_idTousers", fields: [updated_by_id], references: [id])

  @@index([created_by_id])
  @@index([tenant_id, from_date])
  @@index([tenant_id])
}

model customers {
  id           String     @id
  tenant_id    String
  company_name String
  email        String?    @unique
  phone        String?
  address      String?
  city         String?
  country      String?
  tax_id       String?
  created_at   DateTime   @default(now())
  updated_at   DateTime
  created_by   String
  updated_by   String?
  tenants      Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  invoices     invoices[]
}

model document_history {
  id          String    @id
  documentId  String
  tenantId    String
  content     Json
  createdById String
  createdAt   DateTime? @default(now())
  users       User      @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_history_createdby")
  documents   documents @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_history_document")
  tenants     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_history_tenant")

  @@index([createdById], map: "document_history_createdbyid_idx")
  @@index([documentId], map: "document_history_documentid_idx")
}

model document_hub {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String
  name         String
  projectId    String?
  ticketId     String?
  createdById  String
  createdAt    DateTime?      @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?      @default(now()) @db.Timestamp(6)
  users        User           @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenthub_created_by")
  projects     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenthub_project")
  tenants      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenthub_tenant")
  tickets      Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenthub_ticket")
  documents    documents[]
  documenttree documenttree[]

  @@index([createdById], map: "idx_documenthub_created_by_id")
  @@index([projectId], map: "idx_documenthub_project_id")
  @@index([tenantId], map: "idx_documenthub_tenant_id")
  @@index([ticketId], map: "idx_documenthub_ticket_id")
}

model documents {
  id               String             @id
  documentHubId    String             @db.Uuid
  title            String
  content          Json
  createdById      String
  createdAt        DateTime?          @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?          @default(now()) @db.Timestamp(6)
  tenantId         String
  document_history document_history[]
  document_hub     document_hub       @relation(fields: [documentHubId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documents_hub")
  tenants          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documents_tenant")
  documenttree     documenttree?
}

model documenttree {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String
  documentHubId      String           @db.Uuid
  title              String
  type               DocumentNodeType
  parentId           String?          @db.Uuid
  documentId         String?          @unique(map: "documenttree_documentid_key")
  position           Int              @default(0)
  createdById        String
  createdAt          DateTime?        @default(now()) @db.Timestamp(6)
  users              User             @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenttree_createdby")
  documents          documents?       @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenttree_document")
  document_hub       document_hub     @relation(fields: [documentHubId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenttree_documenthub")
  documenttree       documenttree?    @relation("documenttreeTodocumenttree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenttree_parent")
  other_documenttree documenttree[]   @relation("documenttreeTodocumenttree")
  tenants            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documenttree_tenant")
}

model employees {
