  end_time                            DateTime  @db.Timestamptz(6)
  location                            String?
  user_id                             String
  updated_by                          String?
  created_at                          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime? @default(now()) @db.Timestamptz(6)
  attendees                           Json?
  calendar_name                       String?   @db.VarChar(255)
  exdate                              Json?
  is_all_day                          Boolean   @default(false)
  is_recurring                        Boolean   @default(false)
  meeting_link                        String?   @db.VarChar(255)
  rrule                               String?
  source_type                         String?   @db.VarChar(100)
  tenant_id                           String
  users_zoho_events_updated_byTousers User?     @relation("zoho_events_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_zoho_events_updated_by")
  users_zoho_events_user_idTousers    User      @relation("zoho_events_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_zoho_events_user")

  @@unique([event_id, user_id], map: "zoho_events_event_user_unique")
  @@index([calendar_id], map: "idx_zoho_events_calendar_id")
  @@index([start_time], map: "idx_zoho_events_start_time")
  @@index([user_id], map: "idx_zoho_events_user_id")
}

