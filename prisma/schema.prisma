model Invoice {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  invoiceNumber      String              @unique @map("invoice_number")
  customerId         String              @map("customer_id")
  customerSnapshot   Json?               @map("customer_snapshot")
  invoiceDate        DateTime            @map("invoice_date") @db.Timestamp(6)
  dueDate            DateTime            @map("due_date") @db.Timestamp(6)
  invoiceType        InvoiceType         @default(STANDARD) @map("invoice_type")
  currency           String
  recurringFrequency RecurringFrequency? @map("recurring_frequency")
  taxInclusive       Boolean             @default(false) @map("tax_inclusive")
  discount           Decimal             @default(0) @map("discount_total") @db.Decimal(15, 2)
  subtotal           Decimal             @db.Decimal(15, 2)
  taxTotal           Decimal             @map("tax_total") @db.Decimal(15, 2)
  total              Decimal             @map("grand_total") @db.Decimal(15, 2)
  paidAmount         Decimal             @default(0) @map("paid_amount") @db.Decimal(15, 2)
  balanceDue         Decimal             @map("balance_due") @db.Decimal(15, 2)
  notes              String?
  terms              String?
  createdBy          String              @map("created_by")
  updatedBy          String?             @map("updated_by")
  createdByUser      User                @relation("InvoiceCreator", fields: [createdBy], references: [id])
  updatedByUser      User?               @relation("InvoiceUpdater", fields: [updatedBy], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  settingsProfileId  String?             @map("settings_profile_id")
  sentAt             DateTime?           @map("sent_at") @db.Timestamp(6)
  paidAt             DateTime?           @map("paid_at") @db.Timestamp(6)
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamp(6)
  pdfUrl             String?             @map("pdf_url")
  status             InvoiceStatus       @default(DRAFT)
  description        String?
  firstPaymentDate   DateTime?           @map("first_payment_date") @db.Timestamp(6)
  lastPaymentDate    DateTime?           @map("last_payment_date") @db.Timestamp(6)
  fullyPaidDate      DateTime?           @map("fully_paid_date") @db.Timestamp(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamp(6)
  deletedBy          String?             @map("deleted_by")
  deletedByUser      User?               @relation("InvoiceDeleter", fields: [deletedBy], references: [id])
  project_id         String?
  template_id        String?             @db.Uuid
  metadata           Json?
  invoice_templates  invoice_templates?  @relation(fields: [template_id], references: [id], onUpdate: NoAction, map: "fk_invoices_template")
  
  customer        Customer         @relation(fields: [customerId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settingsProfile SettingsProfile? @relation(fields: [settingsProfileId], references: [id])
  items           InvoiceItem[]
  payments        InvoicePayment[]
  project         Project?         @relation(fields: [project_id], references: [id])

  @@index([customerId], map: "idx_invoices_customer_id")
  @@index([firstPaymentDate], map: "idx_invoices_first_payment_date")
  @@index([lastPaymentDate], map: "idx_invoices_last_payment_date")
  @@index([status], map: "idx_invoices_status")
  @@index([template_id], map: "idx_invoices_template_id")
  @@map("invoices")
}

