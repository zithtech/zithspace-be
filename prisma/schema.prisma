generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Tenant {
  id                      String                              @id @default(uuid())
  name                    String
  subdomain               String                              @unique
  planType                String                              @default("basic") @map("plan_type")
  maxUsers                Int                                 @default(10) @map("max_users")
  isActive                Boolean                             @default(true) @map("is_active")
  settings                Json?                               @default("{}")
  createdAt               DateTime                            @default(now()) @map("created_at")
  updatedAt               DateTime                            @updatedAt @map("updated_at")
  is_trial                Boolean?                            @default(false)
  trial_ends_at           DateTime?                           @db.Timestamptz(6)
  EmployerManagement      EmployerManagement[]
  attendance              Attendance[]
  attendanceBreaks        AttendanceBreak[]
  bankFiles               BankFile[]
  channels                Channel[]
  ClientProject           ClientProject[]
  Client                  Client[]
  clientsV2               ClientV2[]
  holidays                CompanyGovernmentHoliday[]
  customers               Customer[]
  deal_activities         deal_activities[]
  deal_communications     deal_communications[]
  deal_files              deal_files[]
  deal_payment_schedules  deal_payment_schedules[]
  deal_tasks              deal_tasks[]
  deals                   deals[]
  departments             Department[]
  dropdownOptions         DropdownOption[]
  employeeExits           EmployeeExit[]
  salaryAssignments       EmployeeSalaryAssignment[]
  employmentTypes         EmploymentType[]
  exitTypes               ExitType[]
  fixedHolidays           FixedHoliday[]
  generalSettings         GeneralSetting[]
  grades                  Grade[]
  payments                InvoicePayment[]
  invoiceSettings         InvoiceSetting[]
  invoiceTemplates        InvoiceTemplate[]
  invoices                Invoice[]
  leaveAdjustments        LeaveAdjustment[]
  leaveOriginStructures   LeaveOriginStructure[]
  leaveTypes              LeaveType[]
  leaves                  Leave[]
  mail_accounts           mail_accounts[]
  mail_attachments        mail_attachments[]
  mail_messages           mail_messages[]
  mail_sync_logs          mail_sync_logs[]
  mail_threads            mail_threads[]
  meetings                Meeting[]
  originLeaveTypes        OriginLeaveType[]
  paymentSettings         PaymentSetting[]
  payslipRecords          PayslipRecord[]
  positions               Position[]
  projects                Project[]
  reasonForExits          ReasonForExit[]
  recruitmentClients      RecruitmentClientBasicInformation[]
  releasePlans            ReleasePlan[]
  repositories            Repository[]
  roles                   Role[]
  salaryAdjustments       SalaryAdjustment[]
  salary_approval_logs    SalaryApprovalLog[]
  salaryApprovalWorkflows SalaryApprovalWorkflow[]
  salaryPayouts           SalaryPayout[]
  salaryStructures        SalaryStructure[]
  settingsProfiles        SettingsProfile[]
  shifts                  Shift[]
  squads                  Squad[]
  squadMembers            SquadMember[]
  statusUpdates           StatusUpdate[]
  subDepartments          SubDepartment[]
  ticketActivityLog       TicketActivityLog[]
  ticketAttachments       TicketAttachment[]
  ticketComments          TicketComment[]
  ticketRelatedLinks      TicketRelatedLink[]
  ticketWorkflowSteps     TicketWorkflowStep[]
  tickets                 Ticket[]
  timeTrackingEntries     TimeTrackingEntry[]
  timeTrackingLogs        TimeTrackingLog[]
  transactions            Transaction[]
  user_roles              UserRole[]
  users                   User[]
  escalationCategories      EscalationCategory[]
  escalationPriorities      EscalationPriority[]
  escalationStatuses        EscalationStatus[]
  escalations               Escalation[]
  companyLocations        CompanyLocation[] 
  openings                OpeningManagement[]
  buckets                 Bucket[]
  bucketMembers           BucketMember[]
  documentHubs            DocumentHub[]
  shortcuts               Shortcut[]
  sprintCompletionLogs    SprintCompletionLog[]

  @@map("tenants")
}

model User {
  id                                                       String                              @id @default(uuid())
  tenantId                                                 String                              @map("tenant_id")
  name                                                     String
  workEmail                                                String                              @map("work_email")
  personalEmail                                            String                              @map("personal_email")
  phone                                                    String
  passwordHash                                             String                              @map("password_hash")
  role                                                     String                              @default("user")
  reportsToId                                              String?                             @map("reports_to_id")
  dateOfBirth                                              DateTime?                           @map("date_of_birth")
  workDays                                                 Int[]                               @default([1, 2, 3, 4, 5]) @map("work_days")
  assignedShiftId                                          String?                             @map("assigned_shift_id")
  shiftAssignedById                                        String?                             @map("shift_assigned_by_id")
  shiftAssignedDate                                        DateTime?                           @map("shift_assigned_date")
  isActive                                                 Boolean                             @default(true) @map("is_active")
  lastLoginAt                                              DateTime?                           @map("last_login_at")
  createdAt                                                DateTime                            @default(now()) @map("created_at")
  updatedAt                                                DateTime                            @updatedAt @map("updated_at")
  department                                               String?
  company_id                                               Int?
  zoho_access_token                                        String?                             @db.VarChar
  zoho_refresh_token                                       String?                             @db.VarChar
  zoho_token_expiry                                        DateTime?                           @db.Timestamptz(6)
  zoho_calendar_id                                         String?                             @db.VarChar
  positionId                                               String?                             @map("position_id")
  zoho_last_sync                                           DateTime?                           @db.Timestamptz(6)
  employeeId                                               String?                             @map("employee_id") @db.Uuid
  EmployerManagementCreated                              EmployerManagement[]                @relation("EmployerManagementCreatedBy")
  EmployerManagementUpdated                              EmployerManagement[]                @relation("EmployerManagementUpdatedBy")
  assigned_deal_users                                      assigned_deal_users[]
  enteredAttendance                                        Attendance[]                        @relation("AttendanceEnteredBy")
  attendance                                               Attendance[]
  bankFilesCreated                                         BankFile[]                          @relation("BankFileCreator")
  bankFilesSent                                            BankFile[]                          @relation("BankFileSender")
  channelMemberships                                       ChannelMember[]
  channelMessages                                          ChannelMessage[]
  createdChannels                                          Channel[]                           @relation("ChannelCreator")
  createdClients                                           Client[]                            @relation("ClientCreator")
  createdHolidays                                          CompanyGovernmentHoliday[]          @relation("CompanyGovernmentHolidayCreator")
  updatedHolidays                                          CompanyGovernmentHoliday[]          @relation("CompanyGovernmentHolidayUpdater")
  createdDepartments                                       Department[]                        @relation("DepartmentCreator")
  managedDepartments                                       Department[]                        @relation("DepartmentHead")
  updatedDepartments                                       Department[]                        @relation("DepartmentUpdater")
  createdDocuments                                         Document[]                          @relation("DocumentCreator")
  deletedDocuments                                         Document[]                          @relation("DocumentDeleter")
  createdDocumentTrees                                     DocumentTree[]                      @relation("DocumentTreeCreator")
  emailLogs                                                EmailLog[]                          @relation("EmailLogSender")
  createdEmploymentTypes                                   EmploymentType[]                    @relation("EmploymentTypeCreator")
  updatedEmploymentTypes                                   EmploymentType[]                    @relation("EmploymentTypeUpdater")
  createdExitTypes                                         ExitType[]                          @relation("ExitTypeCreator")
  updatedExitTypes                                         ExitType[]                          @relation("ExitTypeUpdater")
  createdFixedHolidays                                     FixedHoliday[]                      @relation("FixedHolidayCreator")
  updatedFixedHolidays                                     FixedHoliday[]                      @relation("FixedHolidayUpdater")
  createdGrades                                            Grade[]                             @relation("GradeCreator")
  updatedGrades                                            Grade[]                             @relation("GradeUpdater")
  createdInvoiceTemplates                                  InvoiceTemplate[]                   @relation("InvoiceTemplateCreator")
  createdInvoices                                          Invoice[]                           @relation("InvoiceCreatedBy")
  updatedInvoices                                          Invoice[]                           @relation("InvoiceUpdatedBy")
  managedJobRequisitions                                   JobRequisition[]                    @relation("JobRequisitionAccountManager")
  createdJobRequisitions                                   JobRequisition[]                    @relation("JobRequisitionCreator")
  deliveryJobRequisitions                                  JobRequisition[]                    @relation("JobRequisitionDeliveryManager")
  approvedAdjustments                                      LeaveAdjustment[]                   @relation("LeaveAdjustmentApprover")
  createdLeaveAdjustments                                  LeaveAdjustment[]                   @relation("LeaveAdjustmentCreator")
  updatedLeaveAdjustments                                  LeaveAdjustment[]                   @relation("LeaveAdjustmentUpdater")
  leaveAdjustments                                         LeaveAdjustment[]                   @relation("UserLeaveAdjustments")
  createdLeaveOriginStructures                             LeaveOriginStructure[]              @relation("LeaveOriginStructureCreator")
  updatedLeaveOriginStructures                             LeaveOriginStructure[]              @relation("LeaveOriginStructureUpdater")
  leaveRequests                                            LeaveRequest[]                      @relation("LeaveRequestApprover")
  createdLeaveTypes                                        LeaveType[]                         @relation("LeaveTypeCreator")
  updatedLeaveTypes                                        LeaveType[]                         @relation("LeaveTypeUpdater")
  approvedLeaves                                           Leave[]                             @relation("LeaveApprover")
  leaves                                                   Leave[]                             @relation("UserLeaves")
  mail_accounts_mail_accounts_created_by_idTousers         mail_accounts[]                     @relation("mail_accounts_created_by_idTousers")
  mail_accounts_mail_accounts_updated_by_idTousers         mail_accounts[]                     @relation("mail_accounts_updated_by_idTousers")
  mail_accounts_mail_accounts_user_idTousers               mail_accounts[]                     @relation("mail_accounts_user_idTousers")
  mail_attachments_mail_attachments_created_by_idTousers   mail_attachments[]                  @relation("mail_attachments_created_by_idTousers")
  mail_attachments_mail_attachments_updated_by_idTousers   mail_attachments[]                  @relation("mail_attachments_updated_by_idTousers")
  mail_messages_mail_messages_created_by_idTousers         mail_messages[]                     @relation("mail_messages_created_by_idTousers")
  mail_messages_mail_messages_updated_by_idTousers         mail_messages[]                     @relation("mail_messages_updated_by_idTousers")
  mail_sync_logs_mail_sync_logs_created_by_idTousers       mail_sync_logs[]                    @relation("mail_sync_logs_created_by_idTousers")
  mail_sync_logs_mail_sync_logs_updated_by_idTousers       mail_sync_logs[]                    @relation("mail_sync_logs_updated_by_idTousers")
  mail_threads_mail_threads_created_by_idTousers           mail_threads[]                      @relation("mail_threads_created_by_idTousers")
  mail_threads_mail_threads_updated_by_idTousers           mail_threads[]                      @relation("mail_threads_updated_by_idTousers")
  meetingParticipations                                    MeetingParticipant[]
  createdMeetings                                          Meeting[]                           @relation("MeetingCreator")
  createdOriginLeaveTypes                                  OriginLeaveType[]                   @relation("OriginLeaveTypeCreator")
  updatedOriginLeaveTypes                                  OriginLeaveType[]                   @relation("OriginLeaveTypeUpdater")
  payslipsCreated                                          PayslipRecord[]                     @relation("PayslipCreator")
  createdPositions                                         Position[]                          @relation("PositionCreator")
  updatedPositions                                         Position[]                          @relation("PositionUpdater")
  projectMemberships                                       ProjectMember[]
  createdProjects                                          Project[]                           @relation("ProjectCreator")
  managedProjects                                          Project[]                           @relation("ProjectManager")
  createdReasonsForExit                                    ReasonForExit[]                     @relation("ReasonForExitCreator")
  updatedReasonsForExit                                    ReasonForExit[]                     @relation("ReasonForExitUpdater")
  createdRecruitmentActions                                RecruitmentAction[]                 @relation("RecruitmentActionCreator")
  updatedRecruitmentActions                                RecruitmentAction[]                 @relation("RecruitmentActionUpdater")
  createdRecruitmentClients                                RecruitmentClientBasicInformation[] @relation("CreatedRecruitmentClient")
  updatedRecruitmentClients                                RecruitmentClientBasicInformation[] @relation("UpdatedRecruitmentClient")
  createdBusinessDetails                                   RecruitmentClientBusinessDetails[]  @relation("CreatedBusinessDetails")
  updatedBusinessDetails                                   RecruitmentClientBusinessDetails[]  @relation("UpdatedBusinessDetails")
  createdRecruitmentStatuses                               RecruitmentStatus[]                 @relation("RecruitmentStatusCreator")
  updatedRecruitmentStatuses                               RecruitmentStatus[]                 @relation("RecruitmentStatusUpdater")
  refreshTokens                                            RefreshToken[]
  reimbursements                                           Reimbursement[]                     @relation("ReimbursementCreator")
  createdReleasePlans                                      ReleasePlan[]                       @relation("ReleasePlanCreator")
  approvalLogs                                             SalaryApprovalLog[]                 @relation("ApprovalLogPerformer")
  stepFallbackUser                                         SalaryApprovalStep[]                @relation("StepFallbackUser")
  stepSpecificUser                                         SalaryApprovalStep[]                @relation("StepSpecificUser")
  approvedPayouts                                          SalaryPayout[]                      @relation("SalaryApprover")
  createdSquads                                            Squad[]                             @relation("SquadCreator")
  updatedSquads                                            Squad[]                             @relation("SquadUpdater")
  createdSquadMembers                                      SquadMember[]                       @relation("SquadMemberCreator")
  updatedSquadMembers                                      SquadMember[]                       @relation("SquadMemberUpdater")
  squadMemberships                                         SquadMember[]                       @relation("SquadMemberUser")
  statusUpdates                                            StatusUpdate[]                      @relation("UserStatusUpdates")
  createdSubDepartments                                    SubDepartment[]                     @relation("SubDepartmentCreator")
  updatedSubDepartments                                    SubDepartment[]                     @relation("SubDepartmentUpdater")
  performedActivityLog                                     TicketActivityLog[]
  ticketAttachments                                        TicketAttachment[]
  ticketComments                                           TicketComment[]
  addedRelatedLinks                                        TicketRelatedLink[]
  assignedTickets                                          Ticket[]                            @relation("TicketAssignee")
  createdTickets                                           Ticket[]                            @relation("TicketCreator")
  reportToTickets                                          Ticket[]                            @relation("TicketReportTo")
  timeTrackingEntries                                      TimeTrackingEntry[]
  approvedTimesheets                                       Timesheet[]                         @relation("TimesheetApprover")
  createdTimesheets                                        Timesheet[]                         @relation("TimesheetUser")
  transactions                                             Transaction[]
  userRoles                                                UserRole[]
  assignedShift                                            Shift?                              @relation("UserShift", fields: [assignedShiftId], references: [id])
  employee                                                 Employee?                           @relation(fields: [employeeId], references: [id])
  position                                                 Position?                           @relation("UserPosition", fields: [positionId], references: [id])
  reportsTo                                                User?                               @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates                                             User[]                              @relation("UserHierarchy")
  shiftAssignedBy                                          User?                               @relation("ShiftAssigner", fields: [shiftAssignedById], references: [id])
  assignedShifts                                           User[]                              @relation("ShiftAssigner")
  tenant                                                   Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoho_events_zoho_events_updated_byTousers                zoho_events[]                       @relation("zoho_events_updated_byTousers")
  zoho_events_zoho_events_user_idTousers                   zoho_events[]                       @relation("zoho_events_user_idTousers")
  createdEscalations                                       Escalation[]                        @relation("EscalationCreator")
  escalationParticipations                                 EscalationMember[]
  createdCompanyLocations CompanyLocation[] @relation("CompanyLocationCreatedBy")
  updatedCompanyLocations CompanyLocation[] @relation("CompanyLocationUpdatedBy")
  openingsCreated        OpeningManagement[] @relation("OpeningCreatedBy")
  openingsUpdated        OpeningManagement[] @relation("OpeningUpdatedBy")
  createdBuckets                                           Bucket[]                            @relation("BucketCreator")
  bucketMemberships                                       BucketMember[]
  createdDocumentHubs                                     DocumentHub[]                       @relation("DocumentHubCreator")
  deletedDocumentHubs                                     DocumentHub[]                       @relation("DocumentHubDeleter")
  createdShortcuts                                       Shortcut[]                          @relation("ShortcutCreator")
  updatedShortcuts                                       Shortcut[]                          @relation("ShortcutUpdater")
  sprintCompletionLogs                                   SprintCompletionLog[]               @relation("SprintCompletionPerformer")
  deletedInvoices                                          Invoice[]                           @relation("InvoiceDeletedBy")
  createdInvoicePayments                                   InvoicePayment[]                    @relation("InvoicePaymentCreatedBy")
  updatedInvoicePayments                                   InvoicePayment[]                    @relation("InvoicePaymentUpdatedBy")
  deletedTickets                                           Ticket[]                            @relation("TicketDeletedBy")

  @@unique([tenantId, workEmail])
  @@unique([tenantId, personalEmail])
  @@unique([tenantId, phone])
  @@map("users")
}

model Grade {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  code        String
  name        String
  levelOrder  Int        @map("level_order")
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdById String     @map("created_by_id")
  updatedById String?    @map("updated_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  codes       String?
  createdBy   User       @relation("GradeCreator", fields: [createdById], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy   User?      @relation("GradeUpdater", fields: [updatedById], references: [id])
  positions   Position[]

  @@unique([tenantId, code])
  @@map("grades")
}

model EmploymentType {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  code        String
  createdBy   User     @relation("EmploymentTypeCreator", fields: [createdById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("EmploymentTypeUpdater", fields: [updatedById], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("employment_types")
}

model Department {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  code           String
  name           String
  employmentType String?         @map("employment_type")
  description    String?
  headId         String?         @map("head_id")
  isActive       Boolean         @default(true) @map("is_active")
  createdById    String          @map("created_by_id")
  updatedById    String?         @map("updated_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      User            @relation("DepartmentCreator", fields: [createdById], references: [id])
  head           User?           @relation("DepartmentHead", fields: [headId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy      User?           @relation("DepartmentUpdater", fields: [updatedById], references: [id])
  positions      Position[]
  subDepartments SubDepartment[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("departments")
}

model SubDepartment {
  id                 String     @id @default(uuid())
  tenantId           String     @map("tenant_id")
  parentDepartmentId String     @map("parent_department_id")
  code               String
  name               String
  description        String?
  isActive           Boolean    @default(true) @map("is_active")
  createdById        String     @map("created_by_id")
  updatedById        String?    @map("updated_by_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  positions          Position[]
  createdBy          User       @relation("SubDepartmentCreator", fields: [createdById], references: [id])
  parentDepartment   Department @relation(fields: [parentDepartmentId], references: [id], onDelete: Cascade)
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy          User?      @relation("SubDepartmentUpdater", fields: [updatedById], references: [id])

  @@unique([tenantId, code])
  @@map("sub_departments")
}

model Position {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  code                String
  title               String
  departmentId        String               @map("department_id")
  subDepartmentId     String?              @map("sub_department_id")
  gradeId             String               @map("grade_id")
  description         String?
  isActive            Boolean              @default(true) @map("is_active")
  createdById         String               @map("created_by_id")
  updatedById         String?              @map("updated_by_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  employeeWorkDetails EmployeeWorkDetail[]
  createdBy           User                 @relation("PositionCreator", fields: [createdById], references: [id])
  department          Department           @relation(fields: [departmentId], references: [id])
  grade               Grade                @relation(fields: [gradeId], references: [id])
  subDepartment       SubDepartment?       @relation(fields: [subDepartmentId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy           User?                @relation("PositionUpdater", fields: [updatedById], references: [id])
  users               User[]               @relation("UserPosition")

  @@unique([tenantId, code])
  @@map("positions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id                  String              @id @default(uuid())
  tenantId            String              @map("tenant_id")
  name                String
  code                String?             @unique
  description         String
  status              String              @default("active")
  startDate           DateTime            @map("start_date")
  endDate             DateTime?           @map("end_date")
  projectManagerId    String              @map("project_manager_id")
  repositories        Json?               @default("[]")
  workflowTemplate    String[]            @map("workflow_template")
  defaultPriority     String              @default("medium") @map("default_priority")
  totalTickets        Int                 @default(0) @map("total_tickets")
  completedTickets    Int                 @default(0) @map("completed_tickets")
  inProgressTickets   Int                 @default(0) @map("in_progress_tickets")
  createdById         String              @map("created_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  clientProjects      ClientProject[]
  invoices            Invoice[]
  members             ProjectMember[]
  createdBy           User                @relation("ProjectCreator", fields: [createdById], references: [id])
  projectManager      User                @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasePlans        ReleasePlan[]
  tickets             Ticket[]
  timeTrackingEntries TimeTrackingEntry[]
  work_entry          work_entry[]
  escalations         Escalation[]
  buckets             Bucket[]
  documentHubs        DocumentHub[]

  @@unique([tenantId, code])
  @@map("projects")
}

model ClientProject {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  clientId    String   @map("client_id")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  billingType String?  @map("billing_type")
  budget      Decimal? @db.Decimal(15, 2)
  budget_type String?  @db.VarChar(50)
  client      ClientV2 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([clientId, projectId])
  @@map("client_projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Ticket {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  projectId           String               @map("project_id")
  releasePlanId       String?              @map("release_plan_id")
  title               String
  description         String?
  ticketNumber        String               @map("ticket_number")
  status              String               @default("not_started")
  priority            String               @default("Medium (P2)")
  type                String               @default("Task")
  platform            String               @default("Development")
  stack               String?
  taskLevel           String               @default("Medium") @map("task_level")
  storyPoint          Int                  @default(1) @map("story_point")
  estimateHours       Decimal              @default(0) @map("estimate_hours") @db.Decimal(5, 2)
  assigneeId          String?              @map("assignee_id")
  reportToId          String?              @map("report_to_id")
  createdById         String               @map("created_by_id")
  parentTickets       String[]             @default([]) @map("parent_tickets")
  parentTicketNotes   String?              @map("parent_ticket_notes")
  currentWorkflowStep String               @default("Scope Document") @map("current_workflow_step")
  startDate           DateTime?            @map("start_date")
  endDate             DateTime?            @map("end_date")
  dueDate             DateTime?            @map("due_date")
  completedAt         DateTime?            @map("completed_at")
  tags                String[]             @default([])
  metadata            Json?                @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  epicId              String?              @map("epic_id")
  parentId            String?              @map("parent_id")
  rank                String?
  demoPlanId          String?              @map("demo_plan_id")
  sprintPlanId        String?              @map("sprint_plan_id")
  isArchived          Boolean              @default(false) @map("is_archived")
  archivedAt          DateTime?            @map("archived_at")
  archivedById        String?              @map("archived_by_id") @db.VarChar(255)
  bucketId            String?              @map("bucket_id") @db.VarChar(255)
  isDeleted           Boolean?             @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamp(6)
  deletedById         String?              @map("deleted_by_id") @db.VarChar(255)
  activityLog         TicketActivityLog[]
  attachments         TicketAttachment[]
  branches            TicketBranch[]
  comments            TicketComment[]
