model mail_accounts {
  id                                       String               @id
  provider                                 mail_provider
  email                                    String
  tenant_id                                String
  user_id                                  String
  display_name                             String?
  access_token                             String?
  refresh_token                            String?
  expires_at                               DateTime?            @db.Timestamptz(6)
  use_shared_tokens                        Boolean?             @default(true)
  sync_cursor                              String?
  last_synced_at                           DateTime?            @db.Timestamptz(6)
  is_active                                Boolean?             @default(true)
  created_by_id                            String?
  updated_by_id                            String?
  created_at                               DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime?            @default(now()) @db.Timestamptz(6)
  calendar_integrations                    CalendarIntegration?
  users_mail_accounts_created_by_idTousers User?                @relation("mail_accounts_created_by_idTousers", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mail_accounts_created_by")
  tenants                                  Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mail_accounts_tenant")
  users_mail_accounts_updated_by_idTousers User?                @relation("mail_accounts_updated_by_idTousers", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mail_accounts_updated_by")
  users_mail_accounts_user_idTousers       User                 @relation("mail_accounts_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mail_accounts_user")
  mail_messages                            mail_messages[]
  mail_sync_logs                           mail_sync_logs[]
  mail_threads                             mail_threads[]

  @@unique([provider, email, tenant_id], map: "mail_accounts_provider_email_tenant_unique")
  @@index([tenant_id], map: "idx_mail_accounts_tenant_id")
  @@index([user_id], map: "idx_mail_accounts_user_id")
}

model mail_attachments {
  id                                          String        @id
  message_id                                  String
  tenant_id                                   String
  file_name                                   String
  mime_type                                   String
  size                                        Int
  storage_key                                 String
  download_url                                String?
