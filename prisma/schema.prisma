model invoice_items {
  id                                    String   @id
  tenant_id                             String
  invoice_id                            String
  item                                  String
  description                           String?
  qty                                   Int      @default(1)
  price                                 Decimal  @default(0) @db.Decimal(15, 2)
  tax                                   Decimal  @default(0) @db.Decimal(15, 2)
  created_by                            String
  updated_by                            String?
  created_at                            DateTime @default(now()) @db.Timestamp(6)
  updated_at                            DateTime @default(now()) @db.Timestamp(6)
  users_invoice_items_created_byTousers User     @relation("invoice_items_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_item_created_by")
  invoices                              invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_item_invoice")
  tenants                               Tenant   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_item_tenant")
  users_invoice_items_updated_byTousers User?    @relation("invoice_items_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoice_item_updated_by")

