generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  subdomain             String                 @unique
  planType              String                 @default("basic") @map("plan_type")
  maxUsers              Int                    @default(10) @map("max_users")
  isActive              Boolean                @default(true) @map("is_active")
  settings              Json?                  @default("{}")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  attendance            Attendance[]
  attendanceBreaks      AttendanceBreak[]
  buckets               Bucket[]
  customers             Customer[]
  dropdownOptions       DropdownOption[]
  leaves                Leave[]
  leaveTypes            LeaveType[]
  leaveAdjustments      LeaveAdjustment[]
  leaveOriginStructures LeaveOriginStructure[]
  originLeaveTypes      OriginLeaveType[]
  fixedHolidays         FixedHoliday[]
  employmentTypes       EmploymentType[]
  grades                Grade[]
  departments           Department[]
  subDepartments        SubDepartment[]
  positions             Position[]

  salaryComponents SalaryComponent[]
  companies        Company[]
  holidays         CompanyGovernmentHoliday[]
  projects         Project[]
  releasePlans     ReleasePlan[]

  reimbursementCategories ReimbursementCategory[]
  emailLogs               EmailLog[]

  employees         Employee[]
  employeeAddresses EmployeeAddress[]
  employeeSetting   EmployeeSetting[]

  calendarIntegrations CalendarIntegration[]
  calendarEvents       CalendarEvent[]

  squads       Squad[]
  squadMembers SquadMember[]
  candidates CandidateDetails[]

  shifts Shift[]

  sprintCompletionLogs SprintCompletionLog[]
  statusUpdates        StatusUpdate[]
  jobRequisitions      JobRequisition[]
  ticketActivityLog    TicketActivityLog[]
  ticketAttachments    TicketAttachment[]
  ticketComments       TicketComment[]
  ticketRelatedLinks   TicketRelatedLink[]
  ticketWorkflowSteps  TicketWorkflowStep[]
  tickets              Ticket[]
  transactions         Transaction[]
  users                User[]
  generalSettings      GeneralSetting[]
  invoiceSettings      InvoiceSetting[]
  paymentSettings      PaymentSetting[]
  settingsProfiles     SettingsProfile[]
  invoices             Invoice[]
  items                InvoiceItem[]
  payments             InvoicePayment[]
  repositories         Repository[] // Relation to Code Repositories
  documenthub          DocumentHub[]
  documents            Document[]
  documenttree         DocumentTree[]
  documentHistory      DocumentHistory[]
  exceptions           CalendarEventException[]
  // ZithTech Calls Relations
  channels             Channel[]
  meetings             Meeting[]
  Client               Client[]

  // Client V2 Relations
  clientsV2                   ClientV2[]
  clientContactsV2            ClientContactV2[]
  clientDocumentsV2           ClientDocumentV2[]
  employeeClientAllocationsV2 EmployeeClientAllocationV2[]
  ClientProject               ClientProject[]

  // RBAC
  roles Role[]
  
  // Time Tracking
  timeTrackingEntries TimeTrackingEntry[]

  @@map("tenants")
}

model User {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  name              String
  workEmail         String    @map("work_email")
  personalEmail     String    @map("personal_email")
  phone             String
  passwordHash      String    @map("password_hash")
  role              String    @default("user")
  positionId        String?   @map("position_id")
  position          Position? @relation("UserPosition", fields: [positionId], references: [id])
  reportsToId       String?   @map("reports_to_id")
  dateOfBirth       DateTime? @map("date_of_birth")
  workDays          Int[]     @default([1, 2, 3, 4, 5]) @map("work_days")
  assignedShiftId   String?   @map("assigned_shift_id")
  shiftAssignedById String?   @map("shift_assigned_by_id")
  shiftAssignedDate DateTime? @map("shift_assigned_date")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdSalaryComponents SalaryComponent[] @relation("SalaryComponentCreator")
  updatedSalaryComponents SalaryComponent[] @relation("SalaryComponentUpdater")
  createdCompanies        Company[]         @relation("CompanyCreator")
  updatedCompanies        Company[]         @relation("CompanyUpdater")
  createdCustomers        Customer[]        @relation("CustomerCreatedBy")
  updatedCustomers        Customer[]        @relation("CustomerUpdatedBy")

  createdSquads Squad[] @relation("SquadCreator")
  updatedSquads Squad[] @relation("SquadUpdater")

  squadMemberships SquadMember[] @relation("SquadMemberUser")

  createdSquadMembers SquadMember[] @relation("SquadMemberCreator")
  updatedSquadMembers SquadMember[] @relation("SquadMemberUpdater")

  enteredAttendance            Attendance[]               @relation("AttendanceEnteredBy")
  attendance                   Attendance[]
  createdClients               Client[]                   @relation("ClientCreator")
  approvedLeaves               Leave[]                    @relation("LeaveApprover")
  createdLeaveTypes            LeaveType[]                @relation("LeaveTypeCreator")
  updatedLeaveTypes            LeaveType[]                @relation("LeaveTypeUpdater")
  leaves                       Leave[]                    @relation("UserLeaves")
  leaveAdjustments             LeaveAdjustment[]          @relation("UserLeaveAdjustments")
  approvedAdjustments          LeaveAdjustment[]          @relation("LeaveAdjustmentApprover")
  createdLeaveAdjustments      LeaveAdjustment[]          @relation("LeaveAdjustmentCreator")
  updatedLeaveAdjustments      LeaveAdjustment[]          @relation("LeaveAdjustmentUpdater")
  createdLeaveOriginStructures LeaveOriginStructure[]     @relation("LeaveOriginStructureCreator")
  updatedLeaveOriginStructures LeaveOriginStructure[]     @relation("LeaveOriginStructureUpdater")
  createdOriginLeaveTypes      OriginLeaveType[]          @relation("OriginLeaveTypeCreator")
  updatedOriginLeaveTypes      OriginLeaveType[]          @relation("OriginLeaveTypeUpdater")
  projectMemberships           ProjectMember[]
  createdProjects              Project[]                  @relation("ProjectCreator")
  managedProjects              Project[]                  @relation("ProjectManager")
  refreshTokens                RefreshToken[]
  createdReleasePlans          ReleasePlan[]              @relation("ReleasePlanCreator")
  statusUpdates                StatusUpdate[]             @relation("UserStatusUpdates")
  performedActivityLog         TicketActivityLog[]
  ticketAttachments            TicketAttachment[]
  ticketComments               TicketComment[]
  addedRelatedLinks            TicketRelatedLink[]
  documenthub                  DocumentHub[]
  documents                    Document[]
  documentHistory              DocumentHistory[]
  documenttree                 DocumentTree[]
  assignedTickets              Ticket[]                   @relation("TicketAssignee")
  createdTickets               Ticket[]                   @relation("TicketCreator")
  reportToTickets              Ticket[]                   @relation("TicketReportTo")
  archivedTickets              Ticket[]                   @relation("TicketArchivedBy")
  deletedTickets               Ticket[]                   @relation("TicketDeletedBy")
  createdRequisitions          JobRequisition[]           @relation("RequisitionCreator")
  managedAccountRequisitions   JobRequisition[]           @relation("RequisitionAccountManager")
  managedDeliveryRequisitions  JobRequisition[]           @relation("RequisitionDeliveryManager")
  assignedRequisitions         JobRequisition[]           @relation("RequisitionRecruiters")
  createdBuckets               Bucket[]                   @relation("BucketCreator")
  bucketMemberships            BucketMember[]
  createdFixedHolidays         FixedHoliday[]             @relation("FixedHolidayCreator")
  updatedFixedHolidays         FixedHoliday[]             @relation("FixedHolidayUpdater")
  createdHolidays              CompanyGovernmentHoliday[] @relation("CompanyGovernmentHolidayCreator")
  updatedHolidays              CompanyGovernmentHoliday[] @relation("CompanyGovernmentHolidayUpdater")
  sprintCompletionLogs         SprintCompletionLog[]
  transactions                 Transaction[]
  assignedShift                Shift?                     @relation("UserShift", fields: [assignedShiftId], references: [id])
  reportsTo                    User?                      @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates                 User[]                     @relation("UserHierarchy")
  shiftAssignedBy              User?                      @relation("ShiftAssigner", fields: [shiftAssignedById], references: [id])
  assignedShifts               User[]                     @relation("ShiftAssigner")
  tenant                       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // ---------------- TIMESHEETS ----------------

  // Owner of timesheets
  timesheets Timesheet[]

  // Approved timesheets
  approvedTimesheets Timesheet[] @relation("TimesheetApprover")

  // Created timesheets
  createdTimesheets Timesheet[] @relation("TimesheetCreator")

  // Updated timesheets
  updatedTimesheets Timesheet[] @relation("TimesheetUpdater")

  // ---------------- TIMESHEET ROWS ----------------

  createdTimesheetRows TimesheetRow[] @relation("TimesheetRowCreator")
  updatedTimesheetRows TimesheetRow[] @relation("TimesheetRowUpdater")

  // ===== Reimbursement Category =====
  createdReimbursementCategories ReimbursementCategory[] @relation("ReimbursementCategoryCreatedBy")
  updatedReimbursementCategories ReimbursementCategory[] @relation("ReimbursementCategoryUpdatedBy")

  // ===== Grade Relations =====
  createdGrades Grade[] @relation("GradeCreator")
  updatedGrades Grade[] @relation("GradeUpdater")

  // ===== Employment Type Relations =====
  createdEmploymentTypes EmploymentType[] @relation("EmploymentTypeCreator")
  updatedEmploymentTypes EmploymentType[] @relation("EmploymentTypeUpdater")

  // ===== Department Relations =====
  managedDepartments    Department[]    @relation("DepartmentHead")
  createdDepartments    Department[]    @relation("DepartmentCreator")
  updatedDepartments    Department[]    @relation("DepartmentUpdater")
  createdSubDepartments SubDepartment[] @relation("SubDepartmentCreator")
  updatedSubDepartments SubDepartment[] @relation("SubDepartmentUpdater")

  // ===== Position Relations =====
  createdPositions Position[] @relation("PositionCreator")
  updatedPositions Position[] @relation("PositionUpdater")

  // ===== Settings Relations =====
  createdGeneralSettings  GeneralSetting[]  @relation("GeneralSettingCreatedBy")
  updatedGeneralSettings  GeneralSetting[]  @relation("GeneralSettingUpdatedBy")
  createdInvoiceSettings  InvoiceSetting[]  @relation("InvoiceSettingCreatedBy")
  updatedInvoiceSettings  InvoiceSetting[]  @relation("InvoiceSettingUpdatedBy")
  createdPaymentSettings  PaymentSetting[]  @relation("PaymentSettingCreatedBy")
  updatedPaymentSettings  PaymentSetting[]  @relation("PaymentSettingUpdatedBy")
  createdSettingsProfiles SettingsProfile[] @relation("SettingsProfileCreatedBy")
  updatedSettingsProfiles SettingsProfile[] @relation("SettingsProfileUpdatedBy")

  // ===== Invoice Relations =====
  createdInvoices             Invoice[]                @relation("InvoiceCreatedBy")
  updatedInvoices             Invoice[]                @relation("InvoiceUpdatedBy")
  deletedInvoices             Invoice[]                @relation("InvoiceDeletedBy")
  createdInvoiceItems         InvoiceItem[]            @relation("InvoiceItemCreatedBy")
  updatedInvoiceItems         InvoiceItem[]            @relation("InvoiceItemUpdatedBy")
  deletedInvoiceItems         InvoiceItem[]            @relation("InvoiceItemDeletedBy")
  createdInvoicePayments      InvoicePayment[]         @relation("InvoicePaymentCreatedBy")
  updatedInvoicePayments      InvoicePayment[]         @relation("InvoicePaymentUpdatedBy")
  sentEmails                  EmailLog[]               @relation("EmailSentBy")
  createdExceptions           CalendarEventException[] @relation("ExceptionCreatedBy")
  updatedExceptions           CalendarEventException[] @relation("ExceptionUpdatedBy")
  exceptions                  CalendarEventException[]
  calendarIntegrations        CalendarIntegration[]
  calendarEvents              CalendarEvent[]
  createdCalendarIntegrations CalendarIntegration[]    @relation("CreatedByUser")
  updatedCalendarIntegrations CalendarIntegration[]    @relation("UpdatedByUser")
  createdCalendarEvents       CalendarEvent[]          @relation("CreatedByUser")
  updatedCalendarEvents       CalendarEvent[]          @relation("UpdatedByUser")

  // ===== Chat & Meeting Relations =====
  createdChannels       Channel[]            @relation("ChannelCreator")
  channelMemberships    ChannelMember[]
  channelMessages       ChannelMessage[]
  createdMeetings       Meeting[]            @relation("MeetingCreator")
  meetingParticipations MeetingParticipant[]

  // Client V2 Relations
  createdClientsV2          ClientV2[]         @relation("ClientV2Creator")
  uploadedClientDocumentsV2 ClientDocumentV2[] @relation("ClientDocumentV2Uploader")

  // ===== RBAC Relations =====
  userRoles UserRole[]
  
  // Time Tracking
  timeTrackingEntries TimeTrackingEntry[]



  @@unique([tenantId, workEmail])
  @@unique([tenantId, personalEmail])
  @@unique([tenantId, phone])
  @@map("users")
}

model ReimbursementCategory {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  code        String  @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?

  maxRequestsPerMonth Int?     @map("max_requests_per_month")
  monthlyLimitAmount  Decimal? @map("monthly_limit_amount") @db.Decimal(12, 2)
  yearlyLimitAmount   Decimal? @map("yearly_limit_amount") @db.Decimal(12, 2)

  allowedRoles String[] @map("allowed_roles")
  approvalFlow Json?    @map("approval_flow")

  attachmentRequired     Boolean  @default(false) @map("attachment_required")
  autoApproveUnderAmount Decimal? @map("auto_approve_under_amount") @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  // Relations
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  createdByUser User   @relation("ReimbursementCategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?  @relation("ReimbursementCategoryUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([tenantId, code])
  @@map("reimbursement_category")
}

model Grade {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  codes       String?
  name        String
  levelOrder  Int      @map("level_order")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User       @relation("GradeCreator", fields: [createdById], references: [id])
  updatedBy User?      @relation("GradeUpdater", fields: [updatedById], references: [id])
  positions Position[]

  @@unique([tenantId, code])
  @@map("grades")
}

model EmploymentType {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("EmploymentTypeCreator", fields: [createdById], references: [id])
  updatedBy User?  @relation("EmploymentTypeUpdater", fields: [updatedById], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("employment_types")
}

model Department {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  code           String
  name           String
  employmentType String?  @map("employment_type")
  description    String?
  headId         String?  @map("head_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String   @map("created_by_id")
  updatedById    String?  @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  head           User?           @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("DepartmentCreator", fields: [createdById], references: [id])
  updatedBy      User?           @relation("DepartmentUpdater", fields: [updatedById], references: [id])
  subDepartments SubDepartment[]
  positions      Position[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("departments")
}

model SubDepartment {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  parentDepartmentId String   @map("parent_department_id")
  code               String
  name               String
  description        String?
  isActive           Boolean  @default(true) @map("is_active")
  createdById        String   @map("created_by_id")
  updatedById        String?  @map("updated_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentDepartment Department @relation(fields: [parentDepartmentId], references: [id], onDelete: Cascade)
  createdBy        User       @relation("SubDepartmentCreator", fields: [createdById], references: [id])
  updatedBy        User?      @relation("SubDepartmentUpdater", fields: [updatedById], references: [id])
  positions        Position[]

  @@unique([tenantId, code])
  @@map("sub_departments")
}

model Position {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  code            String
  title           String
  departmentId    String   @map("department_id")
  subDepartmentId String?  @map("sub_department_id")
  gradeId         String   @map("grade_id")
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String   @map("created_by_id")
  updatedById     String?  @map("updated_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id])
  subDepartment SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  grade         Grade          @relation(fields: [gradeId], references: [id])
  createdBy     User           @relation("PositionCreator", fields: [createdById], references: [id])
  updatedBy     User?          @relation("PositionUpdater", fields: [updatedById], references: [id])
  users         User[]         @relation("UserPosition")

  @@unique([tenantId, code])
  @@map("positions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  name                 String
  code                 String?               @unique
  description          String
  status               String                @default("active")
  startDate            DateTime              @map("start_date")
  endDate              DateTime?             @map("end_date")
  projectManagerId     String                @map("project_manager_id")
  repositories         Json?                 @default("[]")
  workflowTemplate     String[]              @map("workflow_template")
  defaultPriority      String                @default("medium") @map("default_priority")
  totalTickets         Int                   @default(0) @map("total_tickets")
  completedTickets     Int                   @default(0) @map("completed_tickets")
  inProgressTickets    Int                   @default(0) @map("in_progress_tickets")
  createdById          String                @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  members              ProjectMember[]
  buckets              Bucket[]
  createdBy            User                  @relation("ProjectCreator", fields: [createdById], references: [id])
  projectManager       User                  @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasePlans         ReleasePlan[]
  sprintCompletionLogs SprintCompletionLog[]
  tickets              Ticket[]
  workEntries          WorkEntry[]
  documenthub          DocumentHub[]

  // Client V2 Relations
  employeeClientAllocationsV2 EmployeeClientAllocationV2[]
  clientProjects              ClientProject[]
  
  // Time Tracking
  timeTrackingEntries TimeTrackingEntry[]

  @@unique([tenantId, code])
  @@map("projects")
}

model ClientProject {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  clientId    String   @map("client_id")
  projectId   String   @map("project_id")
  billingType String?  @map("billing_type")
  budget      Decimal? @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  ClientV2 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientId, projectId])
  @@map("client_projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Ticket {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  projectId           String    @map("project_id")
  releasePlanId       String?   @map("release_plan_id")
  title               String
  description         String?
  ticketNumber        String    @map("ticket_number")
  status              String    @default("not_started")
  priority            String    @default("Medium (P2)")
  type                String    @default("Task")
  platform            String    @default("Development")
  stack               String?
  taskLevel           String    @default("Medium") @map("task_level")
  storyPoint          Int       @default(1) @map("story_point")
  estimateHours       Decimal   @default(0) @map("estimate_hours") @db.Decimal(5, 2)
  assigneeId          String?   @map("assignee_id")
  reportToId          String?   @map("report_to_id")
  createdById         String    @map("created_by_id")
  parentTickets       String[]  @default([]) @map("parent_tickets")
  parentTicketNotes   String?   @map("parent_ticket_notes")
  currentWorkflowStep String    @default("Scope Document") @map("current_workflow_step")
  startDate           DateTime? @map("start_date")
  endDate             DateTime? @map("end_date")
  dueDate             DateTime? @map("due_date")
  completedAt         DateTime? @map("completed_at")
  tags                String[]  @default([])
  metadata            Json?     @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  epicId              String?   @map("epic_id")
  parentId            String?   @map("parent_id")
  rank                String?
  demoPlanId          String?   @map("demo_plan_id")
  sprintPlanId        String?   @map("sprint_plan_id")
  bucketId            String?   @map("bucket_id")

  // Archive fields
  isArchived   Boolean   @default(false) @map("is_archived")
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id")

  // Soft delete / Trash fields
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  // Relations
  activityLog   TicketActivityLog[]
  attachments   TicketAttachment[]
  comments      TicketComment[]
  relatedLinks  TicketRelatedLink[]
  workflowSteps TicketWorkflowStep[]
  documenthub   DocumentHub[]
  branches      TicketBranch[]
  pullRequests  TicketPullRequest[]
  assignee      User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy     User                 @relation("TicketCreator", fields: [createdById], references: [id])
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasePlan   ReleasePlan?         @relation("TicketReleasePlan", fields: [releasePlanId], references: [id])
  sprintPlan    ReleasePlan?         @relation("TicketSprintPlan", fields: [sprintPlanId], references: [id])
  demoPlan      ReleasePlan?         @relation("TicketDemoPlan", fields: [demoPlanId], references: [id])
  bucket        Bucket?              @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  reportTo      User?                @relation("TicketReportTo", fields: [reportToId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workEntries   WorkEntry[]

  // Hierarchy relations
  epic       Ticket?  @relation("EpicStories", fields: [epicId], references: [id], onDelete: SetNull)
  stories    Ticket[] @relation("EpicStories")
  parent     Ticket?  @relation("ParentSubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  subTasks   Ticket[] @relation("ParentSubTasks")
  archivedBy User?    @relation("TicketArchivedBy", fields: [archivedById], references: [id])
  deletedBy  User?    @relation("TicketDeletedBy", fields: [deletedById], references: [id])
  
  // Time Tracking
  timeTrackingEntries TimeTrackingEntry[]

  @@unique([tenantId, ticketNumber])
  @@index([epicId])
  @@index([parentId])
  @@index([projectId, releasePlanId])
  @@index([projectId, sprintPlanId])
  @@index([projectId, demoPlanId])
  @@index([bucketId])
  @@index([projectId, isArchived])
  @@index([tenantId, isArchived])
  @@index([status, isArchived])
  @@index([tenantId, isDeleted])
  @@index([projectId, isDeleted])
  @@index([isDeleted, deletedAt])
  @@map("tickets")
}

model TicketWorkflowStep {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  ticketId         String    @map("ticket_id")
