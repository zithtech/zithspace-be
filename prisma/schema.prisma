model PayslipField {
  id          Int       @id @default(autoincrement())
  tenantId    String    @map("tenant_id") @db.VarChar(255)

  label       String    @map("label") @db.VarChar(100)
  value       String?   @map("value") @db.Text
  type        FieldType @map("type")
  options     String?   @map("options") @db.Text
  status      Boolean   @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  createdById String?   @map("created_by_id") @db.VarChar(255)
  updatedById String?   @map("updated_by_id") @db.VarChar(255)

 
  createdBy   User?     @relation(name: "PayslipFieldCreator", fields: [createdById], references: [id])
  updatedBy   User?     @relation(name: "PayslipFieldUpdater", fields: [updatedById], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, label])
  @@map("payslip_fields")
}

enum FieldType {
  text
  number
  date
  dropdown
  
  @@map("field_type")
}


