generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                          String                        @id @default(uuid())
  name                        String
  subdomain                   String                        @unique
  planType                    String                        @default("basic") @map("plan_type")
  maxUsers                    Int                           @default(10) @map("max_users")
  isActive                    Boolean                       @default(true) @map("is_active")
  settings                    Json?                         @default("{}")
  createdAt                   DateTime                      @default(now()) @map("created_at")
  updatedAt                   DateTime                      @updatedAt @map("updated_at")
  attendance                  Attendance[]
  attendanceBreaks            AttendanceBreak[]
  buckets                     buckets[]
  channels                    channels[]
  clients                     Client[]
  company_government_holidays company_government_holidays[]
  customers                   customers[]
  document_history            document_history[]
  document_hub                document_hub[]
  documents                   documents[]
  documenttree                documenttree[]
  dropdownOptions             DropdownOption[]
  employee_field_configs      employee_field_configs[]
  fixed_holidays              fixed_holidays[]
  general_settings            general_settings[]
  invoice_items               invoice_items[]
  invoice_settings            invoice_settings[]
  invoices                    invoices[]
  leaves                      Leave[]
  meetings                    meetings[]
  payment_settings            payment_settings[]
  payslip_fields              payslip_fields[]
  projects                    Project[]
  reimbursementCategory       ReimbursementCategory[]
  releasePlans                ReleasePlan[]
  salary_components           salary_components[]
  settings_profiles           settings_profiles[]
  shifts                      Shift[]
  sprint_completion_logs      sprint_completion_logs[]
  statusUpdates               StatusUpdate[]
  ticketActivityLog           TicketActivityLog[]
  ticketAttachments           TicketAttachment[]
  ticketComments              TicketComment[]
  ticketRelatedLinks          TicketRelatedLink[]
  ticketWorkflowSteps         TicketWorkflowStep[]
  tickets                     Ticket[]
  transactions                Transaction[]
  users                       User[]
  reimbursementRequests ReimbursementRequest[]

  @@map("tenants")
}

model User {
  id                                   String                   @id @default(uuid())
  tenantId                             String                   @map("tenant_id")
  name                                 String
  workEmail                            String                   @map("work_email")
  personalEmail                        String                   @map("personal_email")
  phone                                String
  passwordHash                         String                   @map("password_hash")
  role                                 String                   @default("user")
  position                             String
  reportsToId                          String?                  @map("reports_to_id")
  dateOfBirth                          DateTime?                @map("date_of_birth")
  workDays                             Int[]                    @default([1, 2, 3, 4, 5]) @map("work_days")
  assignedShiftId                      String?                  @map("assigned_shift_id")
  shiftAssignedById                    String?                  @map("shift_assigned_by_id")
  shiftAssignedDate                    DateTime?                @map("shift_assigned_date")
  isActive                             Boolean                  @default(true) @map("is_active")
  lastLoginAt                          DateTime?                @map("last_login_at")
  createdAt                            DateTime                 @default(now()) @map("created_at")
  updatedAt                            DateTime                 @updatedAt @map("updated_at")
  enteredAttendance                    Attendance[]             @relation("AttendanceEnteredBy")
  attendance                           Attendance[]
  bucket_members                       bucket_members[]
  buckets                              buckets[]
  createdClients                       Client[]                 @relation("ClientCreator")
  approvedLeaves                       Leave[]                  @relation("LeaveApprover")
  leaves                               Leave[]                  @relation("UserLeaves")
  projectMemberships                   ProjectMember[]
  createdProjects                      Project[]                @relation("ProjectCreator")
  managedProjects                      Project[]                @relation("ProjectManager")
  refreshTokens                        RefreshToken[]
  createdReleasePlans                  ReleasePlan[]            @relation("ReleasePlanCreator")
  sprint_completion_logs               sprint_completion_logs[]
  statusUpdates                        StatusUpdate[]           @relation("UserStatusUpdates")
  performedActivityLog                 TicketActivityLog[]
  ticketAttachments                    TicketAttachment[]
  ticketComments                       TicketComment[]
  addedRelatedLinks                    TicketRelatedLink[]
  tickets_tickets_deleted_by_idTousers Ticket[]                 @relation("tickets_deleted_by_idTousers")
  archivedTickets                      Ticket[]                 @relation("TicketArchivedBy")
  assignedTickets                      Ticket[]                 @relation("TicketAssignee")
  createdTickets                       Ticket[]                 @relation("TicketCreator")
  reportToTickets                      Ticket[]                 @relation("TicketReportTo")
  transactions                         Transaction[]
  assignedShift                        Shift?                   @relation("UserShift", fields: [assignedShiftId], references: [id])
  reportsTo                            User?                    @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates                         User[]                   @relation("UserHierarchy")
  shiftAssignedBy                      User?                    @relation("ShiftAssigner", fields: [shiftAssignedById], references: [id])
  assignedShifts                       User[]                   @relation("ShiftAssigner")
  tenant                               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdReimbursementRequests ReimbursementRequest[]    @relation("ReimbursementRequestCreatedBy")
  updatedReimbursementRequests ReimbursementRequest[]   @relation("ReimbursementRequestUpdatedBy")
    

  @@unique([tenantId, workEmail])
  @@unique([tenantId, personalEmail])
  @@unique([tenantId, phone])
  @@map("users")
}


model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id                     String                   @id @default(uuid())
  tenantId               String                   @map("tenant_id")
  name                   String
  code                   String?                  @unique
  description            String
  status                 String                   @default("active")
  startDate              DateTime                 @map("start_date")
  endDate                DateTime?                @map("end_date")
  projectManagerId       String                   @map("project_manager_id")
  repositories           Json?                    @default("[]")
  workflowTemplate       String[]                 @map("workflow_template")
  defaultPriority        String                   @default("medium") @map("default_priority")
  totalTickets           Int                      @default(0) @map("total_tickets")
  completedTickets       Int                      @default(0) @map("completed_tickets")
  inProgressTickets      Int                      @default(0) @map("in_progress_tickets")
  createdById            String                   @map("created_by_id")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  buckets                buckets[]
  document_hub           document_hub[]
  members                ProjectMember[]
  createdBy              User                     @relation("ProjectCreator", fields: [createdById], references: [id])
  projectManager         User                     @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasePlans           ReleasePlan[]
  sprint_completion_logs sprint_completion_logs[]
  tickets                Ticket[]
  workEntries            WorkEntry[]

  @@unique([tenantId, code])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Ticket {
  id                                 String               @id @default(uuid())
  tenantId                           String               @map("tenant_id")
  projectId                          String               @map("project_id")
  releasePlanId                      String?              @map("release_plan_id")
  title                              String
  description                        String?
  ticketNumber                       String               @map("ticket_number")
  status                             String               @default("not_started")
  priority                           String               @default("Medium (P2)")
  type                               String               @default("Task")
  platform                           String               @default("Development")
  stack                              String?
  taskLevel                          String               @default("Medium") @map("task_level")
  storyPoint                         Int                  @default(1) @map("story_point")
  estimateHours                      Decimal              @default(0) @map("estimate_hours") @db.Decimal(5, 2)
  assigneeId                         String?              @map("assignee_id")
  reportToId                         String?              @map("report_to_id")
  createdById                        String               @map("created_by_id")
  parentTickets                      String[]             @default([]) @map("parent_tickets")
  parentTicketNotes                  String?              @map("parent_ticket_notes")
  currentWorkflowStep                String               @default("Scope Document") @map("current_workflow_step")
  startDate                          DateTime?            @map("start_date")
  endDate                            DateTime?            @map("end_date")
  dueDate                            DateTime?            @map("due_date")
  completedAt                        DateTime?            @map("completed_at")
  tags                               String[]             @default([])
  metadata                           Json?                @default("{}")
  createdAt                          DateTime             @default(now()) @map("created_at")
  updatedAt                          DateTime             @updatedAt @map("updated_at")
  epicId                             String?              @map("epic_id")
  parentId                           String?              @map("parent_id")
  rank                               String?
  demoPlanId                         String?              @map("demo_plan_id")
  sprintPlanId                       String?              @map("sprint_plan_id")
  isArchived                         Boolean              @default(false) @map("is_archived")
  archivedAt                         DateTime?            @map("archived_at")
  archivedById                       String?              @map("archived_by_id") @db.VarChar(255)
  bucket_id                          String?              @db.VarChar(255)
  is_deleted                         Boolean?             @default(false)
  deleted_at                         DateTime?            @db.Timestamp(6)
  deleted_by_id                      String?              @db.VarChar(255)
  document_hub                       document_hub[]
  activityLog                        TicketActivityLog[]
  attachments                        TicketAttachment[]
  comments                           TicketComment[]
  relatedLinks                       TicketRelatedLink[]
  workflowSteps                      TicketWorkflowStep[]
  buckets                            buckets?             @relation(fields: [bucket_id], references: [id], onUpdate: NoAction, map: "fk_tickets_bucket")
  users_tickets_deleted_by_idTousers User?                @relation("tickets_deleted_by_idTousers", fields: [deleted_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tickets_deleted_by")
  archivedBy                         User?                @relation("TicketArchivedBy", fields: [archivedById], references: [id])
  assignee                           User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy                          User                 @relation("TicketCreator", fields: [createdById], references: [id])
  demoPlan                           ReleasePlan?         @relation("TicketDemoPlan", fields: [demoPlanId], references: [id])
  epic                               Ticket?              @relation("EpicStories", fields: [epicId], references: [id])
  stories                            Ticket[]             @relation("EpicStories")
  parent                             Ticket?              @relation("ParentSubTasks", fields: [parentId], references: [id])
  subTasks                           Ticket[]             @relation("ParentSubTasks")
  project                            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasePlan                        ReleasePlan?         @relation("TicketReleasePlan", fields: [releasePlanId], references: [id])
  reportTo                           User?                @relation("TicketReportTo", fields: [reportToId], references: [id])
  sprintPlan                         ReleasePlan?         @relation("TicketSprintPlan", fields: [sprintPlanId], references: [id])
  tenant                             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workEntries                        WorkEntry[]

  @@unique([tenantId, ticketNumber])
  @@index([epicId])
  @@index([parentId])
  @@index([projectId, releasePlanId])
  @@index([projectId, sprintPlanId])
  @@index([projectId, demoPlanId])
  @@index([isArchived], map: "idx_tickets_archived")
  @@index([bucket_id], map: "idx_tickets_bucket_id")
  @@index([is_deleted, deleted_at], map: "idx_tickets_is_deleted_deleted_at")
  @@index([projectId, isArchived], map: "idx_tickets_project_archived")
  @@index([projectId, is_deleted], map: "idx_tickets_project_is_deleted")
  @@index([status, isArchived], map: "idx_tickets_status_archived")
  @@index([tenantId, isArchived], map: "idx_tickets_tenant_archived")
  @@index([tenantId, is_deleted], map: "idx_tickets_tenant_is_deleted")
  @@map("tickets")
}

model TicketWorkflowStep {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  ticketId         String    @map("ticket_id")
  stepName         String    @map("step_name")
  status           String    @default("not_started")
  assignedTo       String[]  @default([]) @map("assigned_to")
  approvers        String[]  @default([]) @map("approvers")
  approvalStatus   Json      @default("[]") @map("approval_status")
  documents        Json      @default("[]")
  notes            String?
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  completedAt      DateTime? @map("completed_at")
  scheduledMeeting Json?     @map("scheduled_meeting")
  branchName       String?   @map("branch_name")
  testResults      Json      @default("[]") @map("test_results")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_workflow_steps")
}

model TicketComment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  userId      String   @map("user_id")
  comment     String
  attachments Json     @default("[]")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

model TicketRelatedLink {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  linkType    String   @map("link_type")
  title       String
  description String
  url         String
  addedById   String   @map("added_by_id")
  addedAt     DateTime @default(now()) @map("added_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  addedBy     User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_related_links")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  ticketId     String   @map("ticket_id")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type")
  fileUrl      String   @map("file_url")
  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tenantId, ticketId])
  @@index([tenantId, ticketId], map: "idx_attachment_tenant_ticket")
  @@index([ticketId], map: "idx_attachment_ticket")
  @@map("ticket_attachments")
}

model TicketActivityLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  ticketId      String   @map("ticket_id")
  action        String
  performedById String   @map("performed_by_id")
  timestamp     DateTime @default(now())
  details       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  performedBy   User     @relation(fields: [performedById], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_activity_log")
}

model Client {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  contactPerson String?  @map("contact_person")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     User     @relation("ClientCreator", fields: [createdById], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("clients")
}

model ReleasePlan {
  id                     String                   @id @default(uuid())
  tenantId               String                   @map("tenant_id")
  projectId              String                   @map("project_id")
  version                String
  description            String?
  status                 String                   @default("planned")
  releaseDate            DateTime?                @map("release_date")
  createdById            String                   @map("created_by_id")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  type                   String                   @default("release_plan")
  goal                   String?
  startedAt              DateTime?                @map("started_at")
  completedAt            DateTime?                @map("completed_at")
  committedPoints        Int                      @default(0) @map("committed_points")
  completedPoints        Int                      @default(0) @map("completed_points")
  endDate                DateTime?                @map("end_date")
  startDate              DateTime?                @map("start_date")
  createdBy              User                     @relation("ReleasePlanCreator", fields: [createdById], references: [id])
  project                Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint_completion_logs sprint_completion_logs[]
  demoTickets            Ticket[]                 @relation("TicketDemoPlan")
  tickets                Ticket[]                 @relation("TicketReleasePlan")
  sprintTickets          Ticket[]                 @relation("TicketSprintPlan")

  @@unique([tenantId, projectId, version])
  @@index([projectId, type, status])
  @@map("release_plans")
}

model Shift {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  name              String
  startTime         String       @map("start_time")
  endTime           String       @map("end_time")
  workingMinutes    Int          @default(480) @map("working_minutes")
  graceMinutes      Int          @default(15) @map("grace_minutes")
  overtimeThreshold Int          @default(60) @map("overtime_threshold")
  breakMinutes      Int          @default(60) @map("break_minutes")
  description       String?
  color             String       @default("#007bff")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  attendance        Attendance[]
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]       @relation("UserShift")

  @@unique([tenantId, name])
  @@map("shifts")
}

model Attendance {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  userId               String            @map("user_id")
  date                 DateTime
  clockIn              DateTime?         @map("clock_in")
  clockOut             DateTime?         @map("clock_out")
  status               String            @default("present")
  shiftId              String?           @map("shift_id")
  totalWorkMinutes     Int               @default(0) @map("total_work_minutes")
  totalBreakMinutes    Int               @default(0) @map("total_break_minutes")
  effectiveWorkMinutes Int               @default(0) @map("effective_work_minutes")
  overtimeMinutes      Int               @default(0) @map("overtime_minutes")
  lateMinutes          Int               @default(0) @map("late_minutes")
  isManualEntry        Boolean           @default(false) @map("is_manual_entry")
  enteredById          String?           @map("entered_by_id")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  enteredBy            User?             @relation("AttendanceEnteredBy", fields: [enteredById], references: [id])
  shift                Shift?            @relation(fields: [shiftId], references: [id])
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks               AttendanceBreak[]

  @@map("attendance")
}

model AttendanceBreak {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  attendanceId    String     @map("attendance_id")
  breakType       String     @map("break_type")
  startTime       DateTime   @map("start_time")
  endTime         DateTime?  @map("end_time")
  durationMinutes Int        @default(0) @map("duration_minutes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendance_breaks")
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  description String
  category    String?
  date        DateTime
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model DropdownOption {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  category  String
  value     String
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category, value])
  @@map("dropdown_options")
}

model StatusUpdate {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  tenantId         String      @map("tenant_id")
  date             DateTime    @db.Date
  projectUpdates   Json        @default("[]") @map("project_updates")
  mood             String?
  totalHoursWorked Decimal?    @map("total_hours_worked") @db.Decimal(5, 2)
  generalNotes     String?     @map("general_notes")
  submittedAt      DateTime    @default(now()) @map("submitted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  is_missed        Boolean     @default(false)
  missed_updateAt  DateTime?
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User        @relation("UserStatusUpdates", fields: [userId], references: [id], onDelete: Cascade)
  workEntries      WorkEntry[]

  @@index([tenantId, date])
  @@index([userId, date])
  @@map("status_updates")
}

model WorkEntry {
  id             String       @id @default(uuid())
  statusUpdateId String       @map("status_update_id")
  projectId      String       @map("project_id")
  ticketId       String?      @map("ticket_id")
  startTime      DateTime     @map("start_time")
  endTime        DateTime     @map("end_time")
  hoursWorked    Decimal      @map("hours_worked") @db.Decimal(5, 2)
  workSummary    String       @map("work_summary")
  status         String
  blockers       String?
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  project        Project      @relation(fields: [projectId], references: [id])
  statusUpdate   StatusUpdate @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id])

  @@map("work_entries")
}

model Leave {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  type            String
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  duration        Decimal   @db.Decimal(5, 2)
  durationType    String    @map("duration_type")
  reason          String
  status          String    @default("pending")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  attachments     Json      @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  approvedBy      User?     @relation("LeaveApprover", fields: [approvedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model ReimbursementCategory {
  id                        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId                  String    @map("tenant_id")
  code                      String    @db.VarChar(50)
  name                      String    @db.VarChar(100)
  description               String?
  max_requests_per_month    Int?
  monthly_limit_amount      Decimal?  @db.Decimal(12, 2)
  yearly_limit_amount       Decimal?  @db.Decimal(12, 2)
  allowed_roles             String[]
  approval_flow             Json?
  attachment_required       Boolean?  @default(false)
  auto_approve_under_amount Decimal?  @db.Decimal(12, 2)
  currency                  String?   @db.Char(3)
  is_active                 Boolean?  @default(true)
  createdAt                 DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy                 String    @map("created_by")
  updatedAt                 DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy                 String?   @map("updated_by")
  createdByUser             User      @relation("ReimbursementCategoryCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reimbursement_category_created_by")
  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reimbursement_category_tenant")
  updatedByUser             User?     @relation("ReimbursementCategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reimbursement_category_updated_by")

  reimbursementRequests ReimbursementRequest[]

  @@unique([tenantId, code], map: "uq_reimbursement_category")
  @@map("reimbursement_category")
}
enum ReimbursementStatus {
  draft
  submitted
  approved
  rejected
  cancelled
}

model ReimbursementRequest {
  // Primary Key
  id             String   @id @default(uuid()) @db.Uuid

  // Tenant
  tenantId       String   @map("tenant_id")

  // Business fields
  requestNumber  String   @unique @map("request_number")
  categoryId     String   @map("category_id")
  departmentId   String?  @map("department_id")

  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  currency       String   @db.Char(3)

  status         ReimbursementStatus @default(draft)

  submittedAt    DateTime? @map("submitted_at")
  approvedAt     DateTime? @map("approved_at")

  rejectionReason String? @map("rejection_reason")
  remarks         String?

  // Audit fields
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")

  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by")

  // =======================
  // RELATIONS
  // =======================
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  category  ReimbursementCategory @relation(fields: [categoryId], references: [id])


  creator User @relation(
  "ReimbursementRequestCreatedBy",
  fields: [createdBy],
  references: [id]
)

updater User? @relation(
  "ReimbursementRequestUpdatedBy",
  fields: [updatedBy],
  references: [id]
)



  // =======================
  // INDEXES
  // =======================
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])

  @@map("reimbursement_request")
}

