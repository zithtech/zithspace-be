  categoryId   String   @map("category_id")

  maxAmount    Decimal  @db.Decimal(12,2) @map("max_amount")
  periodType   String   @map("period_type") // MONTH | YEAR

  isActive     Boolean  @default(true) @map("is_active")

  createdById  String   @db.Uuid @map("created_by_id")
  updatedById  String?  @db.Uuid @map("updated_by_id")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  
  policy       ReimbursementPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  approvers    ReimbursementPolicyApprover[]

  @@map("reimbursement_policy_rules")
}

model ReimbursementPolicyApprover {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id")
  policyRuleId  String   @db.Uuid @map("policy_rule_id")

  level         Int
  approverType  String   @map("approver_type")
  approverId    String  @map("approver_id")
  createdById   String   @db.Uuid @map("created_by_id")
  updatedById   String?  @db.Uuid @map("updated_by_id")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

 
  rule          ReimbursementPolicyRule @relation(fields: [policyRuleId], references: [id], onDelete: Cascade)

  @@map("reimbursement_policy_approvers")
}

model TimeTrackingEntry {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  projectId   String?  @map("project_id")
  ticketId    String?  @map("ticket_id")
  
  description String?
  billable    Boolean  @default(false)
  billingRate Decimal? @map("billing_rate") @db.Decimal(10, 2)
  
  startTime   DateTime @map("start_time")
  endTime     DateTime? @map("end_time")
  duration    Int?     // Duration in seconds
  status      String   @default("RUNNING") // RUNNING, STOPPED
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")


  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ticket      Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  logs        TimeTrackingLog[]

  @@index([tenantId, userId])
  @@index([projectId])
  @@map("time_tracking_entries")
}

model TimeTrackingLog {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  timeTrackingId  String   @map("time_tracking_id")
  
  action          String   // e.g., "STARTED", "PAUSED", "RESUMED", "STOPPED"
  
  createdAt       DateTime @default(now()) @map("created_at")

  timeTrackingEntry TimeTrackingEntry @relation(fields: [timeTrackingId], references: [id], onDelete: Cascade)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([timeTrackingId])
  @@index([tenantId])
  @@map("time_tracking_logs")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  tenantId         String   @map("tenant_id")
  sidebarCollapsed Boolean  @default(true) @map("sidebar_collapsed")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ============================================================
// LEAVE REQUEST MODEL
// ============================================================
model LeaveRequest {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  employeeId  String   @map("employee_id") @db.Uuid
  leaveTypeId String?  @map("leave_type_id")
  fromDate    DateTime @map("from_date") @db.Date
  toDate      DateTime @map("to_date") @db.Date
  totalUnits  Decimal  @map("total_units") @db.Decimal(5, 2)
  status      String   @default("PENDING")
  reason      String?
  appliedAt   DateTime @default(now()) @map("applied_at")
  approvedById String? @map("approved_by_id")
  approvedAt  DateTime? @map("approved_at")
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType? @relation(fields: [leaveTypeId], references: [id])
  approvedByUser User?      @relation("LeaveRequestApprover", fields: [approvedById], references: [id])
  createdBy      User       @relation("LeaveRequestCreator", fields: [createdById], references: [id])
  updatedBy      User?      @relation("LeaveRequestUpdater", fields: [updatedById], references: [id])

  @@map("leave_requests")
}

