enum DeductionType {
  BASIC_PERCENT
  GROSS_PERCENT
  FIXED
}

enum VisibilityType {
  PUBLIC
  PRIVATE
}

// -------------------------
// MODELS
// -------------------------

model SalaryStructure {
  id               Int        @id @default(autoincrement())
  name             String
  description      String
  grossSalary      Int
  deductionsEnabled Boolean   @default(false)
  visibility       VisibilityType @default(PUBLIC)
  companyId        Int?       // nullable if PUBLIC
  roleId           Int?       // nullable if PUBLIC
   tenantId          String   @map("tenant_id") 
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  createdById      String?    @map("created_by_id")
  updatedById      String?    @map("updated_by_id")
  isActive         Boolean    @default(false)

  // Relations
  earnings         Earning[]
  deductions       Deduction[]

  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy        User?  @relation("SalaryStructureCreator", fields: [createdById], references: [id])
  updatedBy        User?  @relation("SalaryStructureUpdater", fields: [updatedById], references: [id])

  @@map("salary_structures")
}

model Earning {
  id                Int     @id @default(autoincrement())
  name              String
  percentage        Float
  description       String?
  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@map("earnings")
}

model Deduction {
  id                Int          @id @default(autoincrement())
  name              String
  type              DeductionType
  value             Float
  salaryStructureId Int
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@map("deductions")
}



model Payslip {
  id          Int      @id @default(autoincrement())

  tenantId    String   @map("tenant_id") @db.VarChar(255)

  employeeId  String
  companyId   Int

  fromDate    DateTime
  toDate      DateTime

  snapshot    Json     // salary + attendance + deductions 
  pdfUrl      String

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id") @db.VarChar(255)

  
  createdBy User? @relation("UserPayslips", fields: [createdById], references: [id])

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, fromDate, toDate])
  @@map("payslips")
}

