  @@index([projectId, isDeleted], map: "idx_tickets_project_is_deleted")
  @@index([status, isArchived], map: "idx_tickets_status_archived")
  @@index([tenantId, isArchived], map: "idx_tickets_tenant_archived")
  @@index([tenantId, isDeleted], map: "idx_tickets_tenant_is_deleted")
  @@map("tickets")
}

