  invoice InvoiceSetting @relation(fields: [invoiceId], references: [id])
  payment PaymentSetting @relation(fields: [paymentId], references: [id])

  createdByUser User  @relation("SettingsProfileCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("SettingsProfileUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tenantId])
