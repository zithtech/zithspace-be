generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                                   String                                 @id @default(uuid())
  name                                 String
  subdomain                            String                                 @unique
  planType                             String                                 @default("basic") @map("plan_type")
  maxUsers                             Int                                    @default(10) @map("max_users")
  isActive                             Boolean                                @default(true) @map("is_active")
  settings                             Json?                                  @default("{}")
  createdAt                            DateTime                               @default(now()) @map("created_at")
  updatedAt                            DateTime                               @updatedAt @map("updated_at")
  is_trial                             Boolean?                               @default(false)
  trial_ends_at                        DateTime?                              @db.Timestamptz(6)
  attendance                           Attendance[]
  attendanceBreaks                     AttendanceBreak[]
  channels                             Channel[]
  ClientProject                        ClientProject[]
  Client                               Client[]
  holidays                             CompanyGovernmentHoliday[]
  customers                            Customer[]
  deals                                Deal[]
  departments                          Department[]
  dropdownOptions                      DropdownOption[]
  employmentTypes                      EmploymentType[]
  fixedHolidays                        FixedHoliday[]
  grades                               Grade[]
  invoice_templates                    invoice_templates[]
  leaveAdjustments                     LeaveAdjustment[]
  leaveOriginStructures                LeaveOriginStructure[]
  leaveTypes                           LeaveType[]
  leaves                               Leave[]
  mail_accounts                        mail_accounts[]
  mail_attachments                     mail_attachments[]
  mail_messages                        mail_messages[]
  mail_sync_logs                       mail_sync_logs[]
  mail_threads                         mail_threads[]
  meetings                             Meeting[]
  originLeaveTypes                     OriginLeaveType[]
  positions                            Position[]
  projects                             Project[]
  recruitment_client_basic_information recruitment_client_basic_information[]
  releasePlans                         ReleasePlan[]
  repositories                         Repository[]
  shifts                               Shift[]
  squad                                squad[]
  squad_members                        squad_members[]
  statusUpdates                        StatusUpdate[]
  subDepartments                       SubDepartment[]
  ticketActivityLog                    TicketActivityLog[]
  ticketAttachments                    TicketAttachment[]
  ticketComments                       TicketComment[]
  ticketRelatedLinks                   TicketRelatedLink[]
  ticketWorkflowSteps                  TicketWorkflowStep[]
  tickets                              Ticket[]
  timeTrackingEntries                  TimeTrackingEntry[]
  timeTrackingLogs                     TimeTrackingLog[]
  transactions                         Transaction[]
  users                                User[]
  vendor_basic_information             vendor_basic_information[]
  dealActivities                       DealActivity[]
  dealCommunications                   DealCommunication[]
  dealTasks                            DealTask[]
  dealFiles                            DealFile[]
  dealPaymentSchedules                 DealPaymentSchedule[]
  roles                                Role[]
  userRoles                            UserRole[]
  clientsV2                            ClientV2[]
  invoices                             Invoice[]
  emailLogs                            EmailLog[]
  invoicePayments                      InvoicePayment[]
  invoiceItems                         InvoiceItem[]
  settingsProfiles                     SettingsProfile[]
  generalSettings                      GeneralSetting[]
  invoiceSettings                      InvoiceSetting[]
  paymentSettings                      PaymentSetting[]
  timesheets                           Timesheet[]
  timesheetRows                        TimesheetRow[]
  buckets                              Bucket[]
  employees                            Employee[]
  employeeAddresses                    EmployeeAddress[]
  documentHubs                         DocumentHub[]
  documents                            Document[]
  documentTreeNodes                    DocumentTree[]
  documentHistories                    DocumentHistory[]

  @@map("tenants")
}

model User {
  id                                                                                             String                                 @id @default(uuid())
  tenantId                                                                                       String                                 @map("tenant_id")
  name                                                                                           String
  workEmail                                                                                      String                                 @map("work_email")
  personalEmail                                                                                  String                                 @map("personal_email")
  phone                                                                                          String
  passwordHash                                                                                   String                                 @map("password_hash")
  role                                                                                           String                                 @default("user")
  reportsToId                                                                                    String?                                @map("reports_to_id")
  dateOfBirth                                                                                    DateTime?                              @map("date_of_birth")
  workDays                                                                                       Int[]                                  @default([1, 2, 3, 4, 5]) @map("work_days")
  assignedShiftId                                                                                String?                                @map("assigned_shift_id")
  shiftAssignedById                                                                              String?                                @map("shift_assigned_by_id")
  shiftAssignedDate                                                                              DateTime?                              @map("shift_assigned_date")
  isActive                                                                                       Boolean                                @default(true) @map("is_active")
  lastLoginAt                                                                                    DateTime?                              @map("last_login_at")
  createdAt                                                                                      DateTime                               @default(now()) @map("created_at")
  updatedAt                                                                                      DateTime                               @updatedAt @map("updated_at")
  department                                                                                     String?
  company_id                                                                                     Int?
  zoho_access_token                                                                              String?                                @db.VarChar
  zoho_refresh_token                                                                             String?                                @db.VarChar
  zoho_token_expiry                                                                              DateTime?                              @db.Timestamptz(6)
  zoho_calendar_id                                                                               String?                                @db.VarChar
  positionId                                                                                     String?                                @map("position_id")
  zoho_last_sync                                                                                 DateTime?                              @db.Timestamptz(6)
  employeeId                                                                                     String?                                @map("employee_id") @db.Uuid
  enteredAttendance                                                                              Attendance[]                           @relation("AttendanceEnteredBy")
  attendance                                                                                     Attendance[]
  channelMemberships                                                                             ChannelMember[]
  channelMessages                                                                                ChannelMessage[]
  createdChannels                                                                                Channel[]                              @relation("ChannelCreator")
  createdClients                                                                                 Client[]                               @relation("ClientCreator")
  createdHolidays                                                                                CompanyGovernmentHoliday[]             @relation("CompanyGovernmentHolidayCreator")
  updatedHolidays                                                                                CompanyGovernmentHoliday[]             @relation("CompanyGovernmentHolidayUpdater")
  createdDepartments                                                                             Department[]                           @relation("DepartmentCreator")
  managedDepartments                                                                             Department[]                           @relation("DepartmentHead")
  updatedDepartments                                                                             Department[]                           @relation("DepartmentUpdater")
  createdEmploymentTypes                                                                         EmploymentType[]                       @relation("EmploymentTypeCreator")
  updatedEmploymentTypes                                                                         EmploymentType[]                       @relation("EmploymentTypeUpdater")
  createdFixedHolidays                                                                           FixedHoliday[]                         @relation("FixedHolidayCreator")
  updatedFixedHolidays                                                                           FixedHoliday[]                         @relation("FixedHolidayUpdater")
  createdGrades                                                                                  Grade[]                                @relation("GradeCreator")
  updatedGrades                                                                                  Grade[]                                @relation("GradeUpdater")
  invoice_templates                                                                              invoice_templates[]
  approvedAdjustments                                                                            LeaveAdjustment[]                      @relation("LeaveAdjustmentApprover")
  createdLeaveAdjustments                                                                        LeaveAdjustment[]                      @relation("LeaveAdjustmentCreator")
  updatedLeaveAdjustments                                                                        LeaveAdjustment[]                      @relation("LeaveAdjustmentUpdater")
  leaveAdjustments                                                                               LeaveAdjustment[]                      @relation("UserLeaveAdjustments")
  createdLeaveOriginStructures                                                                   LeaveOriginStructure[]                 @relation("LeaveOriginStructureCreator")
  updatedLeaveOriginStructures                                                                   LeaveOriginStructure[]                 @relation("LeaveOriginStructureUpdater")
  createdLeaveTypes                                                                              LeaveType[]                            @relation("LeaveTypeCreator")
  updatedLeaveTypes                                                                              LeaveType[]                            @relation("LeaveTypeUpdater")
  createdInvoiceItems                                                                            InvoiceItem[]                          @relation("InvoiceItemCreator")
  updatedInvoiceItems                                                                            InvoiceItem[]                          @relation("InvoiceItemUpdater")
  deletedInvoiceItems                                                                            InvoiceItem[]                          @relation("InvoiceItemDeleter")
  createdDocumentHubs                                                                            DocumentHub[]                          @relation("DocumentHubCreator")
  createdDocuments                                                                               Document[]                             @relation("DocumentCreator")
  createdDocumentTreeNodes                                                                       DocumentTree[]                         @relation("DocumentTreeCreator")
  createdDocumentHistories                                                                       DocumentHistory[]                      @relation("DocumentHistoryCreator")
  createdGeneralSettings                                                                         GeneralSetting[]                       @relation("GeneralSettingCreator")
  updatedGeneralSettings                                                                         GeneralSetting[]                       @relation("GeneralSettingUpdater")
  createdInvoiceSettings                                                                         InvoiceSetting[]                       @relation("InvoiceSettingCreator")
  updatedInvoiceSettings                                                                         InvoiceSetting[]                       @relation("InvoiceSettingUpdater")
  createdPaymentSettings                                                                         PaymentSetting[]                       @relation("PaymentSettingCreator")
  updatedPaymentSettings                                                                         PaymentSetting[]                       @relation("PaymentSettingUpdater")
  createdSettingsProfiles                                                                        SettingsProfile[]                      @relation("SettingsProfileCreator")
  updatedSettingsProfiles                                                                        SettingsProfile[]                      @relation("SettingsProfileUpdater")
  approvedLeaves                                                                                 Leave[]                                @relation("LeaveApprover")
  leaves                                                                                         Leave[]                                @relation("UserLeaves")
  mail_accounts_mail_accounts_created_by_idTousers                                               mail_accounts[]                        @relation("mail_accounts_created_by_idTousers")
  mail_accounts_mail_accounts_updated_by_idTousers                                               mail_accounts[]                        @relation("mail_accounts_updated_by_idTousers")
  mail_accounts_mail_accounts_user_idTousers                                                     mail_accounts[]                        @relation("mail_accounts_user_idTousers")
  mail_attachments_mail_attachments_created_by_idTousers                                         mail_attachments[]                     @relation("mail_attachments_created_by_idTousers")
  mail_attachments_mail_attachments_updated_by_idTousers                                         mail_attachments[]                     @relation("mail_attachments_updated_by_idTousers")
  mail_messages_mail_messages_created_by_idTousers                                               mail_messages[]                        @relation("mail_messages_created_by_idTousers")
  mail_messages_mail_messages_updated_by_idTousers                                               mail_messages[]                        @relation("mail_messages_updated_by_idTousers")
  mail_sync_logs_mail_sync_logs_created_by_idTousers                                             mail_sync_logs[]                       @relation("mail_sync_logs_created_by_idTousers")
  mail_sync_logs_mail_sync_logs_updated_by_idTousers                                             mail_sync_logs[]                       @relation("mail_sync_logs_updated_by_idTousers")
  mail_threads_mail_threads_created_by_idTousers                                                 mail_threads[]                         @relation("mail_threads_created_by_idTousers")
  mail_threads_mail_threads_updated_by_idTousers                                                 mail_threads[]                         @relation("mail_threads_updated_by_idTousers")
  meetingParticipations                                                                          MeetingParticipant[]
  createdMeetings                                                                                Meeting[]                              @relation("MeetingCreator")
  createdOriginLeaveTypes                                                                        OriginLeaveType[]                      @relation("OriginLeaveTypeCreator")
  updatedOriginLeaveTypes                                                                        OriginLeaveType[]                      @relation("OriginLeaveTypeUpdater")
  createdPositions                                                                               Position[]                             @relation("PositionCreator")
  updatedPositions                                                                               Position[]                             @relation("PositionUpdater")
  projectMemberships                                                                             ProjectMember[]
  createdProjects                                                                                Project[]                              @relation("ProjectCreator")
  managedProjects                                                                                Project[]                              @relation("ProjectManager")
  recruitment_client_basic_information_recruitment_client_basic_information_created_by_idTousers recruitment_client_basic_information[] @relation("recruitment_client_basic_information_created_by_idTousers")
  recruitment_client_basic_information_recruitment_client_basic_information_updated_by_idTousers recruitment_client_basic_information[] @relation("recruitment_client_basic_information_updated_by_idTousers")
  recruitment_client_business_detailes_recruitment_client_business_detailes_created_by_idTousers recruitment_client_business_detailes[] @relation("recruitment_client_business_detailes_created_by_idTousers")
  recruitment_client_business_detailes_recruitment_client_business_detailes_updated_by_idTousers recruitment_client_business_detailes[] @relation("recruitment_client_business_detailes_updated_by_idTousers")
  refreshTokens                                                                                  RefreshToken[]
  createdReleasePlans                                                                            ReleasePlan[]                          @relation("ReleasePlanCreator")
  squad_squad_created_by_idTousers                                                               squad[]                                @relation("squad_created_by_idTousers")
  squad_squad_updated_by_idTousers                                                               squad[]                                @relation("squad_updated_by_idTousers")
  squad_members_squad_members_created_by_idTousers                                               squad_members[]                        @relation("squad_members_created_by_idTousers")
  squad_members_squad_members_updated_by_idTousers                                               squad_members[]                        @relation("squad_members_updated_by_idTousers")
  squad_members_squad_members_squad_member_idTousers                                             squad_members[]                        @relation("squad_members_squad_member_idTousers")
  statusUpdates                                                                                  StatusUpdate[]                         @relation("UserStatusUpdates")
  createdSubDepartments                                                                          SubDepartment[]                        @relation("SubDepartmentCreator")
  updatedSubDepartments                                                                          SubDepartment[]                        @relation("SubDepartmentUpdater")
  performedActivityLog                                                                           TicketActivityLog[]
  ticketAttachments                                                                              TicketAttachment[]
  ticketComments                                                                                 TicketComment[]
  addedRelatedLinks                                                                              TicketRelatedLink[]
  assignedTickets                                                                                Ticket[]                               @relation("TicketAssignee")
  createdTickets                                                                                 Ticket[]                               @relation("TicketCreator")
  reportToTickets                                                                                Ticket[]                               @relation("TicketReportTo")
  timeTrackingEntries                                                                            TimeTrackingEntry[]
  transactions                                                                                   Transaction[]
  assignedShift                                                                                  Shift?                                 @relation("UserShift", fields: [assignedShiftId], references: [id])
  position                                                                                       Position?                              @relation("UserPosition", fields: [positionId], references: [id])
  reportsTo                                                                                      User?                                  @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates                                                                                   User[]                                 @relation("UserHierarchy")
  shiftAssignedBy                                                                                User?                                  @relation("ShiftAssigner", fields: [shiftAssignedById], references: [id])
  assignedShifts                                                                                 User[]                                 @relation("ShiftAssigner")
  tenant                                                                                         Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor_basic_information_vendor_basic_information_created_by_idTousers                         vendor_basic_information[]             @relation("vendor_basic_information_created_by_idTousers")
  vendor_basic_information_vendor_basic_information_updated_by_idTousers                         vendor_basic_information[]             @relation("vendor_basic_information_updated_by_idTousers")
  zoho_events_zoho_events_updated_byTousers                                                      zoho_events[]                          @relation("zoho_events_updated_byTousers")
  zoho_events_zoho_events_user_idTousers                                                         zoho_events[]                          @relation("zoho_events_user_idTousers")
  userRoles                                                                                      UserRole[]
  employee                                                                                       Employee?                              @relation(fields: [employeeId], references: [id])
  createdInvoices                                                                                Invoice[]                              @relation("InvoiceCreator")
  updatedInvoices                                                                                Invoice[]                              @relation("InvoiceUpdater")
  sentEmails                                                                                     EmailLog[]                             @relation("SentEmails")
  timesheets                                                                                     Timesheet[]                            @relation("UserTimesheets")
  approvedTimesheets                                                                             Timesheet[]                            @relation("TimesheetApprover")
  buckets                                                                                        Bucket[]                               @relation("BucketCreator")
  bucketMembers                                                                                  BucketMember[]
  sprintCompletionLogs                                                                           SprintCompletionLog[]                  @relation("SprintCompletionPerformer")
  createdTimesheetRows                                                                           TimesheetRow[]                         @relation("TimesheetRowCreator")
  updatedTimesheetRows                                                                           TimesheetRow[]                         @relation("TimesheetRowUpdater")
  deletedTickets                                                                                 Ticket[]                               @relation("TicketDeleter")
  createdInvoicePayments                                                                         InvoicePayment[]                       @relation("InvoicePaymentCreator")
  updatedInvoicePayments                                                                         InvoicePayment[]                       @relation("InvoicePaymentUpdater")
  createdEmployeeAssets                                                                          EmployeeAsset[]                        @relation("EmployeeAssetCreator")
  updatedEmployeeAssets                                                                          EmployeeAsset[]                        @relation("EmployeeAssetUpdater")
  deletedInvoices                                                                                Invoice[]                              @relation("InvoiceDeleter")
  assignedDeals                                                                                  AssignedDealUser[]

  @@unique([tenantId, workEmail])
  @@unique([tenantId, personalEmail])
  @@unique([tenantId, phone])
  @@map("users")
}

model Grade {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  code        String
  name        String
  levelOrder  Int        @map("level_order")
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdById String     @map("created_by_id")
  updatedById String?    @map("updated_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  codes       String?
  createdBy   User       @relation("GradeCreator", fields: [createdById], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy   User?      @relation("GradeUpdater", fields: [updatedById], references: [id])
  positions   Position[]

  @@unique([tenantId, code])
  @@map("grades")
}

model EmploymentType {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  code        String
  createdBy   User     @relation("EmploymentTypeCreator", fields: [createdById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("EmploymentTypeUpdater", fields: [updatedById], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("employment_types")
}

model Department {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  code           String
  name           String
  employmentType String?         @map("employment_type")
  description    String?
  headId         String?         @map("head_id")
  isActive       Boolean         @default(true) @map("is_active")
  createdById    String          @map("created_by_id")
  updatedById    String?         @map("updated_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      User            @relation("DepartmentCreator", fields: [createdById], references: [id])
  head           User?           @relation("DepartmentHead", fields: [headId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy      User?           @relation("DepartmentUpdater", fields: [updatedById], references: [id])
  positions      Position[]
  subDepartments SubDepartment[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("departments")
}

model SubDepartment {
  id                 String     @id @default(uuid())
  tenantId           String     @map("tenant_id")
  parentDepartmentId String     @map("parent_department_id")
  code               String
  name               String
  description        String?
  isActive           Boolean    @default(true) @map("is_active")
  createdById        String     @map("created_by_id")
  updatedById        String?    @map("updated_by_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  positions          Position[]
  createdBy          User       @relation("SubDepartmentCreator", fields: [createdById], references: [id])
  parentDepartment   Department @relation(fields: [parentDepartmentId], references: [id], onDelete: Cascade)
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy          User?      @relation("SubDepartmentUpdater", fields: [updatedById], references: [id])

  @@unique([tenantId, code])
  @@map("sub_departments")
}

model Position {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  code            String
  title           String
  departmentId    String         @map("department_id")
  subDepartmentId String?        @map("sub_department_id")
  gradeId         String         @map("grade_id")
  description     String?
  isActive        Boolean        @default(true) @map("is_active")
  createdById     String         @map("created_by_id")
  updatedById     String?        @map("updated_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  createdBy       User           @relation("PositionCreator", fields: [createdById], references: [id])
  department      Department     @relation(fields: [departmentId], references: [id])
  grade           Grade          @relation(fields: [gradeId], references: [id])
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy       User?          @relation("PositionUpdater", fields: [updatedById], references: [id])
  users           User[]         @relation("UserPosition")

  @@unique([tenantId, code])
  @@map("positions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id                  String              @id @default(uuid())
  tenantId            String              @map("tenant_id")
  name                String
  code                String?             @unique
  description         String
  status              String              @default("active")
  startDate           DateTime            @map("start_date")
  endDate             DateTime?           @map("end_date")
  projectManagerId    String              @map("project_manager_id")
  repositories        Json?               @default("[]")
  workflowTemplate    String[]            @map("workflow_template")
  defaultPriority     String              @default("medium") @map("default_priority")
  totalTickets        Int                 @default(0) @map("total_tickets")
  completedTickets    Int                 @default(0) @map("completed_tickets")
  inProgressTickets   Int                 @default(0) @map("in_progress_tickets")
  createdById         String              @map("created_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  clientProjects      ClientProject[]
  members             ProjectMember[]
  createdBy           User                @relation("ProjectCreator", fields: [createdById], references: [id])
  projectManager      User                @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasePlans        ReleasePlan[]
  tickets             Ticket[]
  timeTrackingEntries TimeTrackingEntry[]
  workEntries         WorkEntry[]
  invoices            Invoice[]
  buckets             Bucket[]
  timesheetRows       TimesheetRow[]
  documentHubs        DocumentHub[]

  @@unique([tenantId, code])
  @@map("projects")
}

model ClientProject {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  clientId    String   @map("client_id")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  billingType String?  @map("billing_type")
  budget      Decimal? @db.Decimal(15, 2)
  budget_type String?  @db.VarChar(50)
  client      ClientV2 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([clientId, projectId])
  @@map("client_projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Ticket {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  projectId           String               @map("project_id")
  releasePlanId       String?              @map("release_plan_id")
  title               String
  description         String?
  ticketNumber        String               @map("ticket_number")
  status              String               @default("not_started")
  priority            String               @default("Medium (P2)")
  type                String               @default("Task")
  platform            String               @default("Development")
  stack               String?
  taskLevel           String               @default("Medium") @map("task_level")
  storyPoint          Int                  @default(1) @map("story_point")
  estimateHours       Decimal              @default(0) @map("estimate_hours") @db.Decimal(5, 2)
  documentHubs        DocumentHub[]
  assigneeId          String?              @map("assignee_id")
  reportToId          String?              @map("report_to_id")
  createdById         String               @map("created_by_id")
  parentTickets       String[]             @default([]) @map("parent_tickets")
  parentTicketNotes   String?              @map("parent_ticket_notes")
  currentWorkflowStep String               @default("Scope Document") @map("current_workflow_step")
  startDate           DateTime?            @map("start_date")
  endDate             DateTime?            @map("end_date")
  dueDate             DateTime?            @map("due_date")
  completedAt         DateTime?            @map("completed_at")
  tags                String[]             @default([])
  metadata            Json?                @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  epicId              String?              @map("epic_id")
  parentId            String?              @map("parent_id")
  rank                String?
  demoPlanId          String?              @map("demo_plan_id")
  sprintPlanId        String?              @map("sprint_plan_id")
  isArchived          Boolean              @default(false) @map("is_archived")
  archivedAt          DateTime?            @map("archived_at")
  archivedById        String?              @map("archived_by_id") @db.VarChar(255)
  bucketId            String?              @map("bucket_id") @db.Uuid
  bucket              Bucket?              @relation(fields: [bucketId], references: [id])
  isDeleted           Boolean?             @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamp(6)
  deletedById         String?              @map("deleted_by_id") @db.VarChar(255)
  deletedBy           User?                @relation("TicketDeleter", fields: [deletedById], references: [id])
  activityLog         TicketActivityLog[]
  attachments         TicketAttachment[]
  branches            TicketBranch[]
  comments            TicketComment[]
  pullRequests        TicketPullRequest[]
  relatedLinks        TicketRelatedLink[]
  workflowSteps       TicketWorkflowStep[]
  assignee            User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy           User                 @relation("TicketCreator", fields: [createdById], references: [id])
  demoPlan            ReleasePlan?         @relation("TicketDemoPlan", fields: [demoPlanId], references: [id])
  epic                Ticket?              @relation("EpicStories", fields: [epicId], references: [id])
  stories             Ticket[]             @relation("EpicStories")
  parent              Ticket?              @relation("ParentSubTasks", fields: [parentId], references: [id])
  subTasks            Ticket[]             @relation("ParentSubTasks")
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasePlan         ReleasePlan?         @relation("TicketReleasePlan", fields: [releasePlanId], references: [id])
  reportTo            User?                @relation("TicketReportTo", fields: [reportToId], references: [id])
  sprintPlan          ReleasePlan?         @relation("TicketSprintPlan", fields: [sprintPlanId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeTrackingEntries TimeTrackingEntry[]
  workEntries         WorkEntry[]

  @@unique([tenantId, ticketNumber])
  @@index([epicId])
  @@index([parentId])
  @@index([projectId, releasePlanId])
  @@index([projectId, sprintPlanId])
  @@index([projectId, demoPlanId])
  @@index([bucketId], map: "idx_tickets_bucket_id")
  @@index([isDeleted, deletedAt], map: "idx_tickets_is_deleted_deleted_at")
  @@index([projectId, isArchived], map: "idx_tickets_project_archived")
  @@index([projectId, isDeleted], map: "idx_tickets_project_is_deleted")
  @@index([status, isArchived], map: "idx_tickets_status_archived")
  @@index([tenantId, isArchived], map: "idx_tickets_tenant_archived")
  @@index([tenantId, isDeleted], map: "idx_tickets_tenant_is_deleted")
  @@map("tickets")
}

