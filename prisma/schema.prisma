model reimbursement_requests {
  id                        String    @id @default(dbgenerated("gen_random_uuid()"))
  tenant_id                 String
  request_id                String
  user_id                   String
  category                  String
  department                String
  policy                    String?
  amount                    Decimal   @db.Decimal(10, 2)
  status                    String    @default("DRAFT")
  finance_status            String?
  submitted_at              DateTime?
  activity_log              Json      @default("[]")
  created_at                DateTime  @default(now())
  updated_at                DateTime  @default(now())
  reimbursement_category_id String?
  year                      Int       @default(dbgenerated("EXTRACT(year FROM CURRENT_TIMESTAMP)"))

  @@unique([tenant_id, request_id])
  @@unique([tenant_id, year, request_id])
  @@index([reimbursement_category_id], map: "idx_reimbursement_requests_category")
  @@index([status], map: "idx_reimbursement_requests_status")
  @@index([tenant_id, year, created_at], map: "idx_reimbursement_requests_tenant_year")
  @@index([user_id], map: "idx_reimbursement_requests_user")
}

