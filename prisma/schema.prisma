generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String            @id @default(uuid())
  name             String
  subdomain        String            @unique
  planType         String            @default("basic") @map("plan_type")
  maxUsers         Int               @default(10) @map("max_users")
  isActive         Boolean           @default(true) @map("is_active")
  settings         Json?             @default("{}")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  attendance       Attendance[]
  attendanceBreaks AttendanceBreak[]
  buckets          Bucket[]
  customers        Customer[]
  dropdownOptions  DropdownOption[]
  leaves           Leave[]
  leaveTypes          LeaveType[]
  leaveAdjustments    LeaveAdjustment[]
  leaveOriginStructures LeaveOriginStructure[]
  originLeaveTypes      OriginLeaveType[]
  fixedHolidays    FixedHoliday[]

  salaryComponents SalaryComponent[]
  companies        Company[]
  holidays         CompanyGovernmentHoliday[]
  projects         Project[]
  releasePlans     ReleasePlan[]

   reimbursementCategories ReimbursementCategory[]





  shifts           Shift[]

  sprintCompletionLogs SprintCompletionLog[]
  statusUpdates        StatusUpdate[]
  ticketActivityLog    TicketActivityLog[]
  ticketAttachments    TicketAttachment[]
  ticketComments       TicketComment[]
  ticketRelatedLinks   TicketRelatedLink[]
  ticketWorkflowSteps  TicketWorkflowStep[]
  tickets              Ticket[]
  transactions         Transaction[]
  users                User[]
  generalSettings      GeneralSetting[]
  invoiceSettings      InvoiceSetting[]
  paymentSettings      PaymentSetting[]
  settingsProfiles     SettingsProfile[]
  invoices             Invoice[]
  items                InvoiceItem[]
  payments             InvoicePayment[]
  documenthub          DocumentHub[]
  documents            Document[]
  documenttree         DocumentTree[]
  documentHistory      DocumentHistory[]

  // ZithTech Calls Relations
  channels Channel[]
  meetings Meeting[]
  Client   Client[]

  @@map("tenants")
}

model User {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  name              String
  workEmail         String    @map("work_email")
  personalEmail     String    @map("personal_email")
  phone             String
  passwordHash      String    @map("password_hash")
  role              String    @default("user")
  position          String
  reportsToId       String?   @map("reports_to_id")
  dateOfBirth       DateTime? @map("date_of_birth")
  workDays          Int[]     @default([1, 2, 3, 4, 5]) @map("work_days")
  assignedShiftId   String?   @map("assigned_shift_id")
  shiftAssignedById String?   @map("shift_assigned_by_id")
  shiftAssignedDate DateTime? @map("shift_assigned_date")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  createdSalaryComponents SalaryComponent[] @relation("SalaryComponentCreator")
  updatedSalaryComponents SalaryComponent[] @relation("SalaryComponentUpdater")
  createdCompanies        Company[]         @relation("CompanyCreator")
  updatedCompanies        Company[]         @relation("CompanyUpdater")
  createdCustomers        Customer[]        @relation("CustomerCreatedBy")
  updatedCustomers        Customer[]        @relation("CustomerUpdatedBy")

  enteredAttendance    Attendance[]               @relation("AttendanceEnteredBy")
  attendance           Attendance[]
  createdClients       Client[]                   @relation("ClientCreator")
  approvedLeaves       Leave[]                    @relation("LeaveApprover")
  createdLeaveTypes    LeaveType[]         @relation("LeaveTypeCreator")
  updatedLeaveTypes    LeaveType[]         @relation("LeaveTypeUpdater")
  leaves               Leave[]                    @relation("UserLeaves")
  leaveAdjustments        LeaveAdjustment[] @relation("UserLeaveAdjustments")
  approvedAdjustments     LeaveAdjustment[] @relation("LeaveAdjustmentApprover")
  createdLeaveAdjustments LeaveAdjustment[] @relation("LeaveAdjustmentCreator")
  updatedLeaveAdjustments LeaveAdjustment[] @relation("LeaveAdjustmentUpdater")
  createdLeaveOriginStructures LeaveOriginStructure[] @relation("LeaveOriginStructureCreator")
  updatedLeaveOriginStructures LeaveOriginStructure[] @relation("LeaveOriginStructureUpdater")
  createdOriginLeaveTypes      OriginLeaveType[]      @relation("OriginLeaveTypeCreator")
  updatedOriginLeaveTypes      OriginLeaveType[]      @relation("OriginLeaveTypeUpdater")
  projectMemberships   ProjectMember[]
  createdProjects      Project[]                  @relation("ProjectCreator")
  managedProjects      Project[]                  @relation("ProjectManager")
  refreshTokens        RefreshToken[]
  createdReleasePlans  ReleasePlan[]              @relation("ReleasePlanCreator")
  statusUpdates        StatusUpdate[]             @relation("UserStatusUpdates")
  performedActivityLog TicketActivityLog[]
  ticketAttachments    TicketAttachment[]
  ticketComments       TicketComment[]
  addedRelatedLinks    TicketRelatedLink[]
  documenthub          DocumentHub[]
  documents            Document[]
  documentHistory      DocumentHistory[]
  documenttree         DocumentTree[]
  assignedTickets      Ticket[]                   @relation("TicketAssignee")
  createdTickets       Ticket[]                   @relation("TicketCreator")
  reportToTickets      Ticket[]                   @relation("TicketReportTo")
  archivedTickets      Ticket[]                   @relation("TicketArchivedBy")
  deletedTickets       Ticket[]                   @relation("TicketDeletedBy")
  createdBuckets       Bucket[]                   @relation("BucketCreator")
  bucketMemberships    BucketMember[]
  createdFixedHolidays FixedHoliday[]             @relation("FixedHolidayCreator")
  updatedFixedHolidays FixedHoliday[]             @relation("FixedHolidayUpdater")
  createdHolidays      CompanyGovernmentHoliday[] @relation("CompanyGovernmentHolidayCreator")
  updatedHolidays      CompanyGovernmentHoliday[] @relation("CompanyGovernmentHolidayUpdater")
  sprintCompletionLogs SprintCompletionLog[]
  transactions         Transaction[]
  assignedShift        Shift?              @relation("UserShift", fields: [assignedShiftId], references: [id])
  reportsTo            User?               @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates         User[]              @relation("UserHierarchy")
  shiftAssignedBy      User?               @relation("ShiftAssigner", fields: [shiftAssignedById], references: [id])
  assignedShifts       User[]              @relation("ShiftAssigner")
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)



    // ===== Reimbursement Category =====
  createdReimbursementCategories ReimbursementCategory[] @relation("ReimbursementCategoryCreatedBy")
  updatedReimbursementCategories ReimbursementCategory[] @relation("ReimbursementCategoryUpdatedBy")

  @@unique([tenantId, workEmail])
  @@unique([tenantId, personalEmail])
  @@unique([tenantId, phone])
  @@map("users")
}





model ReimbursementCategory {
  id                        String   @id @default(uuid())
  tenantId                  String   @map("tenant_id")

  code                      String   @db.VarChar(50)
  name                      String   @db.VarChar(100)
  description               String?

  maxRequestsPerMonth       Int?      @map("max_requests_per_month")
  monthlyLimitAmount        Decimal?  @map("monthly_limit_amount") @db.Decimal(12, 2)
  yearlyLimitAmount         Decimal?  @map("yearly_limit_amount")  @db.Decimal(12, 2)

  allowedRoles              String[]  @map("allowed_roles")
  approvalFlow              Json?     @map("approval_flow")

  attachmentRequired        Boolean   @default(false) @map("attachment_required")
  autoApproveUnderAmount    Decimal?  @map("auto_approve_under_amount") @db.Decimal(12, 2)

  isActive                  Boolean   @default(true) @map("is_active")

  createdAt                 DateTime  @default(now()) @map("created_at")
  createdBy                 String    @map("created_by")

  updatedAt                 DateTime  @updatedAt @map("updated_at")
  updatedBy                 String?   @map("updated_by")

  // Relations
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdByUser User     @relation("ReimbursementCategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("ReimbursementCategoryUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([tenantId, code])
  @@map("reimbursement_category")
}




model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  name                 String
  code                 String?               @unique
  description          String
  status               String                @default("active")
  startDate            DateTime              @map("start_date")
  endDate              DateTime?             @map("end_date")
  projectManagerId     String                @map("project_manager_id")
  repositories         Json?                 @default("[]")
  workflowTemplate     String[]              @map("workflow_template")
  defaultPriority      String                @default("medium") @map("default_priority")
  totalTickets         Int                   @default(0) @map("total_tickets")
  completedTickets     Int                   @default(0) @map("completed_tickets")
  inProgressTickets    Int                   @default(0) @map("in_progress_tickets")
  createdById          String                @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  members              ProjectMember[]
  buckets              Bucket[]
  createdBy            User                  @relation("ProjectCreator", fields: [createdById], references: [id])
  projectManager       User                  @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasePlans         ReleasePlan[]
  sprintCompletionLogs SprintCompletionLog[]
  tickets              Ticket[]
  workEntries          WorkEntry[]
  documenthub          DocumentHub[]

  @@unique([tenantId, code])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Ticket {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  projectId           String    @map("project_id")
  releasePlanId       String?   @map("release_plan_id")
  title               String
  description         String?
  ticketNumber        String    @map("ticket_number")
  status              String    @default("not_started")
  priority            String    @default("Medium (P2)")
  type                String    @default("Task")
  platform            String    @default("Development")
  stack               String?
  taskLevel           String    @default("Medium") @map("task_level")
  storyPoint          Int       @default(1) @map("story_point")
  estimateHours       Decimal   @default(0) @map("estimate_hours") @db.Decimal(5, 2)
  assigneeId          String?   @map("assignee_id")
  reportToId          String?   @map("report_to_id")
  createdById         String    @map("created_by_id")
  parentTickets       String[]  @default([]) @map("parent_tickets")
  parentTicketNotes   String?   @map("parent_ticket_notes")
  currentWorkflowStep String    @default("Scope Document") @map("current_workflow_step")
  startDate           DateTime? @map("start_date")
  endDate             DateTime? @map("end_date")
  dueDate             DateTime? @map("due_date")
  completedAt         DateTime? @map("completed_at")
  tags                String[]  @default([])
  metadata            Json?     @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  epicId              String?   @map("epic_id")
  parentId            String?   @map("parent_id")
  rank                String?
  demoPlanId          String?   @map("demo_plan_id")
  sprintPlanId        String?   @map("sprint_plan_id")
  bucketId            String?   @map("bucket_id")

  // Archive fields
  isArchived   Boolean   @default(false) @map("is_archived")
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id")

  // Soft delete / Trash fields
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  // Relations
  activityLog   TicketActivityLog[]
  attachments   TicketAttachment[]
  comments      TicketComment[]
  relatedLinks  TicketRelatedLink[]
  workflowSteps TicketWorkflowStep[]
  documenthub   DocumentHub[]
  assignee      User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy     User                 @relation("TicketCreator", fields: [createdById], references: [id])
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasePlan   ReleasePlan?         @relation("TicketReleasePlan", fields: [releasePlanId], references: [id])
  sprintPlan    ReleasePlan?         @relation("TicketSprintPlan", fields: [sprintPlanId], references: [id])
  demoPlan      ReleasePlan?         @relation("TicketDemoPlan", fields: [demoPlanId], references: [id])
  bucket        Bucket?              @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  reportTo      User?                @relation("TicketReportTo", fields: [reportToId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workEntries   WorkEntry[]

  // Hierarchy relations
  epic       Ticket?  @relation("EpicStories", fields: [epicId], references: [id], onDelete: SetNull)
  stories    Ticket[] @relation("EpicStories")
  parent     Ticket?  @relation("ParentSubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  subTasks   Ticket[] @relation("ParentSubTasks")
  archivedBy User?    @relation("TicketArchivedBy", fields: [archivedById], references: [id])
  deletedBy  User?    @relation("TicketDeletedBy", fields: [deletedById], references: [id])

  @@unique([tenantId, ticketNumber])
  @@index([epicId])
  @@index([parentId])
  @@index([projectId, releasePlanId])
  @@index([projectId, sprintPlanId])
  @@index([projectId, demoPlanId])
  @@index([bucketId])
  @@index([projectId, isArchived])
  @@index([tenantId, isArchived])
  @@index([status, isArchived])
  @@index([tenantId, isDeleted])
  @@index([projectId, isDeleted])
  @@index([isDeleted, deletedAt])
  @@map("tickets")
}

model TicketWorkflowStep {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  ticketId         String    @map("ticket_id")
  stepName         String    @map("step_name")
  status           String    @default("not_started")
  assignedTo       String[]  @default([]) @map("assigned_to")
  approvers        String[]  @default([]) @map("approvers")
  approvalStatus   Json      @default("[]") @map("approval_status")
  documents        Json      @default("[]")
  notes            String?
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  completedAt      DateTime? @map("completed_at")
  scheduledMeeting Json?     @map("scheduled_meeting")
  branchName       String?   @map("branch_name")
  testResults      Json      @default("[]") @map("test_results")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_workflow_steps")
}

model TicketComment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  userId      String   @map("user_id")
  comment     String
  attachments Json     @default("[]")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

model TicketRelatedLink {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  linkType    String   @map("link_type")
  title       String
  description String
  url         String
  addedById   String   @map("added_by_id")
  addedAt     DateTime @default(now()) @map("added_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  addedBy     User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_related_links")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  ticketId     String   @map("ticket_id")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type")
  fileUrl      String   @map("file_url")
  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tenantId, ticketId])
  @@index([tenantId, ticketId], map: "idx_attachment_tenant_ticket")
  @@index([ticketId], map: "idx_attachment_ticket")
  @@map("ticket_attachments")
}

model TicketActivityLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  ticketId      String   @map("ticket_id")
  action        String
  performedById String   @map("performed_by_id")
  timestamp     DateTime @default(now())
  details       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  performedBy   User     @relation(fields: [performedById], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_activity_log")
}

model Client {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  contactPerson String?  @map("contact_person")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     User     @relation("ClientCreator", fields: [createdById], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("clients")
}

model ReleasePlan {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  projectId            String                @map("project_id")
  version              String
  description          String?
  status               String                @default("planned")
  releaseDate          DateTime?             @map("release_date")
  createdById          String                @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  type                 String                @default("release_plan")
  goal                 String?
  startedAt            DateTime?             @map("started_at")
  completedAt          DateTime?             @map("completed_at")
  committedPoints      Int                   @default(0) @map("committed_points")
  completedPoints      Int                   @default(0) @map("completed_points")
  endDate              DateTime?             @map("end_date")
  startDate            DateTime?             @map("start_date")
  createdBy            User                  @relation("ReleasePlanCreator", fields: [createdById], references: [id])
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets              Ticket[]              @relation("TicketReleasePlan")
  sprintTickets        Ticket[]              @relation("TicketSprintPlan")
  demoTickets          Ticket[]              @relation("TicketDemoPlan")
  sprintCompletionLogs SprintCompletionLog[]

  @@unique([tenantId, projectId, version])
  @@index([projectId, type, status])
  @@map("release_plans")
}

model Shift {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  name              String
  startTime         String       @map("start_time")
  endTime           String       @map("end_time")
  workingMinutes    Int          @default(480) @map("working_minutes")
  graceMinutes      Int          @default(15) @map("grace_minutes")
  overtimeThreshold Int          @default(60) @map("overtime_threshold")
  breakMinutes      Int          @default(60) @map("break_minutes")
  description       String?
  color             String       @default("#007bff")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  attendance        Attendance[]
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]       @relation("UserShift")

  @@unique([tenantId, name])
  @@map("shifts")
}

model Attendance {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  userId               String            @map("user_id")
  date                 DateTime
  clockIn              DateTime?         @map("clock_in")
  clockOut             DateTime?         @map("clock_out")
  status               String            @default("present")
  shiftId              String?           @map("shift_id")
  totalWorkMinutes     Int               @default(0) @map("total_work_minutes")
  totalBreakMinutes    Int               @default(0) @map("total_break_minutes")
  effectiveWorkMinutes Int               @default(0) @map("effective_work_minutes")
  overtimeMinutes      Int               @default(0) @map("overtime_minutes")
  lateMinutes          Int               @default(0) @map("late_minutes")
  isManualEntry        Boolean           @default(false) @map("is_manual_entry")
  enteredById          String?           @map("entered_by_id")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  enteredBy            User?             @relation("AttendanceEnteredBy", fields: [enteredById], references: [id])
  shift                Shift?            @relation(fields: [shiftId], references: [id])
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks               AttendanceBreak[]

  @@map("attendance")
}

model AttendanceBreak {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  attendanceId    String     @map("attendance_id")
  breakType       String     @map("break_type")
  startTime       DateTime   @map("start_time")
  endTime         DateTime?  @map("end_time")
  durationMinutes Int        @default(0) @map("duration_minutes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendance_breaks")
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  description String
  category    String?
  date        DateTime
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model DropdownOption {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  category  String
  value     String
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category, value])
  @@map("dropdown_options")
}

model StatusUpdate {
