model plans {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(100)
  code       String    @unique @db.VarChar(50)
  status     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model recruitment_client_basic_information {
  id                                                              String                                  @id
  tenant_id                                                       String
  client_name                                                     String?
  account_type                                                    String?
  industry                                                        String?
  website                                                         String?
  company_email                                                   String?
  company_phone                                                   String?
  street                                                          String?
  city                                                            String?
  state                                                           String?
  zip_code                                                        String?
  country                                                         String?
  status                                                          Boolean?                                @default(true)
  notes                                                           String?
  created_at                                                      DateTime?                               @default(now()) @db.Timestamp(6)
  updated_at                                                      DateTime?                               @default(now()) @db.Timestamp(6)
  created_by_id                                                   String?
  updated_by_id                                                   String?
  users_recruitment_client_basic_information_created_by_idTousers User?                                   @relation("recruitment_client_basic_information_created_by_idTousers", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "fk_created_by")
  tenants                                                         Tenant                                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tenant")
  users_recruitment_client_basic_information_updated_by_idTousers User?                                   @relation("recruitment_client_basic_information_updated_by_idTousers", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "fk_updated_by")
  recruitment_client_business_detailes                            recruitment_client_business_detailes[]
  recruitment_client_contact                                      recruitment_client_contact[]
  recruitment_client_hirring_preference                           recruitment_client_hirring_preference[]
  recruitment_client_relationship                                 recruitment_client_relationship[]
}

model recruitment_client_business_detailes {
  id                                                              String                               @id
  recruitment_client_id                                           String
  company_name                                                    String?
  year_established                                                Int?
  revenue_range                                                   String?
  created_at                                                      DateTime?                            @default(now()) @db.Timestamp(6)
  updated_at                                                      DateTime?                            @default(now()) @db.Timestamp(6)
  created_by_id                                                   String?
  updated_by_id                                                   String?
  users_recruitment_client_business_detailes_created_by_idTousers User?                                @relation("recruitment_client_business_detailes_created_by_idTousers", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "fk_created_by")
  recruitment_client_basic_information                            recruitment_client_basic_information @relation(fields: [recruitment_client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recruitment_client")
  users_recruitment_client_business_detailes_updated_by_idTousers User?                                @relation("recruitment_client_business_detailes_updated_by_idTousers", fields: [updated_by_id], references: [id], onUpdate: NoAction, map: "fk_updated_by")
}

model recruitment_client_contact {
  id                                   String                               @id
  recruitment_client_id                String
  person_name                          String
  designation                          String?
  email                                String?
  phone                                String?
  linkedin_url                         String?
  created_at                           DateTime?                            @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?                            @default(now()) @db.Timestamp(6)
  recruitment_client_basic_information recruitment_client_basic_information @relation(fields: [recruitment_client_id], references: [id], onDelete: Cascade, map: "fk_recruitment_client")
}

model recruitment_client_hirring_preference {
  id                                   String                               @id
  recruitment_id                       String
  employment_type                      String?
  work_type                            String?
  hiring_location                      String?
  created_at                           DateTime?                            @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?                            @default(now()) @db.Timestamp(6)
  recruitment_client_basic_information recruitment_client_basic_information @relation(fields: [recruitment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recruitment")
}

model recruitment_client_relationship {
  id                                   String                               @id
  recruitment_client_id                String
  implementation_partner_id            String?
  prime_vendor_id                      String?
  contacts                             String[]
  created_at                           DateTime?                            @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?                            @default(now()) @db.Timestamp(6)
  recruitment_client_basic_information recruitment_client_basic_information @relation(fields: [recruitment_client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recruitment_client_relationship")
}

model reimbursement_approvals {
  id                       String   @id(map: "reimbursement_approval_pkey")
  tenant_id                String
  reimbursement_request_id String
  approver_id              String
  role                     String
  status                   String
  comments                 String?
  created_at               DateTime @default(now())
  updated_at               DateTime
}

model reimbursement_attachments {
  id                        String    @id @default(dbgenerated("gen_random_uuid()"))
  tenant_id                 String
  file_name                 String
  file_size                 Int
  file_type                 String
  file_url                  String
  uploaded_by_id            String
  uploaded_at               DateTime? @default(now()) @db.Timestamp(6)
  created_at                DateTime? @default(now()) @db.Timestamp(6)
  updated_at                DateTime? @default(now()) @db.Timestamp(6)
  reimbursement_request_id  String?
  reimbursement_item_id     String?
  reimbursement_category_id String?
  reimbursement_approval_id String?

  @@index([reimbursement_item_id], map: "idx_ra_item")
  @@index([reimbursement_request_id], map: "idx_ra_request")
}

model ReimbursementCategory {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  maxRequestsPerMonth Decimal? @map("max_per_request") @db.Decimal(10, 2)
  monthlyLimitAmount  Decimal? @map("monthly_limit") @db.Decimal(10, 2)
  yearlyLimitAmount   Decimal? @map("yearly_limit") @db.Decimal(10, 2)
  allowedRoles        String[] @default([]) @map("eligible_roles")
  approvalFlow        String[] @default([]) @map("approval_roles")
  acceptRoles         String[] @default([]) @map("accept_roles")
  attachmentRequired     Boolean  @default(false) @map("attachment_required")
  autoApproveUnderAmount Decimal? @map("auto_approve_under_amount") @db.Decimal(10, 2)
  isActive               Boolean  @default(true) @map("is_active")
  createdBy           String?  @map("created_by_id")
  updatedBy           String?  @map("updated_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  description         String?
  code                String?  @db.VarChar(50)

  @@unique([tenantId, name])
  @@map("reimbursement_categories")
}

model reimbursement_configurations {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.VarChar(255)
  origin        String    @db.VarChar(255)
  sub_origin    String?   @db.VarChar(255)
  category_type String    @db.VarChar(255)
  amount        Decimal   @db.Decimal(10, 2)
  period        String    @db.VarChar(20)
  status        String    @db.VarChar(50)
  created_by_id String    @db.VarChar(255)
  updated_by_id String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model reimbursement_item {
  id                       String   @id @default(dbgenerated("gen_random_uuid()"))
  tenant_id                String
  reimbursement_request_id String
  title                    String?
  date                     DateTime
  amount                   Decimal  @db.Decimal(10, 2)
  bill_no                  String?
  description              String?
  status                   String?
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now())

  @@index([date], map: "idx_item_date")
  @@index([reimbursement_request_id], map: "idx_item_request")
  @@index([tenant_id], map: "idx_item_tenant")
}

model reimbursement_item_approvers {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String              @db.Uuid
  reimbursement_item_id String              @db.Uuid
  level                 Int
  approver_type         String?             @db.VarChar(50)
  approver_id           String              @db.Uuid
  status                String              @default("PENDING")
  acted_at              DateTime?           @db.Timestamp(6)
  remarks               String?
  created_at            DateTime            @default(now()) @db.Timestamp(6)
  updated_at            DateTime            @default(now()) @db.Timestamp(6)
  reimbursement_items   reimbursement_items @relation(fields: [reimbursement_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reimbursement_item")
}

model reimbursement_items {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reimbursement_id             String                         @db.Uuid
  category                     String                         @db.VarChar(100)
  date                         DateTime                       @db.Date
  bill_no                      String                         @db.VarChar(100)
  amount                       Decimal                        @db.Decimal(10, 2)
  description                  String?
  created_at                   DateTime                       @default(now()) @db.Timestamp(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamp(6)
  status                       String?                        @default("SUBMITTED")
  reimbursement_item_approvers reimbursement_item_approvers[]
}

model reimbursement_policies {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  origin_type   String    @db.VarChar(50)
  origin_id     String    @db.Uuid
