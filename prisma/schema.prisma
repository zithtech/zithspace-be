enum InvoiceStatus {
  DRAFT
  PENDING
  APPROVAL
  SENT
  SUBMITTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

enum InvoiceType {
  STANDARD
  PROFORMA
  CREDIT
  TAX
  DEBIT
  RECURRING

  @@map("invoice_type")
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("recurring_frequency")
}

model Invoice {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  invoiceNumber    String @unique @map("invoice_number")
  customerId       String @map("customer_id")
  customerSnapshot Json?  @map("customer_snapshot")

  invoiceDate   DateTime      @map("invoice_date")
  dueDate       DateTime      @map("due_date")
  invoiceType   InvoiceType   @default(STANDARD) @map("invoice_type")
  status        InvoiceStatus @default(DRAFT)
  description   String?       @db.Text // Add this line
  deletedAt     DateTime?     @map("deleted_at")
  deletedBy     String?       @map("deleted_by")
  deletedByUser User?         @relation("InvoiceDeletedBy", fields: [deletedBy], references: [id])

  currency           String
  recurringFrequency RecurringFrequency? @map("recurring_frequency")

  taxInclusive     Boolean   @default(false) @map("tax_inclusive")
  discount         Decimal   @default(0) @db.Decimal(15, 2)
  subtotal         Decimal   @db.Decimal(15, 2)
  taxTotal         Decimal   @map("tax_total") @db.Decimal(15, 2)
  total            Decimal   @db.Decimal(15, 2)
  paidAmount       Decimal   @default(0) @map("paid_amount")
  balanceDue       Decimal   @map("balance_due") @db.Decimal(15, 2)
  firstPaymentDate DateTime? @map("first_payment_date")
  lastPaymentDate  DateTime? @map("last_payment_date")
  fullyPaidDate    DateTime? @map("fully_paid_date")

  notes String? @db.Text
  terms String? @db.Text

  sentAt      DateTime? @map("sent_at")
  paidAt      DateTime? @map("paid_at")
  cancelledAt DateTime? @map("cancelled_at")

  pdfUrl   String?          @map("pdf_url") @db.Text
  payments InvoicePayment[]

  // Audit fields
  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer         @relation(fields: [customerId], references: [id])
  settingsProfileId String?          @map("settings_profile_id")
  settingsProfile   SettingsProfile? @relation(fields: [settingsProfileId], references: [id])
  items             InvoiceItem[]

  // User audit relations
  createdByUser User  @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("InvoiceUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tenantId, invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([firstPaymentDate])
  @@index([lastPaymentDate])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  invoiceId String @map("invoice_id")

  item        String
  description String? @db.Text
  qty         Int     @default(1)

  price     Decimal   @default(0) @db.Decimal(15, 2)
  tax       Decimal   @default(0) @db.Decimal(15, 2) // percentage
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  // Audit fields
  createdBy String   @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  // User audit relations
  createdByUser User  @relation("InvoiceItemCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("InvoiceItemUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("InvoiceItemDeletedBy", fields: [deletedBy], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_items")
}

enum PaymentMethod {
