generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String                @id @default(uuid())
  name                String
  subdomain           String                @unique
  planType            String                @default("basic") @map("plan_type")
  maxUsers            Int                   @default(10) @map("max_users")
  isActive            Boolean               @default(true) @map("is_active")
  settings            Json?                 @default("{}")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  attendance          Attendance[]
  attendanceBreaks    AttendanceBreak[]
  buckets             Bucket[]
  clients             Client[]
  dropdownOptions     DropdownOption[]
  leaves              Leave[]
  fixedHolidays       FixedHoliday[]
  projects            Project[]
  releasePlans        ReleasePlan[]
  shifts              Shift[]
  sprintCompletionLogs SprintCompletionLog[]
  statusUpdates       StatusUpdate[]
  ticketActivityLog   TicketActivityLog[]
  ticketAttachments   TicketAttachment[]
  ticketComments      TicketComment[]
  ticketRelatedLinks  TicketRelatedLink[]
  ticketWorkflowSteps TicketWorkflowStep[]
  tickets             Ticket[]
  transactions        Transaction[]
  users               User[]
  documenthub         DocumentHub[]
  documents           Document[]
  documenttree        DocumentTree[]
  documentHistory     DocumentHistory[]
  
  // ZithTech Calls Relations
  channels            Channel[]
  meetings            Meeting[]
  

  @@map("tenants")
}

model User {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  name                 String
  workEmail            String              @map("work_email")
  personalEmail        String              @map("personal_email")
  phone                String
  passwordHash         String              @map("password_hash")
  role                 String              @default("user")
  position             String
  reportsToId          String?             @map("reports_to_id")
  dateOfBirth          DateTime?           @map("date_of_birth")
  workDays             Int[]               @default([1, 2, 3, 4, 5]) @map("work_days")
  assignedShiftId      String?             @map("assigned_shift_id")
  shiftAssignedById    String?             @map("shift_assigned_by_id")
  shiftAssignedDate    DateTime?           @map("shift_assigned_date")
  isActive             Boolean             @default(true) @map("is_active")
  lastLoginAt          DateTime?           @map("last_login_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  enteredAttendance    Attendance[]        @relation("AttendanceEnteredBy")
  attendance           Attendance[]
  createdClients       Client[]            @relation("ClientCreator")
  leaves               Leave[]             @relation("UserLeaves")
  approvedLeaves       Leave[]             @relation("LeaveApprover")
  projectMemberships   ProjectMember[]
  createdProjects      Project[]           @relation("ProjectCreator")
  managedProjects      Project[]           @relation("ProjectManager")
  refreshTokens        RefreshToken[]
  createdReleasePlans  ReleasePlan[]       @relation("ReleasePlanCreator")
  statusUpdates        StatusUpdate[]      @relation("UserStatusUpdates")
  performedActivityLog TicketActivityLog[]
  ticketAttachments    TicketAttachment[]
  ticketComments       TicketComment[]
  addedRelatedLinks    TicketRelatedLink[]
  documenthub          DocumentHub[]
  documents            Document[]
  documentHistory      DocumentHistory[]
  documenttree         DocumentTree[]
  assignedTickets      Ticket[]            @relation("TicketAssignee")
  createdTickets       Ticket[]            @relation("TicketCreator")
  reportToTickets      Ticket[]            @relation("TicketReportTo")
  archivedTickets      Ticket[]            @relation("TicketArchivedBy")
  deletedTickets       Ticket[]            @relation("TicketDeletedBy")
  createdBuckets       Bucket[]            @relation("BucketCreator")
  bucketMemberships    BucketMember[]
  createdFixedHolidays FixedHoliday[]      @relation("FixedHolidayCreator")
  updatedFixedHolidays FixedHoliday[]      @relation("FixedHolidayUpdater")
  sprintCompletionLogs SprintCompletionLog[]
  transactions         Transaction[]
  assignedShift        Shift?              @relation("UserShift", fields: [assignedShiftId], references: [id])
  reportsTo            User?               @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates         User[]              @relation("UserHierarchy")
  shiftAssignedBy      User?               @relation("ShiftAssigner", fields: [shiftAssignedById], references: [id])
  assignedShifts       User[]              @relation("ShiftAssigner")
  
  // ZithTech Calls Relations
  createdChannels      Channel[]           @relation("ChannelCreator")
  channelMemberships   ChannelMember[]
  channelMessages      ChannelMessage[]
  createdMeetings      Meeting[]           @relation("MeetingCreator")
  meetingParticipations MeetingParticipant[]

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
// ---------------- TIMESHEETS ----------------

  // Owner of timesheets
  timesheets Timesheet[]

  // Approved timesheets
  approvedTimesheets Timesheet[] @relation("TimesheetApprover")

  // Created timesheets
  createdTimesheets Timesheet[] @relation("TimesheetCreator")

  // Updated timesheets
  updatedTimesheets Timesheet[] @relation("TimesheetUpdater")

  // ---------------- TIMESHEET ROWS ----------------

  createdTimesheetRows TimesheetRow[] @relation("TimesheetRowCreator")
  updatedTimesheetRows TimesheetRow[] @relation("TimesheetRowUpdater")

 

  @@unique([tenantId, workEmail])
  @@unique([tenantId, personalEmail])
  @@unique([tenantId, phone])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  name                 String
  code                 String?               @unique
  description          String
  status               String                @default("active")
  startDate            DateTime              @map("start_date")
  endDate              DateTime?             @map("end_date")
  projectManagerId     String                @map("project_manager_id")
  repositories         Json?                 @default("[]")
  workflowTemplate     String[]              @map("workflow_template")
  defaultPriority      String                @default("medium") @map("default_priority")
  totalTickets         Int                   @default(0) @map("total_tickets")
  completedTickets     Int                   @default(0) @map("completed_tickets")
  inProgressTickets    Int                   @default(0) @map("in_progress_tickets")
  createdById          String                @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  members              ProjectMember[]
  buckets              Bucket[]
  createdBy            User                  @relation("ProjectCreator", fields: [createdById], references: [id])
  projectManager       User                  @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasePlans         ReleasePlan[]
  sprintCompletionLogs SprintCompletionLog[]
  tickets              Ticket[]
  workEntries          WorkEntry[]
  documenthub          DocumentHub[]

  @@unique([tenantId, code])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Ticket {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  projectId           String               @map("project_id")
  releasePlanId       String?              @map("release_plan_id")
  sprintPlanId        String?              @map("sprint_plan_id")
  demoPlanId          String?              @map("demo_plan_id")
  bucketId            String?              @map("bucket_id")
  title               String
  description         String?
  ticketNumber        String               @map("ticket_number")
  status              String               @default("not_started")
  priority            String               @default("Medium (P2)")
  type                String               @default("Task")
  platform            String               @default("Development")
  stack               String?
  taskLevel           String               @default("Medium") @map("task_level")
  storyPoint          Int                  @default(1) @map("story_point")
  estimateHours       Decimal              @default(0) @map("estimate_hours") @db.Decimal(5, 2)
  assigneeId          String?              @map("assignee_id")
  reportToId          String?              @map("report_to_id")
  createdById         String               @map("created_by_id")
  parentTickets       String[]             @default([]) @map("parent_tickets")
  parentTicketNotes   String?              @map("parent_ticket_notes")
  currentWorkflowStep String               @default("Scope Document") @map("current_workflow_step")
  startDate           DateTime?            @map("start_date")
  endDate             DateTime?            @map("end_date")
  dueDate             DateTime?            @map("due_date")
  completedAt         DateTime?            @map("completed_at")
  tags                String[]             @default([])
  metadata            Json?                @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  
  // Archive fields
  isArchived          Boolean              @default(false) @map("is_archived")
  archivedAt          DateTime?            @map("archived_at")
  archivedById        String?              @map("archived_by_id")
  
  // Soft delete / Trash fields
  isDeleted           Boolean              @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at")
  deletedById         String?              @map("deleted_by_id")
  
  // Hierarchy fields for Epic/Story/Sub-task support
  epicId              String?              @map("epic_id")
  parentId            String?              @map("parent_id")
  rank                String?              // Lexicographic rank for drag-drop ordering
  
  // Relations
  activityLog         TicketActivityLog[]
  attachments         TicketAttachment[]
  comments            TicketComment[]
  relatedLinks        TicketRelatedLink[]
  workflowSteps       TicketWorkflowStep[]
  documenthub         DocumentHub[]
  assignee            User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy           User                 @relation("TicketCreator", fields: [createdById], references: [id])
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasePlan         ReleasePlan?         @relation("TicketReleasePlan", fields: [releasePlanId], references: [id])
  sprintPlan          ReleasePlan?         @relation("TicketSprintPlan", fields: [sprintPlanId], references: [id])
  demoPlan            ReleasePlan?         @relation("TicketDemoPlan", fields: [demoPlanId], references: [id])
  bucket              Bucket?              @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  reportTo            User?                @relation("TicketReportTo", fields: [reportToId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workEntries         WorkEntry[]
  
  // Hierarchy relations
  epic                Ticket?              @relation("EpicStories", fields: [epicId], references: [id], onDelete: SetNull)
  stories             Ticket[]             @relation("EpicStories")
  parent              Ticket?              @relation("ParentSubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  subTasks            Ticket[]             @relation("ParentSubTasks")
  archivedBy          User?                @relation("TicketArchivedBy", fields: [archivedById], references: [id])
  deletedBy           User?                @relation("TicketDeletedBy", fields: [deletedById], references: [id])

  @@unique([tenantId, ticketNumber])
  @@index([epicId])
  @@index([parentId])
  @@index([projectId, releasePlanId])
  @@index([projectId, sprintPlanId])
  @@index([projectId, demoPlanId])
  @@index([bucketId])
  @@index([projectId, isArchived])
  @@index([tenantId, isArchived])
  @@index([status, isArchived])
  @@index([tenantId, isDeleted])
  @@index([projectId, isDeleted])
  @@index([isDeleted, deletedAt])
  @@map("tickets")
}

model TicketWorkflowStep {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  ticketId         String    @map("ticket_id")
  stepName         String    @map("step_name")
  status           String    @default("not_started")
  assignedTo       String[]  @default([]) @map("assigned_to")
  approvers        String[]  @default([]) @map("approvers")
  approvalStatus   Json      @default("[]") @map("approval_status")
  documents        Json      @default("[]")
  notes            String?
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  completedAt      DateTime? @map("completed_at")
  scheduledMeeting Json?     @map("scheduled_meeting")
  branchName       String?   @map("branch_name")
  testResults      Json      @default("[]") @map("test_results")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_workflow_steps")
}

model TicketComment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  userId      String   @map("user_id")
  comment     String
  attachments Json     @default("[]")
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

model TicketRelatedLink {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  ticketId    String   @map("ticket_id")
  linkType    String   @map("link_type")
  title       String
  description String
  url         String
  addedById   String   @map("added_by_id")
  addedAt     DateTime @default(now()) @map("added_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  addedBy     User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_related_links")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  ticketId     String   @map("ticket_id")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type")
  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tenantId, ticketId])
  @@map("ticket_attachments")
}

model TicketActivityLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  ticketId      String   @map("ticket_id")
  action        String
  performedById String   @map("performed_by_id")
  timestamp     DateTime @default(now())
  details       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  performedBy   User     @relation(fields: [performedById], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_activity_log")
}

model Client {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  contactPerson String?  @map("contact_person")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     User     @relation("ClientCreator", fields: [createdById], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("clients")
}

model ReleasePlan {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  projectId            String                @map("project_id")
  version              String
  description          String?
  status               String                @default("planned")
  startDate            DateTime?             @map("start_date")
  endDate              DateTime?             @map("end_date")
  releaseDate          DateTime?             @map("release_date")
  createdById          String                @map("created_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  createdBy            User                  @relation("ReleasePlanCreator", fields: [createdById], references: [id])
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets              Ticket[]              @relation("TicketReleasePlan")
  sprintTickets        Ticket[]              @relation("TicketSprintPlan")
  demoTickets          Ticket[]              @relation("TicketDemoPlan")
  sprintCompletionLogs SprintCompletionLog[]

  // Type of plan: sprint_plan, demo_plan, release_plan
  type        String    @default("release_plan")
  
  // Sprint management fields
  goal            String?   // Sprint goal/objective
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  committedPoints Int       @default(0) @map("committed_points")
  completedPoints Int       @default(0) @map("completed_points")

  @@unique([tenantId, projectId, version])
  @@index([projectId, type, status])
  @@map("release_plans")
}

model Shift {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  name              String
  startTime         String       @map("start_time")
  endTime           String       @map("end_time")
  workingMinutes    Int          @default(480) @map("working_minutes")
  graceMinutes      Int          @default(15) @map("grace_minutes")
  overtimeThreshold Int          @default(60) @map("overtime_threshold")
  breakMinutes      Int          @default(60) @map("break_minutes")
  description       String?
  color             String       @default("#007bff")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  attendance        Attendance[]
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]       @relation("UserShift")

  @@unique([tenantId, name])
  @@map("shifts")
}

model Attendance {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  userId               String            @map("user_id")
  date                 DateTime
  clockIn              DateTime?         @map("clock_in")
  clockOut             DateTime?         @map("clock_out")
  status               String            @default("present")
  shiftId              String?           @map("shift_id")
  totalWorkMinutes     Int               @default(0) @map("total_work_minutes")
  totalBreakMinutes    Int               @default(0) @map("total_break_minutes")
  effectiveWorkMinutes Int               @default(0) @map("effective_work_minutes")
  overtimeMinutes      Int               @default(0) @map("overtime_minutes")
  lateMinutes          Int               @default(0) @map("late_minutes")
  isManualEntry        Boolean           @default(false) @map("is_manual_entry")
  enteredById          String?           @map("entered_by_id")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  enteredBy            User?             @relation("AttendanceEnteredBy", fields: [enteredById], references: [id])
  shift                Shift?            @relation(fields: [shiftId], references: [id])
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks               AttendanceBreak[]

  @@unique([tenantId, userId, date])
  @@map("attendance")
}

model AttendanceBreak {
  id              String     @id @default(uuid())
  tenantId        String     @map("tenant_id")
  attendanceId    String     @map("attendance_id")
  breakType       String     @map("break_type")
  startTime       DateTime   @map("start_time")
  endTime         DateTime?  @map("end_time")
  durationMinutes Int        @default(0) @map("duration_minutes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendance_breaks")
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  description String
  category    String?
  date        DateTime
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model DropdownOption {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  category  String
  value     String
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category, value])
  @@map("dropdown_options")
}

model StatusUpdate {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  tenantId         String      @map("tenant_id")
  date             DateTime    @db.Date
  projectUpdates   Json        @default("[]") @map("project_updates")
  mood             String?
  totalHoursWorked Decimal?    @map("total_hours_worked") @db.Decimal(5, 2)
  generalNotes     String?     @map("general_notes")
  submittedAt      DateTime    @default(now()) @map("submitted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User        @relation("UserStatusUpdates", fields: [userId], references: [id], onDelete: Cascade)
  workEntries      WorkEntry[]

  @@unique([userId, date, tenantId])
  @@index([tenantId, date])
  @@index([userId, date])
  @@map("status_updates")
}

model WorkEntry {
  id             String       @id @default(uuid())
  statusUpdateId String       @map("status_update_id")
  projectId      String       @map("project_id")
  ticketId       String?      @map("ticket_id")
  startTime      DateTime     @map("start_time")
  endTime        DateTime     @map("end_time")
  hoursWorked    Decimal      @map("hours_worked") @db.Decimal(5, 2)
  workSummary    String       @map("work_summary")
  status         String
  blockers       String?
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  project        Project      @relation(fields: [projectId], references: [id])
  statusUpdate   StatusUpdate @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id])

  @@map("work_entries")
}

model Leave {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  type            String    // sick_leave, casual_leave, paid_leave, unpaid_leave, work_from_home, permission
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  duration        Decimal   @db.Decimal(5, 2)
  durationType    String    @map("duration_type") // FULL_DAY, HALF_DAY, HOURS
  reason          String
  status          String    @default("pending") // pending, approved, rejected, cancelled
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  attachments     Json      @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy      User?     @relation("LeaveApprover", fields: [approvedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model FixedHoliday {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  holidayName String
  country   String
  state     String[]
  fromDate  DateTime @map("from_date")
  toDate    DateTime @map("to_date")
  type      String
  rule      String
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("FixedHolidayCreator", fields: [createdById], references: [id])
  updatedBy User?    @relation("FixedHolidayUpdater", fields: [updatedById], references: [id])

  @@map("fixed_holidays")
}

model Bucket {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  projectId   String?        @map("project_id")
  name        String
  description String?
  color       String?        @default("#6366f1") // Default indigo color
  isShared    Boolean        @default(false) @map("is_shared") // Collaborative bucket
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("BucketCreator", fields: [createdById], references: [id])
  tickets     Ticket[]
  members     BucketMember[]

  @@unique([tenantId, projectId, name])
  @@index([tenantId])
  @@index([projectId])
  @@index([createdById])
  @@map("buckets")
}

model BucketMember {
  id        String   @id @default(uuid())
  bucketId  String   @map("bucket_id")
  userId    String   @map("user_id")
  role      String   @default("member") // owner, editor, member
  addedAt   DateTime @default(now()) @map("added_at")
  
  // Relations
  bucket    Bucket   @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bucketId, userId])
  @@index([bucketId])
  @@index([userId])
  @@map("bucket_members")
}

model SprintCompletionLog {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  sprintPlanId      String   @map("sprint_plan_id")
  projectId         String   @map("project_id")
  ticketId          String   @map("ticket_id")
  action            String   // moved_to_sprint, moved_to_bucket, moved_to_backlog, moved_to_trash
  destinationId     String?  @map("destination_id") // Sprint ID, Bucket ID, or null for backlog/trash
  destinationType   String?  @map("destination_type") // sprint, bucket, backlog, trash
  performedById     String   @map("performed_by_id")
  performedAt       DateTime @default(now()) @map("performed_at")
  metadata          Json?    @default("{}") // Additional context (previous state, notes, etc.)
  
  // Relations
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprintPlan        ReleasePlan @relation(fields: [sprintPlanId], references: [id], onDelete: Cascade)
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  performedBy       User        @relation(fields: [performedById], references: [id])

  @@index([sprintPlanId])
  @@index([projectId])
  @@index([ticketId])
  @@index([tenantId])
  @@index([performedAt])
  @@map("sprint_completion_logs")
}


enum DocumentNodeType {
  section
  folder
  file
}
model DocumentHub {
  id           String   @id @default(uuid())
  tenantId     String
  name         String

  projectId    String?
  ticketId     String?

  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket       Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documents    Document[]
  treeNodes    DocumentTree[]

  @@index([tenantId])
  @@index([projectId])
  @@index([ticketId])
  @@index([createdById])
  @@map("document_hub")
}
model Document {
  id            String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentHubId String
  documentHub   DocumentHub @relation(fields: [documentHubId], references: [id], onDelete: Cascade)

  title         String
  content       Json

  treeNode      DocumentTree?

  createdById   String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       DocumentHistory[]

  @@index([documentHubId])
  @@map("documents")

}
model DocumentTree {
  id            String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentHubId String
  documentHub   DocumentHub @relation(fields: [documentHubId], references: [id], onDelete: Cascade)

  title         String
  type          DocumentNodeType

  parentId      String?
  parent        DocumentTree? @relation("TreeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      DocumentTree[] @relation("TreeChildren")

  // Only set when type = file
  documentId    String? @unique
  document      Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  position      Int      @default(0)

  createdById   String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)


  createdAt     DateTime @default(now())

  @@index([documentHubId])
  @@index([parentId])
  @@map("documenttree")

}

model DocumentHistory {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  content       Json
  
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([documentId])
  @@index([createdById])
  @@map("document_history")
}

// --------------------------------------
// ZithTech Calls (Chat & Meeting) Models
// --------------------------------------

model Channel {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String?  // Optional for DMs
  description String?
  type        String   @default("CHANNEL") // CHANNEL, DM, GROUP
  
  isArchived  Boolean  @default(false) @map("is_archived")
  
  lastMessageAt DateTime? @map("last_message_at")
  
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ChannelCreator", fields: [createdById], references: [id])
  
  members     ChannelMember[]
  messages    ChannelMessage[]
  meetings    Meeting[]

  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String   @map("channel_id")
  userId    String   @map("user_id")
  role      String   @default("member") // owner, admin, member
  joinedAt  DateTime @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

model ChannelMessage {
  id          String   @id @default(uuid())
  channelId   String   @map("channel_id")
  userId      String   @map("user_id")
  content     String   // Text content
  type        String   @default("text") // text, system, file
  attachments Json     @default("[]")
  
  isEdited    Boolean  @default(false) @map("is_edited")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("channel_messages")
}

model Meeting {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  channelId   String   @map("channel_id")
  title       String
  
  status      String   @default("scheduled") // scheduled, active, completed, cancelled
  
  startedAt   DateTime? @map("started_at")
  endedAt     DateTime? @map("ended_at")
  
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("MeetingCreator", fields: [createdById], references: [id])
  
  participants MeetingParticipant[]

  @@map("meetings")
}

model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String   @map("meeting_id")
  userId    String   @map("user_id")
  
  status    String   @default("joined") // joined, left
  role      String   @default("participant") // host, presenter, participant
  
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_participants")
}


enum timesheet_status {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}



model Timesheet {
  id            String          @id @default(cuid())
  tenantId    String   @map("tenant_id")

  // Owner of the timesheet (employee)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String          @map("user_id")

  weekStart     DateTime        @map("week_start")
  weekEnd       DateTime        @map("week_end")

  status        timesheet_status @default(DRAFT)
  totalHours    Float           @map("total_hours")

  // Approval
  rejectReason  String?         @map("reject_reason")
  approvedById  String?         @map("approved_by_id")
  approvedBy    User?           @relation("TimesheetApprover",fields: [approvedById],references: [id])

  // Audit fields
  createdById   String          @map("created_by_id")
  createdBy     User            @relation("TimesheetCreator", fields: [createdById], references: [id])

  updatedById   String?         @map("updated_by_id")
  updatedBy     User?           @relation("TimesheetUpdater",fields: [updatedById],references: [id])

  rows          TimesheetRow[]

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt      @map("updated_at")

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("timesheets")
}

model TimesheetRow {
  id            String     @id @default(cuid())
  tenantId    String   @map("tenant_id")

  // Parent timesheet
  timesheet     Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  timesheetId   String    @map("timesheet_id")

  day           DateTime
  projectName   String    @map("project_name")
  taskName      String    @map("task_name")
  description   String?

  hours         Float
  billable      Boolean   @default(false)

  // Audit fields
  createdById   String    @map("created_by_id")
  createdBy     User      @relation("TimesheetRowCreator",fields: [createdById],references: [id])

  updatedById   String?   @map("updated_by_id")
  updatedBy     User?     @relation( "TimesheetRowUpdater", fields: [updatedById], references: [id] )

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  @@index([timesheetId])
  @@index([createdById])
  @@index([updatedById])
  @@map("timesheet_rows")
}
