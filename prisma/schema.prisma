model EmailLog {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // Module information - identifies which module the email belongs to
  module       String // INVOICE, ESTIMATE, RECEIPT, CONTRACT, etc.
  moduleId     String  @map("module_id") // ID of the related record
  moduleNumber String? @map("module_number")

  // Email details
  to        String  @map("to_email")
  from      String  @map("from_email")
  fromName  String? @map("from_name")
  subject   String
  html      String  @db.Text // Full email HTML - exactly as sent
  plainText String? @map("plain_text") @db.Text

  // Customer/Recipient info (denormalized - snapshot at time of sending)
  customerId    String? @map("customer_id")
  customerName  String? @map("customer_name")
  customerEmail String? @map("customer_email")

  // Invoice specific fields (denormalized)
  amount   String? // Formatted amount: "$1,250.00"
  dueDate  String? @map("due_date") // Formatted date: "May 15, 2024"
  currency String? @default("USD")

  // Attachment info
  hasAttachment  Boolean @default(false) @map("has_attachment")
  attachmentUrl  String? @map("attachment_url") @db.Text
  attachmentName String? @map("attachment_name")

  // Status tracking
  status       String  @default("SENT") // SENT, FAILED, OPENED, CLICKED, BOUNCED
  errorMessage String? @map("error_message") @db.Text

  // Tracking timestamps
  sentAt    DateTime  @default(now()) @map("sent_at")
  openedAt  DateTime? @map("opened_at")
  clickedAt DateTime? @map("clicked_at")

  // User who sent the email
  sentBy     String  @map("sent_by") // User ID
  sentByUser String? @map("sent_by_user") // User name/email

  // Metadata - store any additional module-specific data
  metadata Json? // Flexible field for future needs

  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer? @relation(fields: [customerId], references: [id])
  sentByUserRel User      @relation("EmailSentBy", fields: [sentBy], references: [id])

  // Indexes for fast queries
  @@index([tenantId, sentAt])
  @@index([module, moduleId])
  @@index([module, sentAt])
  @@index([customerId])
  @@index([to])
  @@index([status])
  @@index([sentAt])
  @@map("email_logs")
}

model Employee {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id")

  employee_code  String   @db.VarChar(30)
  first_name     String   @db.VarChar(100)
  last_name      String   @db.VarChar(100)
  gender         String   @db.VarChar(20)
  date_of_birth  DateTime @db.Date
  blood_group    String?  @db.VarChar(10)
