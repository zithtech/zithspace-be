model CalendarEventException {
  id String @id @default(cuid())

  eventId  String @map("event_id")
  tenantId String @map("tenant_id")
  userId   String @map("user_id")

  overrideTitle       String? @map("override_title")
  overrideDescription String? @map("override_description")
  overrideLocation    String? @map("override_location")
  overrideMeetingLink String? @map("override_meeting_link")
  overrideAttendees   Json?   @map("override_attendees")

  // Audit fields
  createdById String  @map("created_by")
  updatedById String? @map("updated_by")

  // The original occurrence date (before modification)
  originalDate DateTime @map("original_date") @db.Timestamptz(6)

  // If occurrence is modified
  newStartTime DateTime? @map("new_start_time") @db.Timestamptz(6)
  newEndTime   DateTime? @map("new_end_time") @db.Timestamptz(6)

  // If occurrence is deleted
  isCancelled Boolean @default(false) @map("is_cancelled")

  // Provider instance ID
  externalInstanceId String? @map("external_instance_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdBy User  @relation("ExceptionCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("ExceptionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([eventId, originalDate])
  @@index([eventId])
  @@index([tenantId])
  @@map("calendar_event_exceptions")
}

// =====================================================
//  RBAC — Role-Based Access Control
// =====================================================

/// All possible permission strings in the system.
/// Seeded once on migration; never modified at runtime.
model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. "ticket.create"
  resource    String // e.g. "ticket"
  action      String // e.g. "create"
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

/// A named collection of permissions, scoped to a tenant.
/// System roles (isSystem = true) cannot be deleted.
model Role {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String // e.g. "HR Manager"
  slug        String // e.g. "hr_manager"
  description String?
  isSystem    Boolean @default(false) @map("is_system") // protected from deletion
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

/// Join table: which permissions a role has.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  grantedAt   DateTime @default(now()) @map("granted_at")
  grantedById String?  @map("granted_by_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Join table: which roles a user has (supports optional expiry for temporary roles).
model UserRole {
  userId   String @map("user_id")
  roleId   String @map("role_id")
  tenantId String @map("tenant_id")

  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedById String?   @map("assigned_by_id")
  expiresAt    DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId, tenantId])
  @@map("user_roles")
}

/// Audit trail for every authorization decision.
model AuthorizationLog {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  userId     String? @map("user_id")
  permission String // permission checked
  resource   String
  resourceId String? @map("resource_id")
  result     String // "granted" | "denied"
  reason     String?
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  endpoint   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([createdAt])
  @@map("authorization_logs")
}

