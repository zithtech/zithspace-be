  reverseCharge        Boolean   @default(false) @map("reverse_charge_applicable")
  accountManagerId     String?   @map("account_manager_id") @db.Uuid
  salesOwnerId         String?   @map("sales_owner_id") @db.Uuid
  deliveryOwnerId      String?   @map("delivery_owner_id") @db.Uuid
  clientSegment        String?   @map("client_segment")
  contractStartDate    DateTime? @map("contract_start_date")
  contractEndDate      DateTime? @map("contract_end_date")
  renewalType          String?   @map("renewal_type")
  slaLevel             String?   @map("sla_level")
  bankName             String?   @map("bank_name")
  bankAccountNumber    String?   @map("bank_account_number")
  ifscSwift            String?   @map("ifsc_swift")
  currencyOfPayment    String?   @map("currency_of_payment")
  preferredPaymentMode String?   @map("preferred_payment_mode")

  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy      User                         @relation("ClientV2Creator", fields: [createdById], references: [id])
  parentClient   ClientV2?                    @relation("ParentClient", fields: [parentId], references: [id])
  childClients   ClientV2[]                   @relation("ParentClient")
  accountManager Employee?                    @relation("AccountManager", fields: [accountManagerId], references: [id])
  salesOwner     Employee?                    @relation("SalesOwner", fields: [salesOwnerId], references: [id])
  deliveryOwner  Employee?                    @relation("DeliveryOwner", fields: [deliveryOwnerId], references: [id])
