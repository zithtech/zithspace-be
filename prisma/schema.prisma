  mail_messages                               mail_messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mail_attachments_message")
  tenants                                     Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mail_attachments_tenant")
  users_mail_attachments_updated_by_idTousers User?         @relation("mail_attachments_updated_by_idTousers", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mail_attachments_updated_by")

  @@index([message_id], map: "idx_mail_attachments_message_id")
  @@index([tenant_id], map: "idx_mail_attachments_tenant_id")
}

model mail_messages {
  id                                       String             @id
  account_id                               String
  thread_id                                String?
  tenant_id                                String
  external_id                              String
  subject                                  String?
  from_email                               String
  to_emails                                Json
  cc_emails                                Json?
  bcc_emails                               Json?
  body_html                                String?
  body_text                                String?
  snippet                                  String?
  is_read                                  Boolean?           @default(false)
  is_sent                                  Boolean?           @default(false)
  has_attachments                          Boolean?           @default(false)
  labels                                   String[]           @default([])
  received_at                              DateTime?          @db.Timestamptz(6)
  sent_at                                  DateTime?          @db.Timestamptz(6)
  scheduled_at                             DateTime?          @db.Timestamptz(6)
  created_by_id                            String?
  updated_by_id                            String?
  created_at                               DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime?          @default(now()) @db.Timestamptz(6)
  mail_attachments                         mail_attachments[]
  mail_accounts                            mail_accounts      @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mail_messages_account")
  users_mail_messages_created_by_idTousers User?              @relation("mail_messages_created_by_idTousers", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mail_messages_created_by")
  tenants                                  Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mail_messages_tenant")
  mail_threads                             mail_threads?      @relation(fields: [thread_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mail_messages_thread")
  users_mail_messages_updated_by_idTousers User?              @relation("mail_messages_updated_by_idTousers", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mail_messages_updated_by")

  @@unique([external_id, account_id], map: "mail_messages_external_id_account_unique")
  @@index([account_id], map: "idx_mail_messages_account_id")
  @@index([tenant_id], map: "idx_mail_messages_tenant_id")
  @@index([thread_id], map: "idx_mail_messages_thread_id")
}

