  description String?
  location    String?

  startTime   DateTime @db.Timestamptz(6)  @map("start_time")
  endTime     DateTime @db.Timestamptz(6)  @map("end_time")

  isAllDay    Boolean  @default(false)  @map("is_all_day")
  isRecurring Boolean  @default(false)  @map("is_recurring")
  rrule       String?
  exdate      Json?
