  country   String
  state     String[]
  fromDate  DateTime @map("from_date")
  toDate    DateTime @map("to_date")
  type      String
  rule      String
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("FixedHolidayCreator", fields: [createdById], references: [id])
  updatedBy User?    @relation("FixedHolidayUpdater", fields: [updatedById], references: [id])

  @@map("fixed_holidays")
}

model Bucket {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  projectId   String?        @map("project_id")
  name        String
  description String?
  color       String?        @default("#6366f1") // Default indigo color
  isShared    Boolean        @default(false) @map("is_shared") // Collaborative bucket
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("BucketCreator", fields: [createdById], references: [id])
  tickets     Ticket[]
  members     BucketMember[]

  @@unique([tenantId, projectId, name])
  @@index([tenantId])
  @@index([projectId])
  @@index([createdById])
  @@map("buckets")
}

model BucketMember {
  id        String   @id @default(uuid())
  bucketId  String   @map("bucket_id")
  userId    String   @map("user_id")
  role      String   @default("member") // owner, editor, member
  addedAt   DateTime @default(now()) @map("added_at")
  
  // Relations
  bucket    Bucket   @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bucketId, userId])
  @@index([bucketId])
  @@index([userId])
  @@map("bucket_members")
}

model SprintCompletionLog {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  sprintPlanId      String   @map("sprint_plan_id")
  projectId         String   @map("project_id")
  ticketId          String   @map("ticket_id")
  action            String   // moved_to_sprint, moved_to_bucket, moved_to_backlog, moved_to_trash
  destinationId     String?  @map("destination_id") // Sprint ID, Bucket ID, or null for backlog/trash
  destinationType   String?  @map("destination_type") // sprint, bucket, backlog, trash
  performedById     String   @map("performed_by_id")
  performedAt       DateTime @default(now()) @map("performed_at")
  metadata          Json?    @default("{}") // Additional context (previous state, notes, etc.)
  
  // Relations
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprintPlan        ReleasePlan @relation(fields: [sprintPlanId], references: [id], onDelete: Cascade)
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  performedBy       User        @relation(fields: [performedById], references: [id])

  @@index([sprintPlanId])
  @@index([projectId])
  @@index([ticketId])
  @@index([tenantId])
  @@index([performedAt])
  @@map("sprint_completion_logs")
}


enum DocumentNodeType {
  section
  folder
  file
}
model DocumentHub {
  id           String   @id @default(uuid())
  tenantId     String
  name         String

  projectId    String?
  ticketId     String?

  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket       Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documents    Document[]
  treeNodes    DocumentTree[]

  @@index([tenantId])
  @@index([projectId])
  @@index([ticketId])
  @@index([createdById])
  @@map("document_hub")
}
model Document {
  id            String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentHubId String
  documentHub   DocumentHub @relation(fields: [documentHubId], references: [id], onDelete: Cascade)

  title         String
  content       Json

  treeNode      DocumentTree?

  createdById   String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       DocumentHistory[]

  @@index([documentHubId])
  @@map("documents")

}
model DocumentTree {
  id            String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentHubId String
  documentHub   DocumentHub @relation(fields: [documentHubId], references: [id], onDelete: Cascade)

  title         String
  type          DocumentNodeType

  parentId      String?
  parent        DocumentTree? @relation("TreeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      DocumentTree[] @relation("TreeChildren")

  // Only set when type = file
  documentId    String? @unique
  document      Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  position      Int      @default(0)

  createdById   String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)


  createdAt     DateTime @default(now())

  @@index([documentHubId])
  @@index([parentId])
  @@map("documenttree")

}

model DocumentHistory {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  content       Json
  
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([documentId])
  @@index([createdById])
  @@map("document_history")
}

