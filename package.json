{
  "name": "z-backend-v2",
  "version": "1.0.0",
  "description": "Multi-tenant Project Management Backend - PostgreSQL + Prisma + Express",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc && node scripts/copy-assets.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed-rbac": "npx ts-node -r tsconfig-paths/register src/scripts/seed-rbac.ts",
    "db:add-my-hub": "npx ts-node -r tsconfig-paths/register src/scripts/add-my-hub-perms.ts",
    "lv2:migrate": "npx ts-node -r tsconfig-paths/register src/modules/leave-v2/db/migrate.ts",
    "pay:migrate": "npx ts-node -r tsconfig-paths/register src/modules/payroll/db/migrate.ts",
    "rb2:migrate": "npx ts-node -r tsconfig-paths/register src/modules/reimbursement-v2/db/migrate.ts",
    "om:migrate": "npx ts-node -r tsconfig-paths/register src/modules/opening-management/db/migrate.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "postinstall": "prisma generate"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "multi-tenant",
    "jwt",
    "rbac"
  ],
  "author": "Dinesh Kumar",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@aws-sdk/client-s3": "^3.937.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.19.1",
    "@types/nodemailer": "^7.0.4",
    "amqplib": "^1.0.3",
    "archiver": "^7.0.1",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.70.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "form-data": "^4.0.5",
    "googleapis": "^171.4.0",
    "helmet": "^7.1.0",
    "html-to-docx": "^1.8.0",
    "jimp": "^1.6.1",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "ll": "^1.2.0",
    "mammoth": "^1.12.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "openai": "^6.48.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "prisma": "^5.19.1",
    "puppeteer": "^24.36.1",
    "redis": "^4.7.1",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/form-data": "^2.2.1",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.10.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
