# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.production and fill in your production values
# Then use: docker-compose --env-file .env.production up -d

# Database (Neon PostgreSQL)
DATABASE_URL='postgresql://username:password@host/database?sslmode=require'

# JWT Secrets (Generate new secure secrets for production!)
# Generate using: openssl rand -hex 32
JWT_ACCESS_SECRET=your_secure_access_secret_here
JWT_REFRESH_SECRET=your_secure_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=production
PORT=5001

# Logging Configuration
LOG_LEVEL=info
DISABLE_TENANT_LOGGING=false
DISABLE_PERFORMANCE_LOGGING=false

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (Add your production frontend domain)
# For tenant subdomains, the wildcard regex in app.ts handles *.zukvo.com automatically
ALLOWED_ORIGINS=https://zukvo.com,https://www.zukvo.com

# Session Configuration (Generate new secret for production!)
SESSION_SECRET=your_secure_session_secret_here
COOKIE_DOMAIN=.zukvo.com
COOKIE_SECURE=true

# Cloudflare R2 Storage
CF_R2_BUCKET_NAME=your_bucket_name
CF_R2_ACCOUNT_ID=your_account_id
CF_R2_ACCESS_KEY_ID=your_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_secret_access_key
CF_R2_PUBLIC_URL=https://your-r2-public-url.com

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM_NAME=Your Company Name
SMTP_FROM_EMAIL=your_email@gmail.com

# Novu Configuration
NOVU_API_KEY=your_novu_api_key
NOVU_SECRET_KEY=your_novu_secret_key
NOVU_APP_IDENTIFIER=your_novu_app_identifier

# Zoho OAuth Credentials
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret

# App URLs (Update with your actual domain)
APP_URL=https://api.zukvo.com
APP_DOMAIN=zukvo.com
ZOHO_REDIRECT_URI=https://api.zukvo.com/api/zoho/callback
FRONTEND_URL=https://zukvo.com

# ── AI provider ──────────────────────────────────────────────────────
# Which provider the app uses: "gemini" (default) or "deepseek".
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-flash-latest

# DeepSeek (OpenAI-compatible). Set AI_PROVIDER=deepseek to activate.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Yapiez (API definition + flow execution) ─────────────────────────
# Yapiez makes the SERVER fetch URLs that tenant users type, so it refuses
# hosts resolving to loopback, link-local, private or unique-local addresses
# by default. That is the SSRF guard — leave it on in production.
#
# Set to true ONLY for a self-hosted install whose APIs under test genuinely
# live on the private network alongside this server.
# YAPIEZ_ALLOW_PRIVATE_HOSTS=false
#
# Preferred to the blanket override: permit specific internal hosts only.
# Comma-separated hostnames, matched exactly.
# YAPIEZ_HOST_ALLOWLIST=internal-api.local,staging.internal

# Per-request timeouts for an executed step (milliseconds).
# YAPIEZ_DEFAULT_TIMEOUT_MS=30000
# YAPIEZ_MAX_TIMEOUT_MS=120000

# Response bodies larger than this are truncated before being stored on the
# run record — a run is evidence, not a response cache.
# YAPIEZ_MAX_BODY_BYTES=256000

# Dedicated pg pool size for the Yapiez module.
# YAPIEZ_PG_POOL_MAX=5
